<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>SILOX OS</title>
<script src="/scram/scramjet.all.js"></script>
<script src="/baremux/index.js"></script>
<script src="/epoxy/index.mjs" type="module"></script>
<script src="/uv/uv.bundle.js"></script>
<script src="/uv/uv.config.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap');

:root{
  --bg:#050506;
  --bg-2:#0a0a0c;
  --panel:#0d0d0f;
  --line:rgba(255,255,255,0.08);
  --line-strong:rgba(255,255,255,0.16);
  --text:#eaeaee;
  --text-dim:#8a8a92;
  --text-faint:#55555c;
  --accent:#e8e8ec;
  --accent-dim:rgba(232,232,236,0.12);
  --font-ui:'Inter',system-ui,sans-serif;
  --font-mono:'JetBrains Mono',monospace;
  --font-serif:'Cormorant Garamond',serif;
  --font-main:var(--font-ui);
  --scale:1;
  --radius:10px;
}

*{box-sizing:border-box;margin:0;padding:0;}
html,body{
  width:100%;height:100%;overflow:hidden;
  background:var(--bg);
  font-family:var(--font-main);
  color:var(--text);
  font-size:calc(15px * var(--scale));
  -webkit-font-smoothing:antialiased;
  user-select:none;
}
::selection{background:var(--accent-dim);}
::-webkit-scrollbar{width:8px;height:8px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--line-strong);border-radius:4px;}
button,input{font-family:inherit;font-size:inherit;color:inherit;}
button{cursor:pointer;background:none;border:none;}
input{outline:none;}
.hidden{display:none !important;}

.fx-grid{
  position:absolute;inset:0;
  background-image:
    linear-gradient(var(--line) 1px, transparent 1px),
    linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size:56px 56px;
  mask-image:radial-gradient(ellipse at 50% 40%, black 10%, transparent 75%);
  opacity:.55;
  pointer-events:none;
}
canvas.fx-particles{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}

#boot-screen{
  position:fixed;inset:0;z-index:500;
  background:var(--bg);
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;
  transition:opacity .7s ease;
}
#boot-screen.fade-out{opacity:0;}
.boot-wordmark{
  font-family:var(--font-ui);font-weight:700;
  font-size:64px;letter-spacing:22px;padding-left:22px;
  color:var(--text);opacity:0;
  animation:bootIn 1.1s ease forwards;
}
.boot-sub{
  margin-top:14px;font-size:11px;letter-spacing:6px;
  color:var(--text-faint);opacity:0;
  animation:bootIn 1.1s ease forwards .3s;
}
.boot-rule{
  width:0;height:1px;background:var(--line-strong);
  margin-top:26px;
  animation:bootRule 1s ease forwards .5s;
}
.boot-bar-track{
  width:220px;height:2px;background:var(--line);
  margin-top:40px;position:relative;overflow:hidden;
  opacity:0;animation:bootIn .6s ease forwards .9s;
}
.boot-bar-fill{
  position:absolute;left:0;top:0;bottom:0;width:0%;
  background:var(--text);
}
.boot-pct{
  margin-top:12px;font-family:var(--font-mono);font-size:11px;color:var(--text-faint);
  opacity:0;animation:bootIn .6s ease forwards .9s;
}
@keyframes bootIn{to{opacity:1;}}
@keyframes bootRule{to{width:280px;}}
.rumble{animation:rumble .38s ease;}
@keyframes rumble{
  0%{transform:translate(0,0);}20%{transform:translate(-2px,1px);}40%{transform:translate(2px,-1px);}
  60%{transform:translate(-1px,2px);}80%{transform:translate(1px,-2px);}100%{transform:translate(0,0);}
}

#auth-screen{
  position:fixed;inset:0;z-index:400;
  display:flex;align-items:center;justify-content:center;
  background:var(--bg);opacity:0;transition:opacity .8s ease;
}
#auth-screen.show{opacity:1;}
#auth-screen.fade-out{opacity:0;}
.auth-card{
  position:relative;z-index:2;width:360px;padding:44px 38px 38px;
  border:1px solid var(--line);
  background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0));
  border-radius:14px;text-align:center;backdrop-filter:blur(6px);
}
.auth-mark{font-weight:700;letter-spacing:8px;font-size:15px;color:var(--text-dim);margin-bottom:26px;}
.auth-title{font-size:20px;font-weight:500;margin-bottom:8px;}
.auth-sub{font-size:12.5px;color:var(--text-dim);margin-bottom:26px;line-height:1.5;}
.auth-input{
  width:100%;padding:13px 14px;background:rgba(255,255,255,0.03);
  border:1px solid var(--line);border-radius:8px;color:var(--text);
  margin-bottom:12px;transition:border-color .2s;text-align:center;letter-spacing:.3px;
}
.auth-input:focus{border-color:var(--line-strong);}
.auth-btn{
  width:100%;padding:13px 14px;margin-top:8px;
  background:var(--text);color:#050506;border-radius:8px;
  font-weight:600;letter-spacing:.3px;transition:opacity .2s, transform .15s;
}
.auth-btn:hover{opacity:.85;}
.auth-btn:active{transform:scale(.98);}
.auth-error{color:#d98a8a;font-size:11.5px;margin-top:10px;min-height:14px;}
.auth-back{margin-top:16px;font-size:11.5px;color:var(--text-faint);}
.auth-back span{cursor:pointer;text-decoration:underline;color:var(--text-dim);}

#desktop{
  position:fixed;inset:0;
  background:radial-gradient(ellipse at 50% 0%, #0c0c0f 0%, var(--bg) 60%);
  opacity:0;transition:opacity .9s ease;
}
#desktop.show{opacity:1;}

#topbar{
  position:absolute;top:0;left:0;right:0;height:38px;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 18px;border-bottom:1px solid var(--line);
  background:rgba(6,6,7,0.6);backdrop-filter:blur(10px);
  z-index:50;font-size:12px;
}
.topbar-mark{font-weight:700;letter-spacing:5px;color:var(--text-dim);}
.topbar-clock{font-family:var(--font-mono);color:var(--text-dim);letter-spacing:.5px;}
.topbar-right{display:flex;align-items:center;gap:14px;}
.topbar-user{color:var(--text-dim);}
.topbar-user b{color:var(--text);font-weight:500;}
.icon-btn{
  width:26px;height:26px;border-radius:6px;
  display:flex;align-items:center;justify-content:center;
  color:var(--text-dim);transition:background .15s,color .15s;
}
.icon-btn:hover{background:rgba(255,255,255,0.06);color:var(--text);}

#desktop-icons{
  position:absolute;top:60px;left:22px;
  display:flex;flex-direction:column;gap:22px;z-index:5;
}
.dicon{
  width:78px;display:flex;flex-direction:column;align-items:center;gap:8px;
  padding:8px 4px;border-radius:8px;color:var(--text-dim);
}
.dicon:hover{background:rgba(255,255,255,0.04);color:var(--text);}
.dicon .dicon-box{
  width:42px;height:42px;border:1px solid var(--line-strong);border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,0.02);
}
.dicon .dicon-label{font-size:11px;letter-spacing:.3px;text-align:center;}

#windows-layer{position:absolute;inset:0;z-index:20;}

#dock{
  position:absolute;bottom:16px;left:50%;transform:translateX(-50%);
  display:flex;gap:10px;padding:10px 14px;
  border:1px solid var(--line);border-radius:16px;
  background:rgba(10,10,12,0.7);backdrop-filter:blur(14px);
  z-index:60;
}
.dock-item{
  position:relative;width:46px;height:46px;border-radius:11px;
  display:flex;align-items:center;justify-content:center;
  color:var(--text-dim);border:1px solid transparent;
  transition:transform .15s, background .15s, color .15s;
}
.dock-item:hover{transform:translateY(-4px);background:rgba(255,255,255,0.05);color:var(--text);}
.dock-item.active::after{
  content:'';position:absolute;bottom:-8px;left:50%;transform:translateX(-50%);
  width:4px;height:4px;border-radius:50%;background:var(--accent);
}

.window{
  position:absolute;min-width:340px;min-height:220px;
  background:var(--panel);border:1px solid var(--line-strong);
  border-radius:12px;overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,0.55);
  display:flex;flex-direction:column;
  animation:winIn .28s cubic-bezier(.2,.9,.3,1.1);
}
@keyframes winIn{from{opacity:0;transform:scale(.96) translateY(10px);}to{opacity:1;transform:none;}}
.window.maximized{border-radius:0;}
.win-titlebar{
  height:40px;flex:0 0 auto;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 10px 0 14px;background:rgba(255,255,255,0.02);
  border-bottom:1px solid var(--line);cursor:grab;
}
.win-titlebar:active{cursor:grabbing;}
.win-title{display:flex;align-items:center;gap:9px;font-size:12.5px;color:var(--text-dim);letter-spacing:.3px;}
.win-title b{color:var(--text);font-weight:500;}
.win-controls{display:flex;gap:6px;}
.win-btn{
  width:24px;height:24px;border-radius:6px;
  display:flex;align-items:center;justify-content:center;color:var(--text-faint);
}
.win-btn:hover{background:rgba(255,255,255,0.07);color:var(--text);}
.win-btn.close:hover{background:rgba(217,138,138,0.15);color:#e39a9a;}
.win-body{flex:1;min-height:0;position:relative;overflow:hidden;background:var(--bg-2);}
.resize-handle{position:absolute;right:0;bottom:0;width:16px;height:16px;cursor:nwse-resize;}

/* ========== BROWSER APP ========== */
.browser{display:flex;flex-direction:column;height:100%;}
.browser-tabs{display:flex;align-items:flex-end;gap:2px;padding:6px 6px 0;background:rgba(255,255,255,0.015);}
.b-tab{
  display:flex;align-items:center;gap:8px;padding:7px 10px;
  font-size:11.5px;color:var(--text-dim);border:1px solid var(--line);
  border-bottom:none;border-radius:8px 8px 0 0;background:var(--panel);max-width:150px;
}
.b-tab.active{color:var(--text);background:var(--bg-2);}
.b-tab span.t-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;}
.b-tab .t-close{opacity:.5;}
.b-tab .t-close:hover{opacity:1;}
.b-newtab{width:26px;height:26px;border-radius:6px;color:var(--text-faint);display:flex;align-items:center;justify-content:center;margin-bottom:4px;}
.b-newtab:hover{background:rgba(255,255,255,0.06);color:var(--text);}
.browser-toolbar{
  display:flex;align-items:center;gap:8px;padding:9px 12px;
  border-bottom:1px solid var(--line);background:var(--bg-2);
}
.b-nav-btn{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;color:var(--text-dim);}
.b-nav-btn:hover{background:rgba(255,255,255,0.06);color:var(--text);}
.b-nav-btn:disabled{opacity:.3;pointer-events:none;}
.browser-brand{font-weight:700;font-size:11px;letter-spacing:2.5px;color:var(--text-faint);padding:0 4px;}
.b-addr{
  flex:1;display:flex;align-items:center;gap:8px;
  background:rgba(255,255,255,0.035);border:1px solid var(--line);
  border-radius:8px;padding:0 12px;height:30px;
}
.b-addr input{flex:1;background:none;border:none;font-size:12.5px;color:var(--text);}
.b-addr .lock{color:var(--text-faint);font-size:11px;}
.browser-hint{font-size:10.5px;color:var(--text-faint);padding:5px 14px;border-bottom:1px solid var(--line);background:var(--bg-2);}
.browser-view{flex:1;position:relative;background:#000;}
.browser-view iframe{width:100%;height:100%;border:none;display:block;background:#fff;}
.browser-home{
  height:100%;overflow:auto;display:flex;flex-direction:column;align-items:center;
  padding:60px 20px;gap:26px;
}
.browser-home .bh-mark{font-weight:700;font-size:30px;letter-spacing:10px;color:var(--text);}
.browser-home .bh-sub{font-size:12px;color:var(--text-faint);letter-spacing:.5px;}
.bh-links{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;max-width:520px;}
.bh-link{
  padding:12px 18px;border:1px solid var(--line);border-radius:9px;font-size:12px;color:var(--text-dim);
}
.bh-link:hover{border-color:var(--line-strong);color:var(--text);}

/* ========== TERMINAL ========== */
.terminal{
  height:100%;padding:14px 16px;overflow-y:auto;
  font-family:var(--font-mono);font-size:12.5px;line-height:1.7;
  background:#000;color:#d8d8dc;
}
.term-line{white-space:pre-wrap;word-break:break-word;}
.term-prompt-row{display:flex;gap:8px;}
.term-prompt{color:var(--text-dim);flex:0 0 auto;}
.term-input{
  flex:1;background:none;border:none;color:#fff;font-family:var(--font-mono);font-size:12.5px;
}
.term-dim{color:var(--text-faint);}

/* ========== CHAT ========== */
.chat{display:flex;height:100%;}
.chat-side{width:190px;border-right:1px solid var(--line);display:flex;flex-direction:column;background:rgba(255,255,255,0.012);}
.chat-side-section{padding:12px 12px 4px;font-size:10px;letter-spacing:1.5px;color:var(--text-faint);}
.chat-list{display:flex;flex-direction:column;padding:0 6px;gap:2px;overflow-y:auto;}
.chat-item{display:flex;align-items:center;gap:8px;padding:8px 8px;border-radius:7px;font-size:12px;color:var(--text-dim);}
.chat-item:hover{background:rgba(255,255,255,0.05);}
.chat-item.active{background:rgba(255,255,255,0.07);color:var(--text);}
.chat-dot{width:6px;height:6px;border-radius:50%;background:var(--text-faint);flex:0 0 auto;}
.chat-add{padding:8px 12px;font-size:11px;color:var(--text-faint);border-top:1px solid var(--line);margin-top:auto;}
.chat-add span{cursor:pointer;color:var(--text-dim);}
.chat-add span:hover{color:var(--text);}
.chat-main{flex:1;display:flex;flex-direction:column;min-width:0;}
.chat-head{padding:12px 16px;border-bottom:1px solid var(--line);font-size:12.5px;color:var(--text-dim);}
.chat-head b{color:var(--text);font-weight:500;}
.chat-msgs{flex:1;overflow-y:auto;padding:14px 16px;display:flex;flex-direction:column;gap:10px;}
.msg{max-width:75%;font-size:12.5px;line-height:1.5;}
.msg .m-from{font-size:10.5px;color:var(--text-faint);margin-bottom:3px;}
.msg .m-bubble{padding:9px 12px;border-radius:9px;background:rgba(255,255,255,0.05);border:1px solid var(--line);}
.msg.mine{align-self:flex-end;}
.msg.mine .m-bubble{background:var(--accent);color:#0a0a0b;border-color:transparent;}
.msg.mine .m-from{text-align:right;}
.chat-input-row{display:flex;gap:8px;padding:10px 12px;border-top:1px solid var(--line);}
.chat-input-row input{flex:1;background:rgba(255,255,255,0.035);border:1px solid var(--line);border-radius:8px;padding:9px 12px;font-size:12.5px;}
.chat-send{padding:0 16px;border-radius:8px;background:var(--accent);color:#0a0a0b;font-size:12px;font-weight:600;}
.chat-send:hover{opacity:.85;}
.chat-empty{flex:1;display:flex;align-items:center;justify-content:center;color:var(--text-faint);font-size:12px;text-align:center;padding:20px;}

/* ========== SETTINGS ========== */
.settings{height:100%;overflow-y:auto;padding:22px 26px;}
.set-group{margin-bottom:26px;}
.set-label{font-size:11px;letter-spacing:1.5px;color:var(--text-faint);margin-bottom:12px;}
.set-row{display:flex;gap:10px;flex-wrap:wrap;}
.set-opt{padding:9px 14px;border:1px solid var(--line);border-radius:8px;font-size:12px;color:var(--text-dim);}
.set-opt.active{border-color:var(--accent);color:var(--text);background:rgba(255,255,255,0.05);}
.swatch{width:34px;height:34px;border-radius:50%;border:2px solid transparent;}
.swatch.active{border-color:var(--text);}
.set-hint{font-size:11px;color:var(--text-faint);margin-top:10px;line-height:1.5;}
.set-slider-row{display:flex;align-items:center;gap:14px;}
input[type=range]{flex:1;accent-color:var(--accent);}
.set-name{font-size:20px;font-weight:500;margin-bottom:2px;}
.set-sub{font-size:12px;color:var(--text-faint);margin-bottom:22px;}
.set-danger{padding:9px 14px;border:1px solid rgba(217,138,138,0.35);color:#e39a9a;border-radius:8px;font-size:12px;}
.set-danger:hover{background:rgba(217,138,138,0.1);}

/* ========== ADD APP MODAL ========== */
.modal-overlay{
  position:fixed;inset:0;z-index:500;
  display:flex;align-items:center;justify-content:center;
  background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);
  animation:fadeIn .25s ease;
}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal-card{
  background:var(--panel);border:1px solid var(--line-strong);
  border-radius:14px;padding:30px 26px;width:360px;
  text-align:center;box-shadow:0 30px 60px rgba(0,0,0,0.6);
}
.modal-card h3{font-size:16px;font-weight:600;margin-bottom:6px;}
.modal-card .modal-desc{font-size:11.5px;color:var(--text-faint);margin-bottom:20px;}
.modal-card input{
  width:100%;padding:12px 14px;background:rgba(255,255,255,0.03);
  border:1px solid var(--line);border-radius:8px;color:var(--text);
  margin-bottom:10px;text-align:center;font-size:13px;
}
.modal-card input:focus{border-color:var(--line-strong);}
.modal-btns{display:flex;gap:8px;margin-top:6px;}
.modal-btns button{flex:1;padding:10px;border-radius:8px;font-size:12px;font-weight:600;}
.modal-add-btn{background:var(--text);color:#050506;}
.modal-add-btn:hover{opacity:.85;}
.modal-cancel-btn{border:1px solid var(--line);color:var(--text-dim);}
.modal-cancel-btn:hover{background:rgba(255,255,255,0.04);}
</style>
</head>
<body>

<!-- BOOT -->
<div id="boot-screen">
  <div class="boot-wordmark" id="boot-word">SILOX</div>
  <div class="boot-sub">P E R S O N A L&nbsp;&nbsp;S Y S T E M</div>
  <div class="boot-rule"></div>
  <div class="boot-bar-track"><div class="boot-bar-fill" id="boot-fill"></div></div>
  <div class="boot-pct" id="boot-pct">starting up</div>
</div>

<!-- AUTH -->
<div id="auth-screen">
  <canvas class="fx-particles" id="auth-particles"></canvas>
  <div class="auth-card" id="auth-card"></div>
</div>

<!-- DESKTOP -->
<div id="desktop">
  <div class="fx-grid"></div>
  <canvas class="fx-particles" id="desk-particles"></canvas>

  <div id="topbar">
    <div class="topbar-mark">SILOX</div>
    <div class="topbar-clock" id="clock">00:00:00</div>
    <div class="topbar-right">
      <div class="topbar-user">signed in as <b id="topbar-username">—</b></div>
      <button class="icon-btn" id="logout-btn" title="Lock session">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
      </button>
    </div>
  </div>

  <div id="desktop-icons"></div>
  <div id="windows-layer"></div>

  <div id="dock"></div>

  <!-- ADD APP MODAL -->
  <div class="modal-overlay hidden" id="add-app-modal">
    <div class="modal-card">
      <h3>Add App Shortcut</h3>
      <p class="modal-desc">Create a quick shortcut on your desktop</p>
      <input type="text" id="add-app-name" placeholder="App name (e.g. Netflix)">
      <input type="text" id="add-app-url" placeholder="URL (e.g. netflix.com)">
      <div class="modal-btns">
        <button class="modal-cancel-btn" id="add-app-cancel">Cancel</button>
        <button class="modal-add-btn" id="add-app-submit">Add</button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
"use strict";

/* ============================================================
   STORAGE HELPERS
   ============================================================ */
const memStore = {};
async function storeGet(key, shared){
  try{
    const r = await window.storage?.get(key, !!shared);
    return r ? r.value : null;
  }catch(e){ return memStore[key] ?? null; }
}
async function storeSet(key, value, shared){
  try{ await window.storage?.set(key, value, !!shared); }catch(e){ memStore[key] = value; }
}
async function storeList(prefix, shared){
  try{ const r = await window.storage?.list(prefix, !!shared); return r ? r.keys : []; }catch(e){ return Object.keys(memStore).filter(k => k.startsWith(prefix||'')); }
}

/* ============================================================
   ICONS
   ============================================================ */
const ICONS = {
  browser: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 4 5.7 4 9s-1.4 6.4-4 9c-2.6-2.6-4-5.7-4-9s1.4-6.4 4-9z"/></svg>',
  terminal: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l4 3-4 3M13 15h4"/></svg>',
