<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Silox Proxy</title>
    <script src="https://app.rybbit.io/api/script.js" data-site-id="8b65ec526edf" defer></script>
    <link rel="prefetch" href="/scram/scramjet.all.js" />
    <script src="/scram/scramjet.all.js"></script>
    <script src="/baremux"></script>
    <script src="/epoxy"></script>
    <link rel="icon" type="image/png" src="/assets/favicon.png">
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>
    <style>
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(100, 200, 255, 0.4);
            }
            50% {
                box-shadow: 0 0 20px 10px rgba(100, 200, 255, 0.2);
            }
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-10px);
            }
        }

        @keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @keyframes fogFloat {
            0% {
                opacity: 0.3;
                transform: translateX(-10%) translateY(0);
            }
            25% {
                opacity: 0.5;
                transform: translateX(5%) translateY(-20px);
            }
            50% {
                opacity: 0.35;
                transform: translateX(10%) translateY(-10px);
            }
            75% {
                opacity: 0.45;
                transform: translateX(0%) translateY(-25px);
            }
            100% {
                opacity: 0.3;
                transform: translateX(-10%) translateY(0);
            }
        }

        @keyframes fogFloat2 {
            0% {
                opacity: 0.2;
                transform: translateX(5%) translateY(0);
            }
            33% {
                opacity: 0.4;
                transform: translateX(-8%) translateY(-15px);
            }
            66% {
                opacity: 0.25;
                transform: translateX(3%) translateY(-30px);
            }
            100% {
                opacity: 0.2;
                transform: translateX(5%) translateY(0);
            }
        }

        @keyframes fogFloat3 {
            0% {
                opacity: 0.15;
                transform: translateX(0%) translateY(0) scale(1);
            }
            50% {
                opacity: 0.3;
                transform: translateX(-5%) translateY(-10px) scale(1.2);
            }
            100% {
                opacity: 0.15;
                transform: translateX(0%) translateY(0) scale(1);
            }
        }

        @keyframes introFadeOut {
            0% { opacity: 1; }
            70% { opacity: 1; }
            100% { opacity: 0; visibility: hidden; }
        }

        @keyframes introTextGlow {
            0%, 100% { text-shadow: 0 0 20px rgba(100, 200, 255, 0.5), 0 0 40px rgba(100, 200, 255, 0.2); }
            50% { text-shadow: 0 0 30px rgba(100, 200, 255, 0.8), 0 0 60px rgba(100, 200, 255, 0.4), 0 0 80px rgba(150, 150, 255, 0.2); }
        }

        @keyframes tributeSlideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes particleRise {
            0% {
                opacity: 1;
                transform: translateY(0) translateX(0) scale(1);
            }
            100% {
                opacity: 0;
                transform: translateY(-200px) translateX(var(--drift)) scale(0);
            }
        }

        /* Intro Overlay */
        .intro-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(ellipse at center, #0a0e1a 0%, #050810 40%, #000 70%);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            pointer-events: none;
            overflow: hidden;
        }

        .intro-overlay.playing {
            animation: introFadeOut 4s ease-in-out forwards;
        }

        .intro-overlay.hidden-intro {
            display: none;
        }

        .intro-fog {
            position: absolute;
            width: 200%;
            height: 200%;
            background: 
                radial-gradient(ellipse at 30% 50%, rgba(60, 80, 120, 0.15) 0%, transparent 50%),
                radial-gradient(ellipse at 70% 40%, rgba(40, 60, 100, 0.1) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 60%, rgba(80, 100, 140, 0.08) 0%, transparent 50%);
            animation: fogFloat 8s ease-in-out infinite;
        }

        .intro-fog-2 {
            position: absolute;
            width: 200%;
            height: 200%;
            background: 
                radial-gradient(ellipse at 60% 30%, rgba(50, 70, 110, 0.12) 0%, transparent 50%),
                radial-gradient(ellipse at 20% 60%, rgba(30, 50, 90, 0.1) 0%, transparent 50%);
            animation: fogFloat2 10s ease-in-out infinite;
        }

        .intro-fog-3 {
            position: absolute;
            width: 150%;
            height: 150%;
            background: 
                radial-gradient(ellipse at 40% 40%, rgba(100, 120, 160, 0.06) 0%, transparent 60%);
            animation: fogFloat3 12s ease-in-out infinite;
        }

        .intro-particles {
            position: absolute;
            width: 100%;
            height: 100%;
        }

        .intro-particle {
            position: absolute;
            width: 3px;
            height: 3px;
            background: rgba(100, 180, 255, 0.6);
            border-radius: 50%;
            animation: particleRise 3s ease-out infinite;
        }

        .intro-particle:nth-child(1) { left: 10%; animation-delay: 0s; --drift: 10px; }
        .intro-particle:nth-child(2) { left: 25%; animation-delay: 0.5s; --drift: -8px; }
        .intro-particle:nth-child(3) { left: 40%; animation-delay: 1s; --drift: 15px; }
        .intro-particle:nth-child(4) { left: 55%; animation-delay: 1.5s; --drift: -12px; }
        .intro-particle:nth-child(5) { left: 70%; animation-delay: 2s; --drift: 8px; }
        .intro-particle:nth-child(6) { left: 85%; animation-delay: 2.5s; --drift: -10px; }
        .intro-particle:nth-child(7) { left: 15%; animation-delay: 1.2s; --drift: 20px; }
        .intro-particle:nth-child(8) { left: 50%; animation-delay: 0.8s; --drift: -15px; }
        .intro-particle:nth-child(9) { left: 75%; animation-delay: 1.8s; --drift: 12px; }
        .intro-particle:nth-child(10) { left: 35%; animation-delay: 2.2s; --drift: -6px; }

        .intro-text-container {
            text-align: center;
            z-index: 1;
            animation: introTextGlow 2s ease-in-out infinite;
        }

        .intro-welcome {
            font-size: 2.5rem;
            font-weight: 300;
            color: rgba(160, 200, 240, 0.9);
            letter-spacing: 6px;
            margin-bottom: 15px;
            text-transform: uppercase;
        }

        .intro-subtitle {
            font-size: 1rem;
            color: rgba(140, 180, 220, 0.7);
            letter-spacing: 4px;
        }

        /* Main Content */
        body {
            margin: 0;
            padding: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }

        /* When intro hasn't played, hide main content initially */
        body.intro-not-played .container,
        body.intro-not-played .venusFooter,
        body.intro-not-played .reset-button {
            opacity: 0;
        }

        /* When intro is done or skipped, show everything normally */
        body.intro-done .container {
            animation: fadeInUp 1s ease-out 0.2s both;
        }

        body.intro-done .venusFooter {
            animation: fadeInUp 1s ease-out 0.4s both;
        }

        body.intro-done .reset-button {
            animation: fadeInUp 1s ease-out 0.4s both;
        }

        .container {
            text-align: center;
        }

        .logo-text {
            font-size: 4rem;
            font-weight: 800;
            letter-spacing: 4px;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #64c8ff, #a78bfa, #64c8ff);
            background-size: 200% 200%;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradientShift 3s ease infinite;
            text-shadow: none;
            filter: drop-shadow(0 0 20px rgba(100, 200, 255, 0.3));
        }

        .tagline {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 30px;
            letter-spacing: 2px;
        }

        .tribute-message {
            margin-bottom: 25px;
            padding: 15px 25px;
            background: rgba(15, 20, 35, 0.6);
            backdrop-filter: blur(15px);
            border-radius: 12px;
            border: 1px solid rgba(100, 200, 255, 0.15);
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .tribute-message p {
            margin: 0;
            font-size: 0.85rem;
            color: rgba(180, 200, 230, 0.9);
            letter-spacing: 1px;
            line-height: 1.6;
        }

        .tribute-message .heart {
            color: #ff6b8a;
            font-size: 1rem;
        }

        .tribute-message .highlight {
            color: rgba(100, 200, 255, 0.9);
            font-weight: 600;
        }

        .search-container {
            display: flex;
            align-items: center;
            margin-top: 20px;
        }

        .search-input {
            border: 2px solid transparent;
            border-radius: 50px;
            padding: 14px 24px;
            width: 420px;
            font-size: 16px;
            outline: none;
            background-color: rgba(20, 25, 40, 0.85);
            color: #e0e0e0;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .search-input:focus {
            border-color: rgba(100, 200, 255, 0.6);
            box-shadow: 0 4px 30px rgba(100, 200, 255, 0.2);
            background-color: rgba(25, 30, 50, 0.9);
        }

        .search-input::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        .search-button {
            background: linear-gradient(135deg, #4a90d9, #6c5ce7);
            border: none;
            border-radius: 50px;
            padding: 14px 20px;
            margin-left: 8px;
            cursor: pointer;
            outline: none;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(74, 144, 217, 0.4);
        }

        .search-button:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 25px rgba(74, 144, 217, 0.6);
        }

        .search-button:active {
            transform: scale(0.95);
        }

        .app-buttons {
            display: flex;
            justify-content: center;
            margin-top: 30px;
        }

        .app-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 55px;
            height: 55px;
            border-radius: 16px;
            background-color: rgba(20, 25, 40, 0.75);
            backdrop-filter: blur(10px);
            margin: 0 8px;
            cursor: pointer;
            outline: none;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .app-button:hover {
            background-color: rgba(40, 50, 80, 0.85);
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 8px 25px rgba(100, 200, 255, 0.3);
            border-color: rgba(100, 200, 255, 0.4);
        }

        .app-button img {
            max-width: 55%;
            max-height: 55%;
            transition: transform 0.3s ease;
        }

        .app-button:hover img {
            transform: scale(1.1);
        }

        #add-app-button {
            background-color: rgba(20, 25, 40, 0.6);
            border: 1px dashed rgba(255, 255, 255, 0.3);
        }

        #add-app-button:hover {
            border-style: solid;
            border-color: rgba(100, 200, 255, 0.5);
        }

        .venusFooter {
            position: fixed;
            bottom: 15px;
            right: 25px;
            color: rgba(255, 255, 255, 0.5);
            font-size: 11px;
            text-decoration: none;
            transition: all 0.3s ease;
            letter-spacing: 1px;
        }

        .venusFooter:hover {
            color: rgba(255, 255, 255, 0.9);
            text-shadow: 0 0 10px rgba(100, 200, 255, 0.5);
        }

        .reset-button {
            position: fixed;
            bottom: 25px;
            left: 50%;
            transform: translateX(-50%);
            background-color: rgba(20, 25, 40, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 50px;
            color: rgba(255, 255, 255, 0.7);
            padding: 10px 24px;
            font-size: 13px;
            cursor: pointer;
            outline: none;
            transition: all 0.3s ease;
            z-index: 1000;
            letter-spacing: 1px;
        }

        .reset-button:hover {
            background-color: rgba(220, 50, 50, 0.6);
            border-color: rgba(255, 80, 80, 0.5);
            color: white;
            box-shadow: 0 4px 20px rgba(255, 50, 50, 0.3);
        }

        #add-app-modal {
            z-index: 2000;
            animation: fadeInUp 0.3s ease-out;
        }

        #add-app-modal > div {
            background-color: rgba(15, 20, 35, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        }

        #add-app-modal input {
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

        #add-app-modal input:focus {
            border-color: rgba(100, 200, 255, 0.5);
            box-shadow: 0 0 15px rgba(100, 200, 255, 0.1);
        }

        #add-app-submit,
        #add-app-cancel {
            transition: all 0.3s ease;
        }

        #add-app-submit:hover {
            background-color: rgba(74, 144, 217, 0.6) !important;
        }

        #add-app-cancel:hover {
            background-color: rgba(200, 50, 50, 0.5) !important;
        }
    </style>
    <script>
        async function uvEncode(url) {
            const encodedUrl = __uv$config.prefix + __uv$config.encodeUrl(url);
            localStorage.setItem("url", encodedUrl);
            window.location.href = "/search";
        }

        async function sjEncode(url) {
            const encodedUrl = "/scram/service/" + encodeURIComponent(url);
            localStorage.setItem("url", encodedUrl);
            window.location.href = "/search";
        }

        async function init() {
            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                let transport = localStorage.getItem("transport") || "libcurl";
                localStorage.setItem("transport", transport);
                let wispUrl = (location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/";
                if (localStorage.getItem("wisp-server-type") === "custom") {
                    const customWisp = localStorage.getItem("wisp");
                    if (customWisp) wispUrl = customWisp;
                } else {
                    localStorage.setItem("wisp", wispUrl);
                }
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {
                console.error(err);
            }

            try {
                const { ScramjetController } = $scramjetLoadController();
                const scramjet = new ScramjetController({
                    prefix: "/scram/service/",
                    files: {
                        wasm: "/scram/scramjet.wasm.wasm",
                        all: "/scram/scramjet.all.js",
                        sync: "/scram/scramjet.sync.js"
                    },
                    flags: {
                        syncxhr: true
                    }
                });
                window.sj = scramjet;
                await scramjet.init();
            } catch (error) {
                console.error(error);
            }
        }

        function resetSiteData() {
            if (confirm("Reset all settings, custom apps, and site data?")) {
                localStorage.clear();
                if (navigator.serviceWorker) {
                    navigator.serviceWorker.getRegistrations().then(registrations => {
                        for (let r of registrations) r.unregister();
                    });
                }
                window.location.reload();
            }
        }

        if (navigator.serviceWorker) {
            navigator.serviceWorker.getRegistrations().then(registrations => {
                if (registrations.length === 0) {
                    navigator.serviceWorker.register("sw.js").catch(err => console.error(err));
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            init();
            const defaultBg = '/assets/backgrounds/TwoSwords.png';
            let bg = localStorage.getItem('bg') || defaultBg;
            document.body.style.backgroundImage = `url('${bg}')`;
            const savedFont = localStorage.getItem('font');
            if (savedFont) document.body.style.fontFamily = savedFont;

            // Check if intro has already been shown
            const hasSeenIntro = localStorage.getItem('hasSeenIntro');
            const introOverlay = document.getElementById('intro-overlay');

            if (hasSeenIntro) {
                // User has already seen the intro — hide it immediately
                introOverlay.classList.add('hidden-intro');
                document.body.classList.add('intro-done');
                document.body.classList.remove('intro-not-played');
            } else {
                // First time visitor — play the intro
                introOverlay.classList.add('playing');
                document.body.classList.add('intro-not-played');
                
                // After animation completes (4s), mark as seen and show content
                setTimeout(() => {
                    localStorage.setItem('hasSeenIntro', 'true');
                    introOverlay.classList.add('hidden-intro');
                    document.body.classList.remove('intro-not-played');
                    document.body.classList.add('intro-done');
                }, 4000);
            }

            const searchInput = document.querySelector('.search-input');
            const searchButton = document.querySelector('.search-button');
            const appButtonsDiv = document.querySelector('.app-buttons');
            const addAppButton = document.getElementById('add-app-button');

            const encodeURL = async (url) => {
                let proxyType = localStorage.getItem('proxy') || 'ultraviolet';
                proxyType === 'ultraviolet' ? await uvEncode(url) : await sjEncode(url);
            };

            const handleSearch = async () => {
                const query = searchInput.value.trim();
                if (!query) return;
                let url;
                let isLikelySearch = false;
                try {
                    url = (query.startsWith('http://') || query.startsWith('https://')) ? new URL(query) : new URL('https://' + query);
                    if (!url.hostname || !url.hostname.includes('.')) isLikelySearch = true;
                } catch (e) {
                    isLikelySearch = true;
                }
                if (isLikelySearch) url = new URL((localStorage.getItem('search') || 'https://www.google.com/search?q=') + query);
                await encodeURL(url.toString());
            };

            const createAppButton = (appName, appUrl) => {
                const appButton = document.createElement('a');
                appButton.href = '#';
                appButton.classList.add('app-button');
                appButton.textContent = appName;
                appButton.addEventListener('click', (e) => { e.preventDefault(); encodeURL(appUrl); });
                appButton.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                    const index = apps.findIndex(a => a.name === appButton.textContent);
                    if (index > -1) {
                        apps.splice(index, 1);
                        localStorage.setItem('apps', JSON.stringify(apps));
                        appButton.remove();
                    }
                });
                return appButton;
            };

            let apps = JSON.parse(localStorage.getItem('apps') || '[]');
            apps.forEach(app => {
                const btn = createAppButton(app.name, app.url);
                appButtonsDiv.insertBefore(btn, addAppButton);
            });

            const addAppModal = document.getElementById('add-app-modal');
            const addAppSubmit = document.getElementById('add-app-submit');
            const addAppCancel = document.getElementById('add-app-cancel');
            const appNameInput = document.getElementById('app-name');
            const appUrlInput = document.getElementById('app-url');

            addAppButton.addEventListener('click', () => addAppModal.style.display = 'flex');
            addAppCancel.addEventListener('click', () => addAppModal.style.display = 'none');
            addAppSubmit.addEventListener('click', () => {
                const name = appNameInput.value;
                let url = appUrlInput.value;
                if (url && !url.startsWith('http')) url = 'https://' + url;
                if (name && url) {
                    apps.push({ name, url });
                    localStorage.setItem('apps', JSON.stringify(apps));
                    const btn = createAppButton(name, url);
                    appButtonsDiv.insertBefore(btn, addAppButton);
                    addAppModal.style.display = 'none';
                    appNameInput.value = ''; appUrlInput.value = '';
                }
            });

            searchButton.addEventListener('click', handleSearch);
            searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') handleSearch(); });
        });
    </script>
</head>
<body>
    <!-- Intro Overlay - shown only on first visit -->
    <div class="intro-overlay" id="intro-overlay">
        <div class="intro-fog"></div>
        <div class="intro-fog-2"></div>
        <div class="intro-fog-3"></div>
        <div class="intro-particles">
            <div class="intro-particle"></div>
            <div class="intro-particle"></div>
            <div class="intro-particle"></div>
            <div class="intro-particle"></div>
            <div class="intro-particle"></div>
            <div class="intro-particle"></div>
            <div class="intro-particle"></div>
            <div class="intro-particle"></div>
            <div class="intro-particle"></div>
            <div class="intro-particle"></div>
        </div>
        <div class="intro-text-container">
            <div class="intro-welcome">Welcome, My Friend</div>
            <div class="intro-subtitle">Have Fun On The Proxy</div>
        </div>
    </div>

    <%- include('parts/topbar.ejs') %>
    <div class="container">
        <div class="logo-text">SILOX</div>
        <div class="tagline">BROWSE FREELY, STAY HIDDEN</div>
        
        <div class="tribute-message">
            <p>
                <span class="heart">🖤</span> This proxy was made by <span class="highlight">Hohogames</span>.
                We will miss you, Old Hohogames <span class="heart">🖤</span><br>
                No more Google Sites — no more.<br>
                We changed to <span class="highlight">Proxys</span> now.
            </p>
        </div>

        <div class="search-container">
            <input type="text" class="search-input" placeholder="Search the web freely...">
            <button class="search-button">➜</button>
        </div>
        <div class="app-buttons">
            <a href="#" class="app-button" onclick="event.preventDefault(); document.querySelector('.search-input').value = 'https://discord.com'; document.querySelector('.search-button').click();">
                <img src="/assets/svg/discord.svg" alt="Discord">
            </a>
            <a href="#" class="app-button" onclick="event.preventDefault(); document.querySelector('.search-input').value = 'https://play.geforcenow.com'; document.querySelector('.search-button').click();">
                <img src="/assets/svg/geforcenow.svg" alt="Geforcenow">
            </a>
            <a href="#" class="app-button" onclick="event.preventDefault(); document.querySelector('.search-input').value = 'https://youtube.com'; document.querySelector('.search-button').click();">
                <img src="/assets/svg/youtube.svg" alt="Youtube">
            </a>
            <a href="#" class="app-button" onclick="event.preventDefault(); document.querySelector('.search-input').value = 'https://spotify.com'; document.querySelector('.search-button').click();">
                <img src="/assets/svg/spotify.svg" alt="Spotify">
            </a>
            <a href="#" class="app-button" onclick="event.preventDefault(); document.querySelector('.search-input').value = 'https://x.com'; document.querySelector('.search-button').click();">
                <img src="/assets/svg/x.svg" alt="Twitter/X">
            </a>
            <a href="#" class="app-button" id="add-app-button">
                <img src="/assets/svg/plus.svg" alt="Add App">
            </a>
        </div>
        <div id="add-app-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); justify-content: center; align-items: center; backdrop-filter: blur(5px); color: white;">
            <div style="background-color: rgba(0, 0, 0, 0.7); padding: 20px; border-radius: 10px; text-align: center;">
                <h2 style="margin-bottom: 4px;">Add New App</h2>
                <label>App Name:</label><br>
                <input type="text" id="app-name" style="border: none; border-radius: 25px; padding: 10px 20px; width: 200px; outline: none; background-color: rgba(255, 255, 255, 0.1); color: white;"><br><br>
                <label>App URL:</label><br>
                <input type="text" id="app-url" style="border: none; border-radius: 25px; padding: 10px 20px; width: 200px; outline: none; background-color: rgba(255, 255, 255, 0.1); color: white;"><br><br>
                <button id="add-app-submit" style="background-color: rgba(0, 0, 0, 0.7); border: none; border-radius: 25px; padding: 10px 15px; cursor: pointer; color: white;">Add</button>
                <button id="add-app-cancel" style="background-color: rgba(0, 0, 0, 0.7); border: none; border-radius: 25px; padding: 10px 15px; cursor: pointer; color: white;">Cancel</button>
            </div>
        </div>
    </div>
    <button class="reset-button" onclick="resetSiteData()">Reset Site Data</button>
    <a href="<%= _venus%>" class="venusFooter">Venus integration</a>
</body>
</html>