            </a>
        </div>
        <div id="add-app-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);justify-content:center;align-items:center;backdrop-filter:blur(6px);z-index:2000;">
            <div style="padding:28px;border-radius:16px;text-align:center;min-width:300px;">
                <h3 style="margin-bottom:16px;font-weight:600;font-size:1rem;letter-spacing:1px;">ADD APP</h3>
                <label style="font-size:0.65rem;display:block;margin-bottom:4px;text-align:left;">NAME</label>
                <input type="text" id="app-name" placeholder="e.g. Netflix" style="width:100%;padding:10px 14px;border-radius:8px;outline:none;margin-bottom:12px;box-sizing:border-box;">
                <label style="font-size:0.65rem;display:block;margin-bottom:4px;text-align:left;">URL</label>
                <input type="text" id="app-url" placeholder="e.g. netflix.com" style="width:100%;padding:10px 14px;border-radius:8px;outline:none;margin-bottom:16px;box-sizing:border-box;">
                <div style="display:flex;gap:8px;">
                    <button id="add-app-submit" style="flex:1;">Add</button>
