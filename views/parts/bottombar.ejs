<div id="add-app-modal-bb" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.7); justify-content: center; align-items: center; backdrop-filter: blur(8px); color: white; z-index: 2001;">
    <div style="background: #141414; padding: 28px; border-radius: 16px; text-align: center; border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6); min-width: 300px; max-width: 90vw; animation: fadeIn 0.2s ease-out;">
        <h3 style="margin: 0 0 20px 0; font-size: 1.2rem; color: #dc2626; letter-spacing: 2px; font-weight: 600;">ADD APP</h3>
        <label style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.5); display: block; margin-bottom: 6px; text-align: left;">App Name</label>
        <input type="text" id="bb-app-name" placeholder="e.g. Netflix" style="width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.1); background: #1a1a1a; color: white; outline: none; font-size: 0.95em; margin-bottom: 14px; box-sizing: border-box;">
        <label style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.5); display: block; margin-bottom: 6px; text-align: left;">App URL</label>
        <input type="text" id="bb-app-url" placeholder="e.g. netflix.com" style="width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.1); background: #1a1a1a; color: white; outline: none; font-size: 0.95em; margin-bottom: 20px; box-sizing: border-box;">
        <div style="display: flex; gap: 10px; justify-content: center;">
            <button id="add-app-submit-bb" style="flex: 1; padding: 10px; border-radius: 8px; border: none; background: #dc2626; color: white; cursor: pointer; font-size: 0.9em; font-weight: 600;">Add</button>
            <button id="add-app-cancel-bb" style="flex: 1; padding: 10px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.1); background: transparent; color: rgba(255, 255, 255, 0.6); cursor: pointer; font-size: 0.9em;">Cancel</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const homeLink = document.getElementById('bb-home-link');
        const settingsLink = document.getElementById('bb-settings-link');
        const browserLink = document.getElementById('bb-browser-link');
        
        if (window.location.pathname === '/') homeLink.classList.add('active');
        else if (window.location.pathname === '/search' || window.location.pathname.startsWith('/search')) browserLink.classList.add('active');
        else if (window.location.pathname === '/settings' || window.location.pathname.startsWith('/settings/')) settingsLink.classList.add('active');

        window.handleBBApp = function(url) {
            let fullUrl = url;
            if (!fullUrl.startsWith('http://') && !fullUrl.startsWith('https://')) fullUrl = 'https://' + fullUrl;
            if (typeof __uv$config !== 'undefined' && typeof __uv$config.encodeUrl === 'function') {
                const encodedUrl = __uv$config.prefix + __uv$config.encodeUrl(fullUrl);
                localStorage.setItem("url", encodedUrl);
                window.location.href = "/search";
            } else {
                const encodedUrl = "/scram/service/" + encodeURIComponent(fullUrl);
                localStorage.setItem("url", encodedUrl);
                window.location.href = "/search";
            }
        };

        const addBtn = document.getElementById('add-app-bb-btn');
        const modal = document.getElementById('add-app-modal-bb');
        const submitBtn = document.getElementById('add-app-submit-bb');
        const cancelBtn = document.getElementById('add-app-cancel-bb');
        const nameInput = document.getElementById('bb-app-name');
        const urlInput = document.getElementById('bb-app-url');

        if (addBtn) addBtn.addEventListener('click', (e) => { e.preventDefault(); modal.style.display = 'flex'; });
        if (cancelBtn) cancelBtn.addEventListener('click', () => { modal.style.display = 'none'; nameInput.value = ''; urlInput.value = ''; });
        if (modal) modal.addEventListener('click', (e) => { if (e.target === modal) { modal.style.display = 'none'; nameInput.value = ''; urlInput.value = ''; } });
        if (submitBtn) submitBtn.addEventListener('click', () => {
            const name = nameInput.value.trim();
            let url = urlInput.value.trim();
            if (!name || !url) return;
            if (!url.startsWith('http')) url = 'https://' + url;
            let customApps = JSON.parse(localStorage.getItem('bbApps') || '[]');
            customApps.push({ name, url });
            localStorage.setItem('bbApps', JSON.stringify(customApps));
            modal.style.display = 'none'; nameInput.value = ''; urlInput.value = '';
            location.reload();
        });

        function loadCustomApps() {
            const customApps = JSON.parse(localStorage.getItem('bbApps') || '[]');
            const addBtnEl = document.getElementById('add-app-bb-btn');
            customApps.forEach((app, index) => {
                const appEl = document.createElement('a');
                appEl.href = '#'; appEl.className = 'bb-btn'; appEl.setAttribute('data-app-index', index);
                appEl.setAttribute('onclick', "event.preventDefault(); window.handleBBApp('" + app.url.replace(/'/g, "\\'") + "')");
                appEl.innerHTML = `<span style="font-size: 11px; font-weight: 700; letter-spacing: 1px; color: rgba(255,255,255,0.5);">${app.name.substring(0, 3).toUpperCase()}</span><span class="bb-tooltip">${app.name}</span>`;
                appEl.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                    let customApps = JSON.parse(localStorage.getItem('bbApps') || '[]');
                    customApps = customApps.filter(a => a.name !== app.name || a.url !== app.url);
                    localStorage.setItem('bbApps', JSON.stringify(customApps));
                    location.reload();
                });
                if (addBtnEl) addBtnEl.parentNode.insertBefore(appEl, addBtnEl);
            });
        }
        loadCustomApps();
    });
</script>