<style>
    @keyframes slideUpBar {
        from { opacity: 0; transform: translateX(-50%) translateY(30px); }
        to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
    @keyframes barPulse {
        0%, 100% { box-shadow: 0 8px 32px rgba(220, 38, 38, 0.15); }
        50% { box-shadow: 0 8px 40px rgba(220, 38, 38, 0.3); }
    }
    @keyframes barItemPop {
        0% { transform: scale(1); }
        50% { transform: scale(1.15); }
        100% { transform: scale(1); }
    }

    .bottombar {
        position: fixed;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        width: fit-content;
        max-width: 95vw;
        background: rgba(10, 10, 10, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding: 8px 16px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2px;
        z-index: 1000;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
        animation: slideUpBar 0.5s ease-out, barPulse 3s ease-in-out infinite;
        transition: all 0.3s ease;
        overflow-x: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .bottombar::-webkit-scrollbar { display: none; }

    .bottombar:hover {
        border-color: rgba(220, 38, 38, 0.3);
        box-shadow: 0 12px 40px rgba(220, 38, 38, 0.2);
    }

    .bb-divider {
        width: 1px; height: 22px;
        background: rgba(255, 255, 255, 0.1);
        margin: 0 6px; flex-shrink: 0; border-radius: 1px;
    }

    .bottombar a, .bottombar .bb-btn {
        display: flex; align-items: center; justify-content: center;
        width: 40px; height: 40px; border-radius: 12px;
        transition: all 0.2s ease; text-decoration: none;
        position: relative; cursor: pointer; flex-shrink: 0;
        -webkit-tap-highlight-color: transparent;
    }

    .bottombar a:hover, .bottombar .bb-btn:hover {
        background: rgba(255, 255, 255, 0.06);
    }

    .bottombar a:active, .bottombar .bb-btn:active {
        background: rgba(255, 255, 255, 0.1); transform: scale(0.92);
    }

    .bottombar a.active {
        background: rgba(220, 38, 38, 0.2);
    }

    .bottombar a.active::after {
        content: ''; position: absolute; top: -6px; left: 50%;
        transform: translateX(-50%); width: 4px; height: 4px;
        background: #dc2626; border-radius: 50%;
    }

    .bottombar a.active .bb-icon {
        opacity: 1; animation: barItemPop 0.3s ease-out;
    }

    .bb-icon {
        width: 20px; height: 20px;
        transition: all 0.2s ease; opacity: 0.65; flex-shrink: 0;
    }

    .bottombar a:hover .bb-icon,
    .bottombar .bb-btn:hover .bb-icon {
        opacity: 1; transform: scale(1.1);
    }

    .bb-app-icon {
        width: 18px; height: 18px; border-radius: 4px;
        transition: all 0.2s ease; opacity: 0.65; flex-shrink: 0;
    }

    .bottombar a:hover .bb-app-icon,
    .bottombar .bb-btn:hover .bb-app-icon {
        opacity: 1;
    }

    .bb-tooltip {
        position: absolute; top: -32px; left: 50%;
        transform: translateX(-50%); background: #1a1a1a;
        color: #e0e0e0; padding: 4px 10px; border-radius: 6px;
        font-size: 11px; white-space: nowrap; opacity: 0;
        pointer-events: none; transition: all 0.15s ease;
        border: 1px solid rgba(255, 255, 255, 0.1);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    .bottombar a:hover .bb-tooltip,
    .bottombar .bb-btn:hover .bb-tooltip {
        opacity: 1; top: -28px;
    }

    .bb-btn.browser-btn {
        background: rgba(220, 38, 38, 0.12); border: 1px solid rgba(220, 38, 38, 0.25);
    }
    .bb-btn.browser-btn:hover {
        background: rgba(220, 38, 38, 0.25); border-color: rgba(220, 38, 38, 0.5);
    }
    .bb-btn.browser-btn .bb-icon { opacity: 0.9; }

    @media (max-width: 600px) {
        .bottombar { padding: 6px 12px; gap: 0px; border-radius: 14px; bottom: 10px; }
        .bottombar a, .bottombar .bb-btn { width: 36px; height: 36px; border-radius: 10px; }
        .bb-icon { width: 18px; height: 18px; }
        .bb-app-icon { width: 16px; height: 16px; }
        .bb-divider { margin: 0 3px; height: 18px; }
        .bb-tooltip { font-size: 10px; padding: 3px 8px; top: -30px; }
    }

    @media (max-width: 380px) {
        .bottombar { padding: 5px 8px; bottom: 8px; border-radius: 12px; }
        .bottombar a, .bottombar .bb-btn { width: 32px; height: 32px; border-radius: 8px; }
        .bb-icon { width: 16px; height: 16px; }
        .bb-app-icon { width: 14px; height: 14px; }
    }

    @media (hover: none) and (pointer: coarse) {
        .bottombar a, .bottombar .bb-btn { min-height: 40px; min-width: 40px; }
        .bb-tooltip { display: none !important; }
    }
</style>

