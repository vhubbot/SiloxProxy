<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Silox Chat</title>
    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes msgSlideIn {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        @keyframes msgSlideInLeft {
            from { opacity: 0; transform: translateX(-20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        @keyframes recordingPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 60, 80, 0.6); }
            50% { box-shadow: 0 0 20px 10px rgba(255, 60, 80, 0.3); }
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: transparent;
            color: white;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Auth Screens */
        .auth-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            padding: 30px;
        }

        .auth-box {
            background: rgba(20, 28, 48, 0.9);
            border: 1px solid rgba(100, 200, 255, 0.15);
            border-radius: 16px;
            padding: 30px;
            width: 100%;
            max-width: 320px;
            animation: fadeIn 0.4s ease-out;
        }

        .auth-box h2 {
            text-align: center;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #64c8ff, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .auth-box input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: rgba(15, 20, 35, 0.7);
            color: white;
            outline: none;
            font-size: 0.9em;
            margin-bottom: 12px;
            transition: all 0.3s ease;
        }

        .auth-box input:focus {
            border-color: rgba(100, 200, 255, 0.5);
            box-shadow: 0 0 15px rgba(100, 200, 255, 0.1);
        }

        .auth-btn {
            width: 100%;
            padding: 12px;
            border-radius: 25px;
            border: none;
            background: linear-gradient(135deg, #4a90d9, #6c5ce7);
            color: white;
            cursor: pointer;
            font-size: 0.95em;
            font-weight: 600;
            transition: all 0.3s ease;
            margin-top: 8px;
        }

        .auth-btn:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 20px rgba(74, 144, 217, 0.5);
        }

        .auth-switch {
            text-align: center;
            margin-top: 12px;
            font-size: 0.85em;
            color: rgba(255, 255, 255, 0.6);
        }

        .auth-switch a {
            color: rgba(100, 200, 255, 0.8);
            cursor: pointer;
            text-decoration: none;
        }

        .auth-switch a:hover {
            text-decoration: underline;
        }

        .auth-error {
            color: #ff6b6b;
            font-size: 0.8em;
            text-align: center;
            margin-bottom: 10px;
            display: none;
        }

        /* Main Chat Layout */
        .main-chat {
            display: none;
            flex-direction: column;
            height: 100%;
        }

        .chat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(15, 20, 35, 0.5);
        }

        .chat-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4a90d9, #6c5ce7);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9em;
        }

        .user-info .username {
            font-weight: 600;
            font-size: 0.95em;
        }

        .user-info .status {
            font-size: 0.75em;
            color: rgba(255, 255, 255, 0.5);
        }

        .chat-tabs {
            display: flex;
            gap: 5px;
            padding: 8px 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            overflow-x: auto;
        }

        .chat-tabs::-webkit-scrollbar {
            height: 2px;
        }

        .chat-tabs::-webkit-scrollbar-thumb {
            background: rgba(100, 200, 255, 0.2);
            border-radius: 10px;
        }

        .chat-tab {
            padding: 6px 14px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: transparent;
            color: rgba(255, 255, 255, 0.7);
            cursor: pointer;
            font-size: 0.85em;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .chat-tab.active {
            background: rgba(100, 200, 255, 0.15);
            border-color: rgba(100, 200, 255, 0.4);
            color: white;
        }

        .chat-tab:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .add-friend-tab {
            background: rgba(108, 92, 231, 0.2);
            border-color: rgba(108, 92, 231, 0.4);
            font-size: 1.1em;
            padding: 4px 10px;
        }

        /* Messages Area */
        .messages-area {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .messages-area::-webkit-scrollbar {
            width: 4px;
        }

        .messages-area::-webkit-scrollbar-track {
            background: transparent;
        }

        .messages-area::-webkit-scrollbar-thumb {
            background: rgba(100, 200, 255, 0.2);
            border-radius: 10px;
        }

        .message {
            max-width: 75%;
            padding: 10px 14px;
            border-radius: 16px;
            font-size: 0.9em;
            word-wrap: break-word;
            animation: msgSlideIn 0.3s ease-out;
        }

        .message.mine {
            align-self: flex-end;
            background: linear-gradient(135deg, #4a90d9, #3a70b9);
            border-bottom-right-radius: 4px;
        }

        .message.other {
            align-self: flex-start;
            background: rgba(30, 40, 60, 0.8);
            border-bottom-left-radius: 4px;
            animation: msgSlideInLeft 0.3s ease-out;
        }

        .message .msg-sender {
            font-size: 0.75em;
            color: rgba(100, 200, 255, 0.8);
            margin-bottom: 4px;
            font-weight: 600;
        }

        .message .msg-time {
            font-size: 0.7em;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 4px;
            text-align: right;
        }

        .message img {
            max-width: 200px;
            border-radius: 10px;
            margin-top: 5px;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .message img:hover {
            transform: scale(1.05);
        }

        .message .voice-msg {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .message .voice-msg audio {
            height: 36px;
            border-radius: 10px;
        }

        .system-msg {
            text-align: center;
            color: rgba(255, 255, 255, 0.35);
            font-size: 0.8em;
            padding: 8px;
            font-style: italic;
        }

        /* Input Area */
        .input-area {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(15, 20, 35, 0.5);
        }

        .input-area input[type="text"] {
            flex: 1;
            padding: 10px 16px;
            border-radius: 25px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: rgba(20, 25, 40, 0.7);
            color: white;
            outline: none;
            font-size: 0.9em;
            transition: all 0.3s ease;
        }

        .input-area input[type="text"]:focus {
            border-color: rgba(100, 200, 255, 0.4);
        }

        .input-area input[type="text"]::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }

        .icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: none;
            background: rgba(30, 40, 70, 0.6);
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1em;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        .icon-btn:hover {
            background: rgba(60, 70, 110, 0.8);
        }

        .send-btn {
            background: linear-gradient(135deg, #4a90d9, #6c5ce7);
            width: 40px;
            height: 40px;
        }

        .send-btn:hover {
            transform: scale(1.05);
        }

        .voice-btn.recording {
            background: #ff4757;
            animation: recordingPulse 1.5s ease-in-out infinite;
        }

        .upload-preview {
            position: relative;
            display: inline-block;
        }

        .upload-preview img {
            max-width: 80px;
            max-height: 80px;
            border-radius: 10px;
        }

        .upload-preview .remove-preview {
            position: absolute;
            top: -8px;
            right: -8px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #ff4757;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Add Friend Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: 10;
            justify-content: center;
            align-items: center;
        }

        .modal-box {
            background: rgba(20, 28, 48, 0.98);
            border: 1px solid rgba(100, 200, 255, 0.15);
            border-radius: 16px;
            padding: 24px;
            width: 90%;
            max-width: 320px;
            animation: fadeIn 0.3s ease-out;
        }

        .modal-box h3 {
            margin-bottom: 16px;
            text-align: center;
        }

        .modal-box input {
            width: 100%;
            padding: 10px 14px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: rgba(15, 20, 35, 0.7);
            color: white;
            outline: none;
            font-size: 0.9em;
            margin-bottom: 12px;
        }

        .modal-box .btn-row {
            display: flex;
            gap: 10px;
        }

        .modal-box .btn-row button {
            flex: 1;
            padding: 10px;
            border-radius: 25px;
            border: none;
            cursor: pointer;
            font-size: 0.9em;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #4a90d9, #6c5ce7);
            color: white;
        }

        .btn-primary:hover {
            box-shadow: 0 4px 15px rgba(74, 144, 217, 0.5);
        }

        .btn-secondary {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            color: rgba(255, 255, 255, 0.7);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body>
    <!-- Auth Screen -->
    <div class="auth-container" id="auth-screen">
        <div class="auth-box" id="login-box">
            <h2>Silox Chat</h2>
            <p class="auth-error" id="auth-error"></p>
            <input type="text" id="login-username" placeholder="Username">
            <input type="password" id="login-password" placeholder="Password">
            <button class="auth-btn" onclick="handleLogin()">Login</button>
            <div class="auth-switch">
                Don't have an account? <a onclick="showRegister()">Register</a>
            </div>
        </div>
        <div class="auth-box" id="register-box" style="display: none;">
            <h2>Create Account</h2>
            <p class="auth-error" id="reg-error"></p>
            <input type="text" id="reg-username" placeholder="Choose a username">
            <input type="password" id="reg-password" placeholder="Create a password">
            <input type="password" id="reg-confirm" placeholder="Confirm password">
            <button class="auth-btn" onclick="handleRegister()">Register</button>
            <div class="auth-switch">
                Already have an account? <a onclick="showLogin()">Login</a>
            </div>
        </div>
    </div>

    <!-- Main Chat -->
    <div class="main-chat" id="main-chat">
        <div class="chat-header">
            <div class="chat-header-left">
                <div class="user-avatar" id="header-avatar">?</div>
                <div class="user-info">
                    <div class="username" id="header-username">Loading...</div>
                    <div class="status">Online</div>
                </div>
            </div>
            <button class="icon-btn" onclick="handleLogout()" title="Logout">↩</button>
        </div>
        <div class="chat-tabs" id="chat-tabs">
            <button class="chat-tab active" data-friend="global" onclick="switchChat('global')">🌍 Global</button>
            <button class="chat-tab add-friend-tab" onclick="showAddFriend()" title="Add Friend">+</button>
        </div>
        <div class="messages-area" id="messages-area">
            <div class="system-msg">Welcome to Silox Chat! Select a conversation or start chatting in Global.</div>
        </div>
        <div class="input-area">
            <input type="file" id="image-upload" accept="image/*" style="display: none;" onchange="handleImageUpload(event)">
            <button class="icon-btn" onclick="document.getElementById('image-upload').click()" title="Send Image">🖼</button>
            <div id="upload-preview-container"></div>
            <input type="text" id="message-input" placeholder="Type a message..." onkeydown="if(event.key==='Enter') sendMessage()">
            <button class="icon-btn voice-btn" id="voice-btn" onclick="toggleRecording()" title="Voice Message">🎤</button>
            <button class="icon-btn send-btn" onclick="sendMessage()" title="Send">➜</button>
        </div>
    </div>

    <!-- Add Friend Modal -->
    <div class="modal-overlay" id="add-friend-modal">
        <div class="modal-box">
            <h3>Add Friend</h3>
            <p class="auth-error" id="friend-error"></p>
            <input type="text" id="friend-username" placeholder="Enter username to add">
            <div class="btn-row">
                <button class="btn-primary" onclick="addFriend()">Add</button>
                <button class="btn-secondary" onclick="closeAddFriend()">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        // Chat system using localStorage (client-side storage)
        const CHAT_PREFIX = 'silox_chat_';
        let currentUser = null;
        let currentChat = 'global';
        let friends = [];
        let mediaRecorder = null;
        let audioChunks = [];
        let uploadedImage = null;

        function getUsers() {
            return JSON.parse(localStorage.getItem(CHAT_PREFIX + 'users') || '{}');
        }

        function saveUsers(users) {
            localStorage.setItem(CHAT_PREFIX + 'users', JSON.stringify(users));
        }

        function getMessages(chatId) {
            return JSON.parse(localStorage.getItem(CHAT_PREFIX + 'msg_' + chatId) || '[]');
        }

        function saveMessages(chatId, messages) {
            localStorage.setItem(CHAT_PREFIX + 'msg_' + chatId, JSON.stringify(messages));
        }

        function showError(id, msg) {
            const el = document.getElementById(id);
            el.textContent = msg;
            el.style.display = 'block';
            setTimeout(() => { el.style.display = 'none'; }, 3000);
        }

        function showLogin() {
            document.getElementById('login-box').style.display = 'block';
            document.getElementById('register-box').style.display = 'none';
        }

        function showRegister() {
            document.getElementById('login-box').style.display = 'none';
            document.getElementById('register-box').style.display = 'block';
        }

        function handleRegister() {
            const username = document.getElementById('reg-username').value.trim();
            const password = document.getElementById('reg-password').value;
            const confirm = document.getElementById('reg-confirm').value;

            if (!username || !password) {
                showError('reg-error', 'Please fill all fields');
                return;
            }
            if (password !== confirm) {
                showError('reg-error', 'Passwords do not match');
                return;
            }
            if (username.length < 3) {
                showError('reg-error', 'Username must be at least 3 characters');
                return;
            }

            const users = getUsers();
            if (users[username]) {
                showError('reg-error', 'Username already exists');
                return;
            }

            users[username] = { password, friends: [] };
            saveUsers(users);
            
            currentUser = { username, friends: [] };
            localStorage.setItem(CHAT_PREFIX + 'session', JSON.stringify(currentUser));
            loadMainChat();
        }

        function handleLogin() {
            const username = document.getElementById('login-username').value.trim();
            const password = document.getElementById('login-password').value;

            if (!username || !password) {
                showError('auth-error', 'Please fill all fields');
                return;
            }

            const users = getUsers();
            if (!users[username] || users[username].password !== password) {
                showError('auth-error', 'Invalid username or password');
                return;
            }

            currentUser = { username, friends: users[username].friends || [] };
            friends = currentUser.friends;
            localStorage.setItem(CHAT_PREFIX + 'session', JSON.stringify(currentUser));
            loadMainChat();
        }

        function handleLogout() {
            localStorage.removeItem(CHAT_PREFIX + 'session');
            currentUser = null;
            friends = [];
            currentChat = 'global';
            document.getElementById('auth-screen').style.display = 'flex';
            document.getElementById('main-chat').style.display = 'none';
        }

        function loadMainChat() {
            document.getElementById('auth-screen').style.display = 'none';
            document.getElementById('main-chat').style.display = 'flex';
            document.getElementById('header-username').textContent = currentUser.username;
            document.getElementById('header-avatar').textContent = currentUser.username[0].toUpperCase();
            
            const users = getUsers();
            friends = users[currentUser.username]?.friends || [];
            
            renderChatTabs();
            switchChat('global');
        }

        function renderChatTabs() {
            const tabsContainer = document.getElementById('chat-tabs');
            tabsContainer.innerHTML = `
                <button class="chat-tab ${currentChat === 'global' ? 'active' : ''}" data-friend="global" onclick="switchChat('global')">🌍 Global</button>
            `;
            
            friends.forEach(friend => {
                tabsContainer.innerHTML += `
                    <button class="chat-tab ${currentChat === friend ? 'active' : ''}" data-friend="${friend}" onclick="switchChat('${friend}')">
                        ${friend}
                    </button>
                `;
            });
            
            tabsContainer.innerHTML += `
                <button class="chat-tab add-friend-tab" onclick="showAddFriend()" title="Add Friend">+</button>
            `;
        }

        function switchChat(chatId) {
            currentChat = chatId;
            renderChatTabs();
            renderMessages();
        }

        function renderMessages() {
            const messagesArea = document.getElementById('messages-area');
            const messages = getMessages(currentChat);
            
            if (messages.length === 0) {
                messagesArea.innerHTML = '<div class="system-msg">No messages yet. Say hello! 👋</div>';
                return;
            }

            messagesArea.innerHTML = messages.map(msg => {
                const isMine = msg.sender === currentUser.username;
                const time = new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                
                let content = '';
                if (msg.type === 'image') {
                    content = `<img src="${msg.content}" alt="Shared image" onclick="window.open('${msg.content}')">`;
                } else if (msg.type === 'voice') {
                    content = `<div class="voice-msg">🎤 <audio controls src="${msg.content}"></audio></div>`;
                } else {
                    content = msg.content;
                }

                return `
                    <div class="message ${isMine ? 'mine' : 'other'}">
                        ${!isMine ? `<div class="msg-sender">${msg.sender}</div>` : ''}
                        ${content}
                        <div class="msg-time">${time}</div>
                    </div>
                `;
            }).join('');

            messagesArea.scrollTop = messagesArea.scrollHeight;
        }

        function sendMessage() {
            const input = document.getElementById('message-input');
            const text = input.value.trim();

            if (!text && !uploadedImage) return;

            const messages = getMessages(currentChat);
            
            if (uploadedImage) {
                messages.push({
                    sender: currentUser.username,
                    content: uploadedImage,
                    type: 'image',
                    timestamp: Date.now()
                });
                uploadedImage = null;
                document.getElementById('upload-preview-container').innerHTML = '';
            }

            if (text) {
                messages.push({
                    sender: currentUser.username,
                    content: text,
                    type: 'text',
                    timestamp: Date.now()
                });
            }

            saveMessages(currentChat, messages);
            input.value = '';
            renderMessages();
        }

        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                uploadedImage = e.target.result;
                document.getElementById('upload-preview-container').innerHTML = `
                    <div class="upload-preview">
                        <img src="${uploadedImage}" alt="Preview">
                        <button class="remove-preview" onclick="removePreview()">✕</button>
                    </div>
                `;
            };
            reader.readAsDataURL(file);
        }

        function removePreview() {
            uploadedImage = null;
            document.getElementById('upload-preview-container').innerHTML = '';
        }

        async function toggleRecording() {
            const voiceBtn = document.getElementById('voice-btn');

            if (mediaRecorder && mediaRecorder.state === 'recording') {
                mediaRecorder.stop();
                voiceBtn.classList.remove('recording');
                voiceBtn.textContent = '🎤';
                return;
            }

            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = (e) => {
                    audioChunks.push(e.data);
                };

                mediaRecorder.onstop = () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const messages = getMessages(currentChat);
                        messages.push({
                            sender: currentUser.username,
                            content: e.target.result,
                            type: 'voice',
                            timestamp: Date.now()
                        });
                        saveMessages(currentChat, messages);
                        renderMessages();
                    };
                    reader.readAsDataURL(audioBlob);
                    stream.getTracks().forEach(track => track.stop());
                };

                mediaRecorder.start();
                voiceBtn.classList.add('recording');
                voiceBtn.textContent = '⏺';
            } catch (err) {
                alert('Microphone access denied. Voice messages require microphone permission.');
            }
        }

        function showAddFriend() {
            document.getElementById('add-friend-modal').style.display = 'flex';
        }

        function closeAddFriend() {
            document.getElementById('add-friend-modal').style.display = 'none';
            document.getElementById('friend-username').value = '';
        }

        function addFriend() {
            const friendUsername = document.getElementById('friend-username').value.trim();
            
            if (!friendUsername) {
                showError('friend-error', 'Please enter a username');
                return;
            }
            if (friendUsername === currentUser.username) {
                showError('friend-error', 'You cannot add yourself');
                return;
            }
            if (friends.includes(friendUsername)) {
                showError('friend-error', 'Already in your friends list');
                return;
            }

            const users = getUsers();
            if (!users[friendUsername]) {
                showError('friend-error', 'User not found');
                return;
            }

            friends.push(friendUsername);
            users[currentUser.username].friends = friends;
            saveUsers(users);
            
            localStorage.setItem(CHAT_PREFIX + 'session', JSON.stringify(currentUser));
            currentUser.friends = friends;
            
            closeAddFriend();
            renderChatTabs();
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            const session = JSON.parse(localStorage.getItem(CHAT_PREFIX + 'session'));
            if (session) {
                currentUser = session;
                friends = session.friends || [];
                loadMainChat();
            }
        });
    </script>
</body>
</html>