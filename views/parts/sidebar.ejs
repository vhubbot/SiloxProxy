<div class="sidebar">
    <div class="sidebar-header">
        <svg class="sidebar-logo" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
        </svg>
        <span class="sidebar-brand">SILOX</span>
    </div>

    <div class="sidebar-section">
        <h3 class="sidebar-title">NAVIGATION</h3>
        <div class="sidebar-links-container">
            <a href="/" id="sidebar-home-link" class="sidebar-item">
                <svg class="sidebar-item-icon" viewBox="0 0 16 16" fill="none">
                    <path d="M1 6V15H6V11C6 9.89543 6.89543 9 8 9C9.10457 9 10 9.89543 10 11V15H15V6L8 0L1 6Z" fill="white"/>
                </svg>
                Home
            </a>
            <a href="/settings/" id="settings-main-link" class="sidebar-item">
                <svg class="sidebar-item-icon" viewBox="0 0 16 16" fill="none">
                    <circle cx="8" cy="8" r="6" stroke="white" stroke-width="1.5" fill="none"/>
                    <circle cx="8" cy="8" r="2" fill="white"/>
                </svg>
                Settings
            </a>
            <a href="/settings/styles" id="settings-styles-link" class="sidebar-item">
                <svg class="sidebar-item-icon" viewBox="0 0 16 16" fill="none">
                    <rect x="1" y="1" width="14" height="14" rx="3" stroke="white" stroke-width="1.5" fill="none"/>
                    <circle cx="5.5" cy="5.5" r="1.5" fill="white"/>
                    <path d="M9 10l4-4" stroke="white" stroke-width="1.5"/>
                </svg>
                Style
            </a>
            <a href="/settings/misc" id="settings-misc-link" class="sidebar-item">
                <svg class="sidebar-item-icon" viewBox="0 0 16 16" fill="none">
                    <circle cx="3" cy="3" r="1.5" fill="white"/>
                    <circle cx="13" cy="3" r="1.5" fill="white"/>
                    <circle cx="3" cy="13" r="1.5" fill="white"/>
                    <circle cx="13" cy="13" r="1.5" fill="white"/>
                </svg>
                Misc
            </a>
        </div>
    </div>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-section">
        <h3 class="sidebar-title">SOCIAL</h3>
        <div class="social-buttons">
            <a href="https://discord.gg/NXBjMGHWPw" target="_blank" class="social-button" title="Discord">
                <img src="/assets/svg/discord.svg" alt="Discord" class="sidebar-icon">
            </a>
            <a href="https://github.com/Xylara/Xylara" target="_blank" class="social-button" title="GitHub">
                <img src="/assets/svg/github.svg" alt="GitHub" class="sidebar-icon">
            </a>
        </div>
    </div>
</div>

<style>
    @keyframes slideInSidebar {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes sidebarItemIn {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .sidebar {
        width: 220px;
        background: rgba(15, 20, 35, 0.8);
        backdrop-filter: blur(25px);
        padding: 20px 15px;
        box-sizing: border-box;
        position: fixed;
        height: calc(100% - 20px);
        left: 10px;
        top: 10px;
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(100, 200, 255, 0.03);
        z-index: 900;
        animation: slideInSidebar 0.5s ease-out;
        transition: all 0.3s ease;
    }

    .sidebar:hover {
        border-color: rgba(100, 200, 255, 0.15);
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(100, 200, 255, 0.08);
    }

    .sidebar-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px 16px 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 4px;
    }

    .sidebar-logo {
        width: 24px;
        height: 24px;
        opacity: 0.8;
    }

    .sidebar-brand {
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 3px;
        color: rgba(100, 200, 255, 0.8);
    }

    .sidebar-section {
        margin-bottom: 2px;
    }

    .sidebar-title {
        color: rgba(255, 255, 255, 0.35);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 3px;
        margin: 12px 10px 8px 10px;
        text-transform: uppercase;
    }

    .sidebar-links-container {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .sidebar-item {
        display: flex;
        align-items: center;
        gap: 10px;
        color: rgba(255, 255, 255, 0.7);
        padding: 10px 12px;
        text-decoration: none;
        border-radius: 12px;
        transition: all 0.25s ease;
        font-size: 0.9em;
        font-weight: 500;
        animation: sidebarItemIn 0.4s ease-out both;
    }

    .sidebar-item:nth-child(1) { animation-delay: 0.05s; }
    .sidebar-item:nth-child(2) { animation-delay: 0.1s; }
    .sidebar-item:nth-child(3) { animation-delay: 0.15s; }
    .sidebar-item:nth-child(4) { animation-delay: 0.2s; }

    .sidebar-item:hover {
        background-color: rgba(255, 255, 255, 0.06);
        color: white;
        transform: translateX(4px);
    }

    .sidebar-item.active {
        background: rgba(100, 200, 255, 0.1);
        border: 1px solid rgba(100, 200, 255, 0.2);
        color: white;
        box-shadow: 0 0 15px rgba(100, 200, 255, 0.05);
    }

    .sidebar-item-icon {
        width: 16px;
        height: 16px;
        opacity: 0.6;
        transition: all 0.25s ease;
        flex-shrink: 0;
    }

    .sidebar-item:hover .sidebar-item-icon,
    .sidebar-item.active .sidebar-item-icon {
        opacity: 1;
    }

    .sidebar-spacer {
        flex: 1;
    }

    .social-buttons {
        display: flex;
        gap: 8px;
        padding: 0 10px;
    }

    .social-button {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: all 0.3s ease;
        position: relative;
    }

    .social-button:hover {
        background-color: rgba(255, 255, 255, 0.12);
        border-color: rgba(100, 200, 255, 0.3);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(100, 200, 255, 0.2);
    }

    .sidebar-icon {
        width: 20px;
        height: 20px;
        opacity: 0.7;
        transition: all 0.3s ease;
    }

    .social-button:hover .sidebar-icon {
        opacity: 1;
    }

    @media (max-width: 768px) {
        .sidebar {
            width: 180px;
            left: 6px;
            top: 6px;
            padding: 14px 10px;
            border-radius: 16px;
        }

        .sidebar-item {
            padding: 8px 10px;
            font-size: 0.85em;
        }

        .sidebar-brand {
            font-size: 0.95rem;
            letter-spacing: 2px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const currentPath = window.location.pathname;
        const sidebarItems = document.querySelectorAll('.sidebar-item');

        sidebarItems.forEach(item => {
            const href = item.getAttribute('href');
            if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
                sidebarItems.forEach(i => i.classList.remove('active'));
                item.classList.add('active');
            }
        });
    });
</script>