<style>
    @keyframes slideDownTopbar {
        from { opacity: 0; transform: translateX(-50%) translateY(-20px); }
        to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
    @keyframes iconPulse {
        0%, 100% { filter: drop-shadow(0 0 0px rgba(100, 200, 255, 0)); }
        50% { filter: drop-shadow(0 0 6px rgba(100, 200, 255, 0.5)); }
    }

    .topbar {
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        width: fit-content;
        background: rgba(15, 20, 35, 0.75);
        backdrop-filter: blur(20px);
        padding: 10px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        z-index: 1000;
        border-radius: 50px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(100, 200, 255, 0.05);
        animation: slideDownTopbar 0.6s ease-out;
        transition: all 0.3s ease;
    }
    .topbar:hover {
        border-color: rgba(100, 200, 255, 0.2);
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(100, 200, 255, 0.1);
    }
    .topbar-divider {
        width: 1px; height: 20px;
        background: rgba(255, 255, 255, 0.12);
        margin: 0 4px; border-radius: 1px;
    }
    .topbar a, .topbar .topbar-btn {
        display: flex; align-items: center; justify-content: center;
        padding: 8px 12px; border-radius: 25px;
        transition: all 0.25s ease;
        text-decoration: none; position: relative; cursor: pointer;
    }
    .topbar a:hover, .topbar .topbar-btn:hover {
        background-color: rgba(255, 255, 255, 0.08);
    }
    .topbar a.active {
        background: rgba(100, 200, 255, 0.12);
        border: 1px solid rgba(100, 200, 255, 0.25);
    }
    .topbar a.active .topbar-icon {
        animation: iconPulse 2s ease-in-out infinite;
    }
    .topbar-icon {
        width: 22px; height: 22px;
        transition: all 0.3s ease; opacity: 0.8;
    }
    .topbar a:hover .topbar-icon, .topbar .topbar-btn:hover .topbar-icon {
        opacity: 1; transform: scale(1.1);
    }
    .topbar a.active .topbar-icon { opacity: 1; }
    .topbar-app-icon {
        width: 20px; height: 20px; border-radius: 4px;
        transition: all 0.3s ease;
    }
    .topbar a:hover .topbar-app-icon, .topbar .topbar-btn:hover .topbar-app-icon {
        transform: scale(1.15);
    }
    .topbar-tooltip {
        position: absolute; bottom: -30px; left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.85);
        color: white; padding: 4px 10px; border-radius: 6px;
        font-size: 11px; white-space: nowrap;
        opacity: 0; pointer-events: none;
        transition: all 0.2s ease;
    }
    .topbar a:hover .topbar-tooltip, .topbar .topbar-btn:hover .topbar-tooltip {
        opacity: 1; bottom: -26px;
    }
    .topbar-btn.browser-btn {
        background: linear-gradient(135deg, rgba(250,30,78,0.2), rgba(255,71,87,0.2));
        border: 1px solid rgba(255,71,87,0.3);
    }
    .topbar-btn.browser-btn:hover {
        background: linear-gradient(135deg, rgba(250,30,78,0.4), rgba(255,71,87,0.4));
        border-color: rgba(255,71,87,0.6);
    }

    @media (max-width: 600px) {
        .topbar { padding: 8px 14px; gap: 2px; }
        .topbar a, .topbar .topbar-btn { padding: 6px 10px; }
        .topbar-icon { width: 18px; height: 18px; }
        .topbar-app-icon { width: 16px; height: 16px; }
    }
</style>

<div class="topbar">
    <a href="/" id="home-link">
        <svg class="topbar-icon" viewBox="0 0 16 16" fill="none"><path d="M1 6V15H6V11C6 9.89543 6.89543 9 8 9C9.10457 9 10 9.89543 10 11V15H15V6L8 0L1 6Z" fill="white"/></svg>
        <span class="topbar-tooltip">Home</span>
    </a>

    <div class="topbar-divider"></div>

    <!-- Browser Button -->
    <a href="/search" class="topbar-btn browser-btn" id="browser-link">
        <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="2" y="3" width="20" height="18" rx="2"/><line x1="2" y1="8" x2="22" y2="8"/><circle cx="6" cy="5.5" r="0.8" fill="white"/><circle cx="9" cy="5.5" r="0.8" fill="white"/><circle cx="12" cy="5.5" r="0.8" fill="white"/></svg>
        <span class="topbar-tooltip">GX Browser</span>
    </a>

    <div class="topbar-divider"></div>

    <a href="#" class="topbar-btn" onclick="event.preventDefault(); window.handleTopbarApp('https://discord.com')">
        <img src="/assets/svg/discord.svg" alt="Discord" class="topbar-app-icon">
        <span class="topbar-tooltip">Discord</span>
    </a>
    <a href="#" class="topbar-btn" onclick="event.preventDefault(); window.handleTopbarApp('https://youtube.com')">
        <img src="/assets/svg/youtube.svg" alt="YouTube" class="topbar-app-icon">
        <span class="topbar-tooltip">YouTube</span>
    </a>
    <a href="#" class="topbar-btn" onclick="event.preventDefault(); window.handleTopbarApp('https://tiktok.com')">
        <svg class="topbar-icon" viewBox="0 0 24 24" fill="white"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        <span class="topbar-tooltip">TikTok</span>
    </a>
    <a href="#" class="topbar-btn" onclick="event.preventDefault(); window.handleTopbarApp('https://spotify.com')">
        <img src="/assets/svg/spotify.svg" alt="Spotify" class="topbar-app-icon">
        <span class="topbar-tooltip">Spotify</span>
    </a>
    <a href="#" class="topbar-btn" onclick="event.preventDefault(); window.handleTopbarApp('https://x.com')">
        <img src="/assets/svg/x.svg" alt="X" class="topbar-app-icon">
        <span class="topbar-tooltip">X</span>
    </a>
    <a href="#" class="topbar-btn" onclick="event.preventDefault(); window.handleTopbarApp('https://play.geforcenow.com')">
        <img src="/assets/svg/geforcenow.svg" alt="GeForce Now" class="topbar-app-icon">
        <span class="topbar-tooltip">GeForce Now</span>
    </a>

    <a href="#" class="topbar-btn" id="add-app-topbar-btn">
        <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        <span class="topbar-tooltip">Add App</span>
    </a>

    <div class="topbar-divider"></div>

    <a href="/settings" id="settings-link">
        <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <span class="topbar-tooltip">Settings</span>
    </a>
</div>

<div id="add-app-modal-topbar" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.6); justify-content: center; align-items: center; backdrop-filter: blur(8px); color: white; z-index: 2000;">
    <div style="background: rgba(15, 20, 35, 0.95); backdrop-filter: blur(20px); padding: 28px; border-radius: 16px; text-align: center; border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); min-width: 320px;">
        <h3 style="margin: 0 0 20px 0; font-size: 1.2rem; color: rgba(100, 200, 255, 0.8); letter-spacing: 2px;">ADD APP</h3>
        <label style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.6); display: block; margin-bottom: 6px; text-align: left;">App Name</label>
        <input type="text" id="topbar-app-name" placeholder="e.g. Netflix" style="width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(20, 25, 40, 0.7); color: white; outline: none; font-size: 0.95em; margin-bottom: 14px; box-sizing: border-box;">
        <label style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.6); display: block; margin-bottom: 6px; text-align: left;">App URL</label>
        <input type="text" id="topbar-app-url" placeholder="e.g. netflix.com" style="width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(20, 25, 40, 0.7); color: white; outline: none; font-size: 0.95em; margin-bottom: 20px; box-sizing: border-box;">
        <div style="display: flex; gap: 10px; justify-content: center;">
            <button id="add-app-submit-topbar" style="flex: 1; padding: 10px; border-radius: 25px; border: none; background: linear-gradient(135deg, #4a90d9, #6c5ce7); color: white; cursor: pointer; font-size: 0.9em;">Add</button>
            <button id="add-app-cancel-topbar" style="flex: 1; padding: 10px; border-radius: 25px; border: 1px solid rgba(255, 255, 255, 0.2); background: transparent; color: rgba(255, 255, 255, 0.7); cursor: pointer; font-size: 0.9em;">Cancel</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const homeLink = document.getElementById('home-link');
        const settingsLink = document.getElementById('settings-link');
        if (window.location.pathname === '/') homeLink.classList.add('active');
        else if (window.location.pathname === '/settings' || window.location.pathname.startsWith('/settings/')) settingsLink.classList.add('active');

        window.handleTopbarApp = function(url) {
            let fullUrl = url;
            if (!fullUrl.startsWith('http://') && !fullUrl.startsWith('https://')) fullUrl = 'https://' + fullUrl;
            if (typeof __uv$config !== 'undefined' && typeof __uv$config.encodeUrl === 'function') {
                const encodedUrl = __uv$config.prefix + __uv$config.encodeUrl(fullUrl);
                localStorage.setItem("url", encodedUrl);
                window.location.href = "/search";
            } else {
                const encodedUrl = "/scram/service/" + encodeURIComponent(fullUrl);
                localStorage.setItem("url", encodedUrl);
                window.location.href = "/search";
            }
        };

        const addAppBtn = document.getElementById('add-app-topbar-btn');
        const modal = document.getElementById('add-app-modal-topbar');
        const submitBtn = document.getElementById('add-app-submit-topbar');
        const cancelBtn = document.getElementById('add-app-cancel-topbar');
        const nameInput = document.getElementById('topbar-app-name');
        const urlInput = document.getElementById('topbar-app-url');

        if (addAppBtn) addAppBtn.addEventListener('click', (e) => { e.preventDefault(); modal.style.display = 'flex'; });
        if (cancelBtn) cancelBtn.addEventListener('click', () => { modal.style.display = 'none'; nameInput.value = ''; urlInput.value = ''; });
        if (modal) modal.addEventListener('click', (e) => { if (e.target === modal) { modal.style.display = 'none'; nameInput.value = ''; urlInput.value = ''; } });
        if (submitBtn) submitBtn.addEventListener('click', () => {
            const name = nameInput.value.trim();
            let url = urlInput.value.trim();
            if (!name || !url) return;
            if (!url.startsWith('http')) url = 'https://' + url;
            let customApps = JSON.parse(localStorage.getItem('topbarApps') || '[]');
            customApps.push({ name, url });
            localStorage.setItem('topbarApps', JSON.stringify(customApps));
            modal.style.display = 'none'; nameInput.value = ''; urlInput.value = '';
            location.reload();
        });

        function loadCustomApps() {
            const customApps = JSON.parse(localStorage.getItem('topbarApps') || '[]');
            const divider = document.querySelector('.topbar-divider:last-of-type');
            const settingsLinkEl = document.getElementById('settings-link');
            customApps.forEach((app, index) => {
                const appEl = document.createElement('a');
                appEl.href = '#'; appEl.className = 'topbar-btn'; appEl.setAttribute('data-app-index', index);
                appEl.setAttribute('onclick', "event.preventDefault(); window.handleTopbarApp('" + app.url.replace(/'/g, "\\'") + "')");
                appEl.innerHTML = `<span style="font-size: 12px; font-weight: 600; letter-spacing: 1px; color: rgba(255,255,255,0.7);">${app.name.substring(0, 4).toUpperCase()}</span><span class="topbar-tooltip">${app.name}</span>`;
                appEl.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                    let customApps = JSON.parse(localStorage.getItem('topbarApps') || '[]');
                    customApps = customApps.filter(a => a.name !== app.name || a.url !== app.url);
                    localStorage.setItem('topbarApps', JSON.stringify(customApps));
                    location.reload();
                });
                if (divider) divider.parentNode.insertBefore(appEl, divider);
                else if (settingsLinkEl) settingsLinkEl.parentNode.insertBefore(appEl, settingsLinkEl);
            });
        }
        loadCustomApps();
    });
</script>