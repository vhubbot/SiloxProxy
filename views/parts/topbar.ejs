<!-- Add App Modal -->
<div id="add-app-modal-topbar" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.6); justify-content: center; align-items: center; backdrop-filter: blur(8px); color: white; z-index: 2000;">
    <div style="background: rgba(15, 20, 35, 0.95); backdrop-filter: blur(20px); padding: 28px; border-radius: 16px; text-align: center; border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); min-width: 320px;">
        <h3 style="margin: 0 0 20px 0; font-size: 1.2rem; color: rgba(100, 200, 255, 0.8); letter-spacing: 2px;">ADD APP</h3>
        <label style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.6); display: block; margin-bottom: 6px; text-align: left;">App Name</label>
        <input type="text" id="topbar-app-name" placeholder="e.g. Netflix" style="width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(20, 25, 40, 0.7); color: white; outline: none; font-size: 0.95em; margin-bottom: 14px; box-sizing: border-box; transition: all 0.3s ease;">
        <label style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.6); display: block; margin-bottom: 6px; text-align: left;">App URL</label>
        <input type="text" id="topbar-app-url" placeholder="e.g. netflix.com" style="width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(20, 25, 40, 0.7); color: white; outline: none; font-size: 0.95em; margin-bottom: 20px; box-sizing: border-box; transition: all 0.3s ease;">
        <div style="display: flex; gap: 10px; justify-content: center;">
            <button id="add-app-submit-topbar" style="flex: 1; padding: 10px; border-radius: 25px; border: none; background: linear-gradient(135deg, #4a90d9, #6c5ce7); color: white; cursor: pointer; font-size: 0.9em; transition: all 0.2s ease;">Add</button>
            <button id="add-app-cancel-topbar" style="flex: 1; padding: 10px; border-radius: 25px; border: 1px solid rgba(255, 255, 255, 0.2); background: transparent; color: rgba(255, 255, 255, 0.7); cursor: pointer; font-size: 0.9em; transition: all 0.2s ease;">Cancel</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const homeLink = document.getElementById('home-link');
        const settingsLink = document.getElementById('settings-link');

        if (window.location.pathname === '/') {
            homeLink.classList.add('active');
        } else if (window.location.pathname === '/settings' || window.location.pathname.startsWith('/settings/')) {
            settingsLink.classList.add('active');
        }

        // Handle clicking an app in the topbar - properly encode through proxy
        window.handleTopbarApp = function(url) {
            // Ensure URL has protocol
            let fullUrl = url;
            if (!fullUrl.startsWith('http://') && !fullUrl.startsWith('https://')) {
                fullUrl = 'https://' + fullUrl;
            }

            // Use Ultraviolet encoding
            if (typeof __uv$config !== 'undefined' && typeof __uv$config.encodeUrl === 'function') {
                const encodedUrl = __uv$config.prefix + __uv$config.encodeUrl(fullUrl);
                localStorage.setItem("url", encodedUrl);
                window.location.href = "/search";
            }
            // Fallback to Scramjet encoding
            else {
                const encodedUrl = "/scram/service/" + encodeURIComponent(fullUrl);
                localStorage.setItem("url", encodedUrl);
                window.location.href = "/search";
            }
        };

        // Add App Modal Logic
        const addAppBtn = document.getElementById('add-app-topbar-btn');
        const modal = document.getElementById('add-app-modal-topbar');
        const submitBtn = document.getElementById('add-app-submit-topbar');
        const cancelBtn = document.getElementById('add-app-cancel-topbar');
        const nameInput = document.getElementById('topbar-app-name');
        const urlInput = document.getElementById('topbar-app-url');

        if (addAppBtn) {
            addAppBtn.addEventListener('click', (e) => {
                e.preventDefault();
                modal.style.display = 'flex';
            });
        }

        if (cancelBtn) {
            cancelBtn.addEventListener('click', () => {
                modal.style.display = 'none';
                nameInput.value = '';
                urlInput.value = '';
            });
        }

        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.style.display = 'none';
                    nameInput.value = '';
                    urlInput.value = '';
                }
            });
        }

        if (submitBtn) {
            submitBtn.addEventListener('click', () => {
                const name = nameInput.value.trim();
                let url = urlInput.value.trim();
                if (!name || !url) return;
                if (!url.startsWith('http')) url = 'https://' + url;

                // Save custom app
                let customApps = JSON.parse(localStorage.getItem('topbarApps') || '[]');
                customApps.push({ name, url });
                localStorage.setItem('topbarApps', JSON.stringify(customApps));

                modal.style.display = 'none';
                nameInput.value = '';
                urlInput.value = '';

                // Reload to show new button
                location.reload();
            });
        }

        // Load custom apps from localStorage
        function loadCustomApps() {
            const customApps = JSON.parse(localStorage.getItem('topbarApps') || '[]');
            const divider = document.querySelector('.topbar-divider:last-of-type');
            const settingsLinkEl = document.getElementById('settings-link');

            customApps.forEach((app, index) => {
                const appEl = document.createElement('a');
                appEl.href = '#';
                appEl.className = 'topbar-btn';
                appEl.setAttribute('data-app-index', index);
                
                appEl.setAttribute('onclick', "event.preventDefault(); window.handleTopbarApp('" + app.url.replace(/'/g, "\\'") + "')");
                
                appEl.innerHTML = `
                    <span style="font-size: 12px; font-weight: 600; letter-spacing: 1px; color: rgba(255,255,255,0.7);">${app.name.substring(0, 4).toUpperCase()}</span>
                    <span class="topbar-tooltip">${app.name}</span>
                `;
                
                // Right-click to remove
                appEl.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                    let customApps = JSON.parse(localStorage.getItem('topbarApps') || '[]');
                    customApps = customApps.filter(a => a.name !== app.name || a.url !== app.url);
                    localStorage.setItem('topbarApps', JSON.stringify(customApps));
                    location.reload();
                });

                if (divider) {
                    divider.parentNode.insertBefore(appEl, divider);
                } else if (settingsLinkEl) {
                    settingsLinkEl.parentNode.insertBefore(appEl, settingsLinkEl);
                }
            });
        }

        loadCustomApps();
    });
</script>