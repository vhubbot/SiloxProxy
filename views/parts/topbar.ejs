<style>
    @keyframes slideDownTopbar {
        from {
            opacity: 0;
            transform: translateX(-50%) translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    }

    @keyframes iconPulse {
        0%, 100% { filter: drop-shadow(0 0 0px rgba(100, 200, 255, 0)); }
        50% { filter: drop-shadow(0 0 6px rgba(100, 200, 255, 0.5)); }
    }

    .topbar {
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        width: fit-content;
        background: rgba(15, 20, 35, 0.75);
        backdrop-filter: blur(20px);
        padding: 10px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        z-index: 1000;
        border-radius: 50px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(100, 200, 255, 0.05);
        animation: slideDownTopbar 0.6s ease-out;
        transition: all 0.3s ease;
    }

    .topbar:hover {
        border-color: rgba(100, 200, 255, 0.2);
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(100, 200, 255, 0.1);
    }

    .topbar-divider {
        width: 1px;
        height: 20px;
        background: rgba(255, 255, 255, 0.12);
        margin: 0 4px;
        border-radius: 1px;
    }

    .topbar a,
    .topbar .topbar-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border-radius: 25px;
        transition: all 0.25s ease;
        text-decoration: none;
        position: relative;
        cursor: pointer;
    }

    .topbar a:hover,
    .topbar .topbar-btn:hover {
        background-color: rgba(255, 255, 255, 0.08);
    }

    .topbar a.active {
        background: rgba(100, 200, 255, 0.12);
        border: 1px solid rgba(100, 200, 255, 0.25);
    }

    .topbar a.active .topbar-icon {
        animation: iconPulse 2s ease-in-out infinite;
    }

    .topbar-icon {
        width: 22px;
        height: 22px;
        transition: all 0.3s ease;
        opacity: 0.8;
    }

    .topbar a:hover .topbar-icon,
    .topbar .topbar-btn:hover .topbar-icon {
        opacity: 1;
        transform: scale(1.1);
    }

    .topbar a.active .topbar-icon {
        opacity: 1;
    }

    .topbar-app-icon {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

    .topbar a:hover .topbar-app-icon,
    .topbar .topbar-btn:hover .topbar-app-icon {
        transform: scale(1.15);
    }

    .topbar-tooltip {
        position: absolute;
        bottom: -30px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.85);
        color: white;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: all 0.2s ease;
    }

    .topbar a:hover .topbar-tooltip,
    .topbar .topbar-btn:hover .topbar-tooltip {
        opacity: 1;
        bottom: -26px;
    }

    @media (max-width: 600px) {
        .topbar {
            padding: 8px 14px;
            gap: 2px;
        }
        .topbar a, .topbar .topbar-btn {
            padding: 6px 10px;
        }
        .topbar-icon {
            width: 18px;
            height: 18px;
        }
        .topbar-app-icon {
            width: 16px;
            height: 16px;
        }
    }
</style>

