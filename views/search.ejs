<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://app.rybbit.io/api/script.js" data-site-id="8b65ec526edf" defer></script>
    <script src="/baremux/index.js"></script>
    <script src="/epoxy/index.mjs" type="module"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>
    <script src="/scram/scramjet.all.js"></script>
    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <title>Silox GX</title>
    <style>
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes loadingBar {
            0% { width: 0%; }
            30% { width: 40%; }
            60% { width: 75%; }
            90% { width: 95%; }
            100% { width: 100%; }
        }
        @keyframes gxFadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes gxGlow {
            0%, 100% { text-shadow: 0 0 20px rgba(250,30,78,0.3); }
            50% { text-shadow: 0 0 40px rgba(250,30,78,0.6), 0 0 60px rgba(250,30,78,0.2); }
        }
        @keyframes gradientShiftNT {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        :root {
            --gx-accent: #fa1e4e;
            --gx-accent2: #ff4757;
            --gx-bg: #1a1a2e;
            --gx-surface: #16213e;
            --gx-surface2: #0f3460;
            --gx-text: #e8e8e8;
            --gx-text2: #a0a0b0;
            --gx-border: rgba(255,255,255,0.06);
            --gx-shadow: 0 8px 32px rgba(0,0,0,0.4);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #0d0d1a;
            font-family: 'Segoe UI', 'Inter', system-ui, -apple-system, sans-serif;
            height: 100vh;
            display: flex;
            flex-direction: column;
            color: var(--gx-text);
        }

        .gx-sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 56px;
            height: 100%;
            background: rgba(13, 13, 26, 0.95);
            border-right: 1px solid var(--gx-border);
            z-index: 1100;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 12px 0;
            gap: 6px;
            backdrop-filter: blur(20px);
        }

        .gx-sidebar-btn {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            border: none;
            background: transparent;
            color: var(--gx-text2);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            position: relative;
        }

        .gx-sidebar-btn:hover {
            background: rgba(255,255,255,0.06);
            opacity: 1;
        }
        .gx-sidebar-btn.active {
            background: rgba(250, 30, 78, 0.15);
        }
        .gx-sidebar-btn.active::before {
            content: '';
            position: absolute;
            left: -12px;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 20px;
            background: var(--gx-accent);
            border-radius: 0 3px 3px 0;
        }
        .gx-sidebar-btn img {
            width: 22px;
            height: 22px;
            opacity: 0.7;
            transition: all 0.2s ease;
        }
        .gx-sidebar-btn:hover img {
            opacity: 1;
        }
        .gx-sidebar-btn.active img {
            opacity: 1;
        }
        .gx-sidebar-divider {
            width: 30px;
            height: 1px;
            background: var(--gx-border);
            margin: 8px 0;
        }

        .gx-main {
            margin-left: 56px;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .gx-topbar {
            display: flex;
            align-items: center;
            padding: 8px 16px;
            gap: 8px;
            background: rgba(13, 13, 26, 0.9);
            border-bottom: 1px solid var(--gx-border);
            backdrop-filter: blur(15px);
            z-index: 100;
        }

        .gx-nav-group {
            display: flex;
            gap: 2px;
        }
        .gx-nav-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: var(--gx-text2);
            cursor: pointer;
            font-size: 14px;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .gx-nav-btn:hover { background: rgba(255,255,255,0.05); color: white; }
        .gx-nav-btn:disabled { opacity: 0.25; cursor: default; }
        .gx-nav-btn:disabled:hover { background: transparent; }

        .gx-tabs {
            display: flex;
            align-items: center;
            flex: 1;
            overflow-x: auto;
            gap: 2px;
            padding: 0 4px;
            scrollbar-width: none;
        }
        .gx-tabs::-webkit-scrollbar { display: none; }

        .gx-tab {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            border-radius: 8px;
            background: rgba(255,255,255,0.03);
            border: 1px solid transparent;
            color: var(--gx-text2);
            cursor: pointer;
            font-size: 12px;
            white-space: nowrap;
            transition: all 0.15s ease;
            min-width: 80px;
            max-width: 180px;
            user-select: none;
        }
        .gx-tab:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.08); }
        .gx-tab.active { background: rgba(255,255,255,0.08); color: white; border-color: rgba(255,255,255,0.12); }
        .gx-tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; }
        .gx-tab-close {
            width: 16px; height: 16px; border-radius: 50%; border: none;
            background: transparent; color: var(--gx-text2); cursor: pointer;
            font-size: 10px; display: flex; align-items: center; justify-content: center;
            transition: all 0.15s; flex-shrink: 0;
        }
        .gx-tab-close:hover { background: rgba(255,60,60,0.4); color: white; }

        .gx-newtab-btn {
            width: 28px; height: 28px; border-radius: 8px;
            border: 1px dashed rgba(255,255,255,0.12); background: transparent;
            cursor: pointer; display: flex; align-items: center; justify-content: center;
            transition: all 0.15s; flex-shrink: 0;
        }
        .gx-newtab-btn img {
            width: 14px;
            height: 14px;
            opacity: 0.5;
            transition: all 0.15s;
        }
        .gx-newtab-btn:hover { border-color: var(--gx-accent); background: rgba(250,30,78,0.08); }
        .gx-newtab-btn:hover img { opacity: 0.9; }

        .gx-window-controls {
            display: flex;
            gap: 4px;
            margin-left: auto;
        }
        .gx-win-btn {
            width: 28px; height: 28px; border-radius: 8px; border: none;
            background: transparent; color: var(--gx-text2); cursor: pointer;
            font-size: 12px; transition: all 0.15s;
            display: flex; align-items: center; justify-content: center;
        }
        .gx-win-btn:hover { background: rgba(255,255,255,0.06); }

        .gx-url-row {
            display: flex;
            align-items: center;
            padding: 6px 16px 10px 16px;
            gap: 8px;
            background: rgba(13, 13, 26, 0.9);
            border-bottom: 1px solid var(--gx-border);
        }
        .gx-url-bar {
            flex: 1;
            display: flex;
            align-items: center;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            padding: 8px 14px;
            gap: 8px;
            transition: all 0.2s ease;
        }
        .gx-url-bar:focus-within {
            border-color: rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.06);
            box-shadow: 0 0 20px rgba(250,30,78,0.08);
        }
        .gx-url-icon { color: var(--gx-text2); font-size: 13px; flex-shrink: 0; }
        .gx-url-input {
            flex: 1; background: transparent; border: none; color: white;
            outline: none; font-size: 13px; font-family: inherit;
        }
        .gx-url-input::placeholder { color: rgba(255,255,255,0.25); }
        .gx-go-btn {
            width: 34px; height: 34px; border-radius: 10px; border: none;
            background: var(--gx-accent); color: white; cursor: pointer;
            font-size: 14px; display: flex; align-items: center; justify-content: center;
            transition: all 0.2s ease; flex-shrink: 0;
        }
        .gx-go-btn:hover { filter: brightness(1.2); transform: scale(1.04); }
        .gx-go-btn:active { transform: scale(0.94); }

        .gx-content {
            flex: 1;
            position: relative;
            background: #0d0d1a;
        }
        iframe {
            width: 100%; height: 100%; border: none;
            animation: fadeIn 0.3s ease-out;
        }

        .gx-loading {
            position: absolute;
            top: 0; left: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--gx-accent), #ff6b81, var(--gx-accent));
            animation: loadingBar 2s ease-in-out forwards;
            display: none;
            z-index: 10;
        }

        .gx-status {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 3px 16px;
            background: rgba(10, 10, 20, 0.95);
            border-top: 1px solid rgba(255,255,255,0.04);
            font-size: 10px;
            color: rgba(255,255,255,0.3);
        }
        .gx-status-left { display: flex; align-items: center; gap: 10px; }
        .gx-status-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: #2ecc71;
        }

        /* Settings Panel */
        .gx-settings-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 5000;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(5px);
            animation: fadeIn 0.2s ease-out;
        }
        .gx-settings-panel {
            background: var(--gx-surface);
            border: 1px solid var(--gx-border);
            border-radius: 16px;
            padding: 24px;
            width: 90%;
            max-width: 600px;
            max-height: 80vh;
            overflow-y: auto;
            animation: slideUp 0.3s ease-out;
            box-shadow: 0 20px 60px rgba(0,0,0,0.6);
        }
        .gx-settings-panel h3 {
            font-size: 1.2rem;
            margin-bottom: 20px;
            color: white;
            letter-spacing: 1px;
        }
        .gx-bg-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 12px;
            margin-bottom: 20px;
        }
        .gx-bg-option {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.2s ease;
            aspect-ratio: 16/9;
        }
        .gx-bg-option:hover {
            border-color: rgba(255,255,255,0.3);
            transform: translateY(-2px);
        }
        .gx-bg-option.selected {
            border-color: var(--gx-accent);
            box-shadow: 0 0 20px rgba(250,30,78,0.3);
        }
        .gx-bg-option img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .gx-bg-option .bg-label {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 6px 10px;
            background: rgba(0,0,0,0.7);
            font-size: 11px;
            color: white;
            text-align: center;
        }
        .gx-bg-option .selected-check {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--gx-accent);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            display: none;
        }
        .gx-bg-option.selected .selected-check {
            display: flex;
        }

        .gx-color-row {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .gx-color-option {
            width: 36px; height: 36px; border-radius: 50%;
            cursor: pointer; border: 2px solid transparent;
            transition: all 0.2s ease;
        }
        .gx-color-option:hover { transform: scale(1.15); }
        .gx-color-option.selected { border-color: white; box-shadow: 0 0 12px currentColor; }

        .gx-btn {
            padding: 8px 20px; border-radius: 8px; border: none;
            font-size: 13px; cursor: pointer; transition: all 0.2s ease;
            font-family: inherit;
        }
        .gx-btn-primary { background: var(--gx-accent); color: white; }
        .gx-btn-primary:hover { filter: brightness(1.15); }
        .gx-btn-secondary {
            background: transparent; border: 1px solid rgba(255,255,255,0.15);
            color: var(--gx-text2);
        }
        .gx-btn-secondary:hover { background: rgba(255,255,255,0.04); color: white; }

        /* Favorites bar */
        .gx-fav-bar {
            display: flex;
            gap: 6px;
            padding: 6px 16px;
            background: rgba(13, 13, 26, 0.95);
            border-bottom: 1px solid var(--gx-border);
            overflow-x: auto;
            align-items: center;
        }
        .gx-fav-item {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 8px;
            background: rgba(255,255,255,0.03);
            border: 1px solid transparent;
            color: var(--gx-text2);
            cursor: pointer;
            font-size: 11px;
            white-space: nowrap;
            transition: all 0.15s;
        }
        .gx-fav-item:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.1); color: white; }
        .gx-fav-add {
            padding: 6px 10px;
            border-radius: 8px;
            border: 1px dashed rgba(255,255,255,0.12);
            background: transparent;
            color: var(--gx-text2);
            cursor: pointer;
            font-size: 14px;
            transition: all 0.15s;
            flex-shrink: 0;
        }
        .gx-fav-add:hover { border-color: var(--gx-accent); color: var(--gx-accent); }

        /* New Tab Page Styles */
        .gx-nt {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background-size: cover;
            background-position: center;
            color: white;
            font-family: 'Segoe UI', 'Inter', sans-serif;
            padding: 40px 20px;
            text-align: center;
        }
        .gx-nt-logo {
            font-size: 4rem;
            font-weight: 900;
            letter-spacing: 8px;
            margin-bottom: 8px;
            animation: gxGlow 3s ease-in-out infinite;
        }
        .gx-nt-logo span {
            background: linear-gradient(135deg, var(--gx-accent, #fa1e4e), #ff6b81, var(--gx-accent, #fa1e4e));
            background-size: 200% 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShiftNT 3s ease infinite;
        }

        @keyframes gradientShiftNT {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .gx-nt-subtitle {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.4);
            letter-spacing: 3px;
            margin-bottom: 30px;
            text-transform: uppercase;
        }
        .gx-nt-search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            max-width: 500px;
            width: 90%;
            animation: gxFadeUp 0.5s ease-out 0.2s both;
        }
        .gx-nt-search-input {
            flex: 1;
            padding: 14px 22px;
            border-radius: 30px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.04);
            color: white;
            outline: none;
            font-size: 14px;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }
        .gx-nt-search-input:focus {
            border-color: var(--gx-accent, #fa1e4e);
            box-shadow: 0 0 25px rgba(250,30,78,0.15);
            background: rgba(255,255,255,0.06);
        }
        .gx-nt-search-input::placeholder { color: rgba(255,255,255,0.3); }
        .gx-nt-search-btn {
            padding: 14px 24px;
            border-radius: 30px;
            border: none;
            background: var(--gx-accent, #fa1e4e);
            color: white;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        .gx-nt-search-btn:hover { filter: brightness(1.2); transform: scale(1.03); }
        .gx-nt-speeddial {
            display: flex;
            gap: 16px;
            margin-top: 40px;
            flex-wrap: wrap;
            justify-content: center;
            animation: gxFadeUp 0.5s ease-out 0.4s both;
        }
        .gx-nt-dial {
            width: 100px;
            height: 100px;
            border-radius: 16px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.25s ease;
            text-decoration: none;
            color: rgba(255,255,255,0.6);
            font-size: 11px;
            padding: 8px;
        }
        .gx-nt-dial:hover {
            background: rgba(255,255,255,0.08);
            border-color: rgba(255,255,255,0.2);
            transform: translateY(-4px);
            color: white;
        }
        .gx-nt-dial-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            object-fit: contain;
            flex-shrink: 0;
        }
        .gx-nt-dial-name {
            text-align: center;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 80px;
            white-space: nowrap;
        }
        .gx-nt-add-dial {
            border: 2px dashed rgba(255,255,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .gx-nt-add-dial img {
            width: 28px;
            height: 28px;
            opacity: 0.4;
            transition: all 0.15s;
        }
        .gx-nt-add-dial:hover { border-color: var(--gx-accent, #fa1e4e); }
        .gx-nt-add-dial:hover img { opacity: 0.8; }

        @media (max-width: 700px) {
            .gx-sidebar { width: 42px; }
            .gx-main { margin-left: 42px; }
            .gx-sidebar-btn { width: 32px; height: 32px; border-radius: 10px; }
            .gx-sidebar-btn img { width: 18px; height: 18px; }
            .gx-tab { min-width: 60px; max-width: 120px; font-size: 11px; padding: 6px 10px; }
        }
    </style>
</head>
<body>
    <div class="gx-sidebar">
        <!-- Browser button (active by default since we're on /search) -->
        <button class="gx-sidebar-btn active" title="Browser">
            <img src="/public/icons/browser.png" alt="Browser">
        </button>
        <!-- New Tab button -->
        <button class="gx-sidebar-btn" title="New Tab" onclick="newTabBtn.click()">
            <img src="/public/icons/plus.png" alt="New Tab">
        </button>
        <div class="gx-sidebar-divider"></div>
        <!-- Favorites button -->
        <button class="gx-sidebar-btn" title="Favorites" onclick="toggleFavorites()">
            <img src="/public/icons/favorite.png" alt="Favorites">
        </button>
        <!-- Settings button -->
        <button class="gx-sidebar-btn" title="Settings" onclick="openGXSettings()">
            <img src="/public/icons/settings.png" alt="Settings">
        </button>
        <div class="gx-sidebar-divider"></div>
        <!-- Home button -->
        <button class="gx-sidebar-btn" title="Home" onclick="window.location.href='/'">
            <img src="/public/icons/home.png" alt="Home">
        </button>
    </div>

    <div class="gx-main">
        <div class="gx-topbar">
            <div class="gx-nav-group">
                <button class="gx-nav-btn" id="back-btn" disabled>◀</button>
                <button class="gx-nav-btn" id="forward-btn" disabled>▶</button>
                <button class="gx-nav-btn" id="refresh-btn">↻</button>
            </div>
            <div class="gx-tabs" id="gx-tabs">
                <button class="gx-newtab-btn" id="new-tab-btn" title="New Tab">
                    <img src="/public/icons/plus.png" alt="+">
                </button>
            </div>
            <div class="gx-window-controls">
                <button class="gx-win-btn" onclick="window.location.href='/'">⌂</button>
                <button class="gx-win-btn" onclick="openGXSettings()">⚙</button>
            </div>
        </div>

        <div class="gx-fav-bar" id="gx-fav-bar" style="display: none;">
            <button class="gx-fav-add" onclick="addFavorite()" title="Add current page to favorites">+</button>
        </div>

        <div class="gx-url-row">
            <div class="gx-url-bar">
                <span class="gx-url-icon">🔒</span>
                <input type="text" class="gx-url-input" id="url-input" placeholder="Search with DuckDuckGo or enter URL...">
            </div>
            <button class="gx-go-btn" id="go-btn">→</button>
        </div>

        <div class="gx-content">
            <div class="gx-loading" id="loading-bar"></div>
            <iframe id="Frame" src="" style="width:100%;height:100%;border:none;display:none;"></iframe>
            <div id="newtab-container" style="width:100%;height:100%;overflow:auto;display:flex;">
                <div class="gx-nt" id="gx-nt-page">
                    <div class="gx-nt-logo"><span>SILOX</span></div>
                    <div class="gx-nt-subtitle">Gaming Browser</div>
                    <div class="gx-nt-search-box">
                        <input type="text" class="gx-nt-search-input" id="gx-nt-search" placeholder="Search the web or enter URL..." onkeydown="if(event.key==='Enter') handleNavigation(this.value)">
                        <button class="gx-nt-search-btn" onclick="handleNavigation(document.getElementById('gx-nt-search').value)">Search</button>
                    </div>
                    <div class="gx-nt-speeddial" id="gx-speeddial">
                        <div class="gx-nt-dial gx-nt-add-dial" onclick="addSpeedDial()" title="Add Site">
                            <img src="/public/icons/plus.png" alt="+">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="gx-status">
            <div class="gx-status-left">
                <span class="gx-status-dot"></span>
                <span id="status-text">Ready</span>
            </div>
            <span id="status-tab-count">1 tab</span>
        </div>
    </div>

    <div class="gx-settings-overlay" id="gx-settings-overlay" style="display: none;">
        <div class="gx-settings-panel">
            <h3>⚙ GX Settings</h3>
            <p style="color:var(--gx-text2);margin-bottom:12px;font-size:13px;">Choose Background</p>
            <div class="gx-bg-grid" id="bg-grid"></div>
            <p style="color:var(--gx-text2);margin-bottom:12px;font-size:13px;">Accent Color</p>
            <div class="gx-color-row" id="color-row">
                <div class="gx-color-option" style="background:#fa1e4e" data-color="#fa1e4e" onclick="setAccent('#fa1e4e', this)"></div>
                <div class="gx-color-option" style="background:#ff6b35" data-color="#ff6b35" onclick="setAccent('#ff6b35', this)"></div>
                <div class="gx-color-option" style="background:#f7b731" data-color="#f7b731" onclick="setAccent('#f7b731', this)"></div>
                <div class="gx-color-option" style="background:#26de81" data-color="#26de81" onclick="setAccent('#26de81', this)"></div>
                <div class="gx-color-option" style="background:#45aaf2" data-color="#45aaf2" onclick="setAccent('#45aaf2', this)"></div>
                <div class="gx-color-option" style="background:#a55eea" data-color="#a55eea" onclick="setAccent('#a55eea', this)"></div>
                <div class="gx-color-option" style="background:#ffffff" data-color="#ffffff" onclick="setAccent('#ffffff', this)"></div>
                <div class="gx-color-option" style="background:#0d0d1a" data-color="#0d0d1a" onclick="setAccent('#0d0d1a', this)"></div>
            </div>
            <div style="display:flex;gap:10px;">
                <button class="gx-btn gx-btn-primary" onclick="saveGXSettings()">Save</button>
                <button class="gx-btn gx-btn-secondary" onclick="closeGXSettings()">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        const frame = document.getElementById("Frame");
        const urlInput = document.getElementById("url-input");
        const tabsContainer = document.getElementById("gx-tabs");
        const newTabBtn = document.getElementById("new-tab-btn");
        const backBtn = document.getElementById("back-btn");
        const forwardBtn = document.getElementById("forward-btn");
        const refreshBtn = document.getElementById("refresh-btn");
        const goBtn = document.getElementById("go-btn");
        const loadingBar = document.getElementById("loading-bar");
        const statusText = document.getElementById("status-text");
        const statusTabCount = document.getElementById("status-tab-count");
        const favBar = document.getElementById("gx-fav-bar");
        const settingsOverlay = document.getElementById("gx-settings-overlay");
        const bgGrid = document.getElementById("bg-grid");
        const newtabContainer = document.getElementById("newtab-container");

        let tabs = [];
        let activeTabId = null;
        let favorites = JSON.parse(localStorage.getItem('gx_favorites') || '[]');
        let currentEngine = localStorage.getItem('search') || 'https://duckduckgo.com/?q=';
        let gxBg = localStorage.getItem('gx_bg') || '';
        let gxAccent = localStorage.getItem('gx_accent') || '#fa1e4e';

        const BG_OPTIONS = [
            { name: 'Gold GX', file: 'gold-GX.png' },
            { name: 'Red GX', file: 'red-GX.png' },
            { name: 'Blue GX', file: 'blue-GX.png' },
            { name: 'Green GX', file: 'green-GX.png' },
            { name: 'Orange GX', file: 'orange-GX.png' },
            { name: 'Default Dark', file: '' }
        ];

        function applyAccent(color) {
            gxAccent = color;
            document.documentElement.style.setProperty('--gx-accent', color);
            document.documentElement.style.setProperty('--gx-accent2', color + 'cc');
            document.querySelectorAll('.gx-color-option').forEach(el => el.classList.remove('selected'));
            const active = document.querySelector(`.gx-color-option[data-color="${color}"]`);
            if (active) active.classList.add('selected');
        }

        function applyBackground(bgFile) {
            gxBg = bgFile;
            if (bgFile) {
                newtabContainer.style.backgroundImage = `url('/assets/backgrounds/${bgFile}')`;
                newtabContainer.style.backgroundSize = 'cover';
                newtabContainer.style.backgroundPosition = 'center';
            } else {
                newtabContainer.style.backgroundImage = '';
                newtabContainer.style.background = '#0d0d1a';
            }
            renderBgGrid();
        }

        function renderBgGrid() {
            bgGrid.innerHTML = BG_OPTIONS.map(bg => `
                <div class="gx-bg-option ${gxBg === bg.file ? 'selected' : ''}" onclick="applyBackground('${bg.file}')">
                    ${bg.file ? `<img src="/assets/backgrounds/${bg.file}" alt="${bg.name}" onerror="this.style.display='none';this.parentElement.innerHTML='<div style=\\'width:100%;height:100%;background:#1a1a2e;display:flex;align-items:center;justify-content:center;color:#555;\\'>${bg.name}</div>'">` : '<div style="width:100%;height:100%;background:#1a1a2e;display:flex;align-items:center;justify-content:center;color:#555;">Dark</div>'}
                    <div class="bg-label">${bg.name}</div>
                    <div class="selected-check">✓</div>
                </div>
            `).join('');
        }

        function openGXSettings() {
            settingsOverlay.style.display = 'flex';
            renderBgGrid();
            applyAccent(gxAccent);
        }
        function closeGXSettings() { settingsOverlay.style.display = 'none'; }
        function saveGXSettings() {
            localStorage.setItem('gx_bg', gxBg);
            localStorage.setItem('gx_accent', gxAccent);
            closeGXSettings();
        }
        function setAccent(color, el) { applyAccent(color); }

        function toggleFavorites() {
            favBar.style.display = favBar.style.display === 'none' ? 'flex' : 'none';
        }

        function addFavorite() {
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab || !tab.url) return;
            const decoded = decodeUrl(tab.url);
            const name = tab.title || decoded;
            if (!favorites.find(f => f.url === decoded)) {
                favorites.push({ name, url: decoded });
                localStorage.setItem('gx_favorites', JSON.stringify(favorites));
                renderFavorites();
            }
        }

        function removeFavorite(url) {
            favorites = favorites.filter(f => f.url !== url);
            localStorage.setItem('gx_favorites', JSON.stringify(favorites));
            renderFavorites();
        }

        function renderFavorites() {
            const existing = favBar.querySelectorAll('.gx-fav-item');
            existing.forEach(el => el.remove());
            const addBtn = favBar.querySelector('.gx-fav-add');
            favorites.forEach(fav => {
                const el = document.createElement('div');
                el.className = 'gx-fav-item';
                el.innerHTML = `<img src="${getFavicon(fav.url)}" style="width:14px;height:14px;border-radius:3px;" onerror="this.style.display='none'"> <span>${fav.name}</span>`;
                el.title = fav.url;
                el.addEventListener('click', () => handleNavigation(fav.url));
                el.addEventListener('contextmenu', (e) => { e.preventDefault(); removeFavorite(fav.url); });
                favBar.insertBefore(el, addBtn);
            });
        }

        function getFavicon(url) {
            try {
                const host = new URL(url).hostname;
                return `https://www.google.com/s2/favicons?domain=${host}&sz=32`;
            } catch(e) { return ''; }
        }

        function renderSpeedDial() {
            const container = document.getElementById('gx-speeddial');
            const addBtn = container.querySelector('.gx-nt-add-dial');
            const existing = container.querySelectorAll('.gx-nt-dial:not(.gx-nt-add-dial)');
            existing.forEach(el => el.remove());
            
            const dials = JSON.parse(localStorage.getItem('gx_speeddials') || '[]');
            dials.forEach(dial => {
                const el = document.createElement('div');
                el.className = 'gx-nt-dial';
                const faviconUrl = getFavicon(dial.url);
                el.innerHTML = `<img class="gx-nt-dial-icon" src="${faviconUrl}" alt="${dial.name}" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 40 40%22><rect fill=%22%23333%22 width=%2240%22 height=%2240%22 rx=%228%22/><text fill=%22%23888%22 x=%2220%22 y=%2226%22 text-anchor=%22middle%22 font-size=%2216%22>${dial.name[0].toUpperCase()}</text></svg>'"><span class="gx-nt-dial-name">${escapeHtml(dial.name)}</span>`;
                el.title = dial.url;
                el.addEventListener('click', () => handleNavigation(dial.url));
                el.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                    const updated = JSON.parse(localStorage.getItem('gx_speeddials') || '[]').filter(d => d.url !== dial.url);
                    localStorage.setItem('gx_speeddials', JSON.stringify(updated));
                    renderSpeedDial();
                });
                container.insertBefore(el, addBtn);
            });
        }

        function addSpeedDial() {
            const name = prompt('Site name (e.g. YouTube, Discord):');
            if (!name) return;
            let url = prompt('Site URL (e.g. youtube.com):');
            if (!url) return;
            if (!url.startsWith('http')) url = 'https://' + url;
            const dials = JSON.parse(localStorage.getItem('gx_speeddials') || '[]');
            dials.push({ name, url });
            localStorage.setItem('gx_speeddials', JSON.stringify(dials));
            renderSpeedDial();
        }

        class Tab {
            constructor(id, url = '', title = 'New Tab') {
                this.id = id; this.url = url; this.title = title;
                this.history = []; this.historyIndex = -1;
            }
            pushHistory(url) {
                if (this.historyIndex < this.history.length - 1) this.history = this.history.slice(0, this.historyIndex + 1);
                this.history.push(url); this.historyIndex = this.history.length - 1;
            }
            canGoBack() { return this.historyIndex > 0; }
            canGoForward() { return this.historyIndex < this.history.length - 1; }
            goBack() { if (this.canGoBack()) { this.historyIndex--; return this.history[this.historyIndex]; } return null; }
            goForward() { if (this.canGoForward()) { this.historyIndex++; return this.history[this.historyIndex]; } return null; }
        }

        function createTabId() { return 'gx-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5); }

        function addTab(url = '', title = 'New Tab') {
            const id = createTabId();
            const tab = new Tab(id, url, title);
            tabs.push(tab);
            renderTabs();
            switchTab(id);
            if (url) navigateInTab(id, url);
            else showNewTabPage();
            updateTabCount();
            return tab;
        }

        function closeTab(id) {
            if (tabs.length <= 1) return;
            const idx = tabs.findIndex(t => t.id === id);
            if (idx === -1) return;
            tabs.splice(idx, 1);
            if (activeTabId === id) {
                const newIdx = Math.min(idx, tabs.length - 1);
                activeTabId = tabs[newIdx].id;
                updateActiveTab();
            }
            renderTabs();
            updateTabCount();
        }

        function switchTab(id) {
            activeTabId = id;
            updateActiveTab();
            renderTabs();
        }

        function updateActiveTab() {
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) return;
            if (tab.url) {
                showWebPage();
                frame.src = tab.url;
                urlInput.value = decodeUrl(tab.url);
            } else {
                showNewTabPage();
                urlInput.value = '';
            }
            updateNavButtons(tab);
        }

        function showWebPage() {
            frame.style.display = 'block';
            newtabContainer.style.display = 'none';
        }

        function showNewTabPage() {
            frame.style.display = 'none';
            newtabContainer.style.display = 'flex';
            renderSpeedDial();
            document.getElementById('gx-nt-search').value = '';
        }

        function updateNavButtons(tab) {
            backBtn.disabled = !tab || !tab.canGoBack();
            forwardBtn.disabled = !tab || !tab.canGoForward();
        }

        function updateTabCount() {
            statusTabCount.textContent = tabs.length + ' tab' + (tabs.length !== 1 ? 's' : '');
        }

        function navigateInTab(id, rawUrl) {
            const tab = tabs.find(t => t.id === id);
            if (!tab) return;
            showLoading();
            statusText.textContent = 'Loading...';
            const encodedUrl = encodeUrl(rawUrl);
            tab.url = encodedUrl;
            tab.pushHistory(encodedUrl);
            updateTitle(tab, rawUrl);
            if (activeTabId === id) {
                showWebPage();
                frame.src = encodedUrl;
                urlInput.value = rawUrl;
                updateNavButtons(tab);
            }
            renderTabs();
            setTimeout(() => { hideLoading(); statusText.textContent = 'Ready'; }, 800);
        }

        function handleNavigation(query) {
            const url = query.trim();
            if (!url) return;
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) { addTab(url); return; }
            navigateInTab(activeTabId, url);
            urlInput.blur();
        }

        function updateTitle(tab, url) {
            try {
                const p = new URL(url.startsWith('http') ? url : 'https://' + url);
                tab.title = p.hostname.replace('www.', '') || url.substring(0, 30);
            } catch { tab.title = url.substring(0, 30); }
        }

        function encodeUrl(url) {
            if (!url.includes('.') || url.includes(' ')) url = currentEngine + encodeURIComponent(url);
            else if (!url.startsWith('http://') && !url.startsWith('https://')) url = 'https://' + url;
            const proxyType = localStorage.getItem('proxy') || 'ultraviolet';
            return proxyType === 'ultraviolet' ? __uv$config.prefix + __uv$config.encodeUrl(url) : "/scram/service/" + encodeURIComponent(url);
        }

        function decodeUrl(encoded) {
            try {
                if (encoded.includes(__uv$config.prefix)) return __uv$config.decodeUrl(encoded.split(__uv$config.prefix)[1]);
                if (encoded.includes("/scram/service/")) return decodeURIComponent(encoded.split("/scram/service/")[1]);
            } catch(e) {}
            return encoded;
        }

        function renderTabs() {
            const existing = tabsContainer.querySelectorAll('.gx-tab');
            existing.forEach(el => el.remove());
            tabs.forEach(tab => {
                const el = document.createElement('div');
                el.className = 'gx-tab' + (tab.id === activeTabId ? ' active' : '');
                el.innerHTML = `<span class="gx-tab-title">${escapeHtml(tab.title || 'New Tab')}</span>${tabs.length > 1 ? `<button class="gx-tab-close">✕</button>` : ''}`;
                el.querySelector('.gx-tab-title')?.addEventListener('click', () => switchTab(tab.id));
                el.querySelector('.gx-tab-close')?.addEventListener('click', (e) => { e.stopPropagation(); closeTab(tab.id); });
                tabsContainer.insertBefore(el, newTabBtn);
            });
        }

        function showLoading() { loadingBar.style.display = 'block'; loadingBar.style.width = '0%'; setTimeout(() => loadingBar.style.width = '100%', 50); }
        function hideLoading() { loadingBar.style.display = 'none'; loadingBar.style.width = '0%'; }
        function escapeHtml(t) { const d = document.createElement('div'); d.textContent = t; return d.innerHTML; }

        async function init() {
            try {
                const conn = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await conn.getTransport() !== transportPath) await conn.setTransport(transportPath, [{ wisp: wispUrl }]);
            } catch(e) { console.error(e); }
        }

        document.addEventListener("DOMContentLoaded", () => {
            applyAccent(gxAccent);
            applyBackground(gxBg);
            renderFavorites();
            renderSpeedDial();

            const initialUrl = localStorage.getItem("url") || '';
            if (initialUrl) {
                addTab(decodeUrl(initialUrl), 'Loading...');
                const tab = tabs[0];
                if (tab) { tab.url = initialUrl; tab.pushHistory(initialUrl); urlInput.value = decodeUrl(initialUrl); showWebPage(); }
            } else {
                addTab('', 'New Tab');
            }
            updateTabCount();
            init();
        });

        urlInput.addEventListener("keydown", e => { if (e.key === "Enter") handleNavigation(urlInput.value); });
        goBtn.addEventListener("click", () => handleNavigation(urlInput.value));
        backBtn.addEventListener("click", () => {
            const tab = tabs.find(t => t.id === activeTabId);
            if (tab?.canGoBack()) { const u = tab.goBack(); tab.url = u; showWebPage(); frame.src = u; urlInput.value = decodeUrl(u); updateNavButtons(tab); }
        });
        forwardBtn.addEventListener("click", () => {
            const tab = tabs.find(t => t.id === activeTabId);
            if (tab?.canGoForward()) { const u = tab.goForward(); tab.url = u; showWebPage(); frame.src = u; urlInput.value = decodeUrl(u); updateNavButtons(tab); }
        });
        refreshBtn.addEventListener("click", () => { showLoading(); frame.src = frame.src; setTimeout(hideLoading, 600); });
        newTabBtn.addEventListener("click", () => addTab('', 'New Tab'));
        settingsOverlay.addEventListener("click", e => { if (e.target === settingsOverlay) closeGXSettings(); });

        document.addEventListener("keydown", e => {
            if (e.ctrlKey && e.key === 't') { e.preventDefault(); newTabBtn.click(); }
            if (e.ctrlKey && e.key === 'w') { e.preventDefault(); const t = tabs.find(t => t.id === activeTabId); if (t && tabs.length > 1) closeTab(activeTabId); }
            if (e.key === 'F5') { e.preventDefault(); refreshBtn.click(); }
        });
    </script>
</body>
</html>