<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://app.rybbit.io/api/script.js" data-site-id="8b65ec526edf" defer></script>
    <script src="/baremux/index.js"></script>
    <script src="/epoxy/index.mjs" type="module"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>
    <script src="/scram/scramjet.all.js"></script>
    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <title>Silox Proxy - Search</title>
    <style>
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes glowPulse {
            0%, 100% { box-shadow: 0 0 5px rgba(100, 200, 255, 0.2); }
            50% { box-shadow: 0 0 20px rgba(100, 200, 255, 0.5); }
        }

        @keyframes loadingShimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        @keyframes engineWarning {
            0%, 100% { border-color: rgba(255, 150, 50, 0.4); box-shadow: 0 0 15px rgba(255, 150, 50, 0.15); }
            50% { border-color: rgba(255, 150, 50, 0.7); box-shadow: 0 0 25px rgba(255, 150, 50, 0.3); }
        }

        @keyframes enginePulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #0a0e17;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Browser Chrome / Toolbar */
        .browser-chrome {
            background: linear-gradient(180deg, rgba(15, 20, 35, 0.98) 0%, rgba(10, 14, 23, 0.95) 100%);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(100, 200, 255, 0.12);
            z-index: 1000;
            animation: fadeIn 0.5s ease-out;
        }

        .toolbar-row {
            display: flex;
            align-items: center;
            padding: 10px 16px;
            gap: 10px;
        }

        .nav-buttons {
            display: flex;
            gap: 6px;
        }

        .nav-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(20, 25, 40, 0.6);
            color: rgba(255, 255, 255, 0.8);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            transition: all 0.2s ease;
            outline: none;
        }

        .nav-btn:hover {
            background: rgba(40, 50, 80, 0.8);
            border-color: rgba(100, 200, 255, 0.4);
            color: white;
            transform: translateY(-1px);
        }

        .nav-btn:active {
            transform: scale(0.94);
        }

        .nav-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            transform: none;
        }

        .nav-btn:disabled:hover {
            background: rgba(20, 25, 40, 0.6);
            border-color: rgba(255, 255, 255, 0.1);
            transform: none;
        }

        .nav-btn svg {
            width: 16px;
            height: 16px;
            fill: currentColor;
        }

        .home-btn {
            background: linear-gradient(135deg, rgba(74, 144, 217, 0.3), rgba(108, 92, 231, 0.3));
            border-color: rgba(100, 200, 255, 0.25);
        }

        .home-btn:hover {
            background: linear-gradient(135deg, rgba(74, 144, 217, 0.5), rgba(108, 92, 231, 0.5));
        }

        .settings-btn {
            margin-left: auto;
            background: rgba(20, 25, 40, 0.6);
        }

        .engine-indicator {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 20px;
            background: rgba(20, 25, 40, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 11px;
            color: rgba(255, 255, 255, 0.5);
            margin-left: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .engine-indicator:hover {
            background: rgba(30, 40, 70, 0.7);
            color: rgba(255, 255, 255, 0.8);
        }

        .engine-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #de5833;
            flex-shrink: 0;
        }

        /* Tabs */
        .tabs-row {
            display: flex;
            align-items: center;
            padding: 0 16px 6px 16px;
            gap: 4px;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(100, 200, 255, 0.3) transparent;
        }

        .tabs-row::-webkit-scrollbar {
            height: 3px;
        }

        .tabs-row::-webkit-scrollbar-track {
            background: transparent;
        }

        .tabs-row::-webkit-scrollbar-thumb {
            background: rgba(100, 200, 255, 0.3);
            border-radius: 10px;
        }

        .tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 12px 12px 0 0;
            background: rgba(20, 25, 40, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-bottom: none;
            color: rgba(255, 255, 255, 0.6);
            cursor: pointer;
            white-space: nowrap;
            font-size: 13px;
            transition: all 0.2s ease;
            min-width: 100px;
            max-width: 200px;
            user-select: none;
            position: relative;
        }

        .tab:hover {
            background: rgba(30, 40, 70, 0.7);
            color: rgba(255, 255, 255, 0.9);
        }

        .tab.active {
            background: rgba(25, 35, 60, 0.9);
            color: white;
            border-color: rgba(100, 200, 255, 0.3);
            box-shadow: 0 -2px 15px rgba(100, 200, 255, 0.08);
        }

        .tab-icon {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: rgba(100, 200, 255, 0.25);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
        }

        .tab-title {
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 130px;
        }

        .tab-close {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: rgba(255, 255, 255, 0.35);
            cursor: pointer;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        .tab-close:hover {
            background: rgba(255, 60, 60, 0.3);
            color: white;
        }

        .new-tab-btn {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            border: 1px dashed rgba(255, 255, 255, 0.2);
            background: transparent;
            color: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            flex-shrink: 0;
            margin-bottom: 4px;
        }

        .new-tab-btn:hover {
            border-color: rgba(100, 200, 255, 0.5);
            color: rgba(100, 200, 255, 0.8);
            background: rgba(100, 200, 255, 0.1);
        }

        /* URL Bar */
        .url-bar-container {
            display: flex;
            align-items: center;
            padding: 6px 16px 12px 16px;
            gap: 10px;
        }

        .url-bar {
            flex: 1;
            display: flex;
            align-items: center;
            background: rgba(20, 25, 40, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 25px;
            padding: 10px 18px;
            transition: all 0.3s ease;
            gap: 10px;
        }

        .url-bar:focus-within {
            border-color: rgba(100, 200, 255, 0.4);
            box-shadow: 0 0 25px rgba(100, 200, 255, 0.1);
            background: rgba(25, 30, 50, 0.85);
        }

        .url-icon {
            color: rgba(100, 200, 255, 0.6);
            font-size: 14px;
            flex-shrink: 0;
        }

        .url-input {
            flex: 1;
            background: transparent;
            border: none;
            color: white;
            outline: none;
            font-size: 14px;
            font-family: inherit;
        }

        .url-input::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }

        .go-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #4a90d9, #6c5ce7);
            color: white;
            cursor: pointer;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            flex-shrink: 0;
            box-shadow: 0 4px 15px rgba(74, 144, 217, 0.3);
        }

        .go-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(74, 144, 217, 0.5);
        }

        .go-btn:active {
            transform: scale(0.93);
        }

        /* Iframe */
        .iframe-container {
            flex: 1;
            position: relative;
            background: #0a0e17;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: none;
            animation: fadeIn 0.4s ease-out;
        }

        /* Loading indicator */
        .loading-indicator {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #4a90d9, #6c5ce7, #a78bfa, transparent);
            background-size: 200% 100%;
            animation: loadingShimmer 1.2s ease-in-out infinite;
            display: none;
            z-index: 10;
        }

        /* Engine Warning Modal */
        .engine-warning-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.75);
            z-index: 5000;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(5px);
            animation: fadeIn 0.3s ease-out;
        }

        .engine-warning-box {
            background: rgba(15, 20, 35, 0.98);
            border: 1px solid rgba(255, 150, 50, 0.5);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            max-width: 440px;
            width: 90%;
            animation: engineWarning 2s ease-in-out infinite, slideUp 0.4s ease-out;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
        }

        .engine-warning-box .warning-icon {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .engine-warning-box h2 {
            font-size: 1.4rem;
            color: #ffa040;
            margin-bottom: 10px;
        }

        .engine-warning-box p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .engine-warning-box .engine-options {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .engine-warning-box .switch-btn {
            width: 100%;
            padding: 14px 20px;
            border-radius: 25px;
            border: none;
            cursor: pointer;
            font-size: 1em;
            font-weight: 600;
            transition: all 0.3s ease;
            animation: enginePulse 2s ease-in-out infinite;
        }

        .switch-btn.duckduckgo {
            background: linear-gradient(135deg, #de5833, #e67330);
            color: white;
            box-shadow: 0 4px 20px rgba(222, 88, 51, 0.4);
        }

        .switch-btn.duckduckgo:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 30px rgba(222, 88, 51, 0.6);
        }

        .switch-btn.brave {
            background: linear-gradient(135deg, #fb542b, #ff2000);
            color: white;
            box-shadow: 0 4px 20px rgba(251, 84, 43, 0.4);
        }

        .switch-btn.brave:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 30px rgba(251, 84, 43, 0.6);
        }

        .engine-warning-box .ignore-link {
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.8rem;
            cursor: pointer;
            margin-top: 12px;
            text-decoration: underline;
            transition: color 0.2s;
        }

        .engine-warning-box .ignore-link:hover {
            color: rgba(255, 255, 255, 0.7);
        }

        /* Status bar */
        .status-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 4px 16px;
            background: rgba(10, 14, 23, 0.9);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 11px;
            color: rgba(255, 255, 255, 0.4);
            gap: 15px;
        }

        .status-bar .status-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .status-bar .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #4ade80;
            flex-shrink: 0;
        }

        @media (max-width: 600px) {
            .toolbar-row {
                padding: 8px 10px;
                gap: 6px;
            }
            .nav-btn {
                width: 30px;
                height: 30px;
                font-size: 13px;
            }
            .tab {
                padding: 8px 12px;
                font-size: 11px;
                min-width: 70px;
                max-width: 140px;
            }
            .url-bar {
                padding: 8px 14px;
            }
            .url-input {
                font-size: 13px;
            }
            .engine-indicator {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="browser-chrome">
        <div class="toolbar-row">
            <div class="nav-buttons">
                <button class="nav-btn" id="back-btn" title="Go Back (Alt+Left)" disabled>
                    <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
                </button>
                <button class="nav-btn" id="forward-btn" title="Go Forward (Alt+Right)" disabled>
                    <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
                </button>
                <button class="nav-btn" id="refresh-btn" title="Refresh (F5)">
                    <svg viewBox="0 0 24 24"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
                </button>
                <button class="nav-btn home-btn" id="home-btn" title="Home">⌂</button>
            </div>
            <div class="engine-indicator" id="engine-indicator" title="Current Search Engine">
                <span class="engine-dot"></span>
                <span id="engine-name">DuckDuckGo</span>
            </div>
            <button class="nav-btn settings-btn" id="settings-btn" title="Settings">⚙</button>
        </div>
        <div class="tabs-row" id="tabs-row">
            <button class="new-tab-btn" id="new-tab-btn" title="New Tab (Ctrl+T)">+</button>
        </div>
        <div class="url-bar-container">
            <div class="url-bar">
                <span class="url-icon">🔒</span>
                <input type="text" class="url-input" id="url-input" placeholder="Search with DuckDuckGo or enter URL...">
            </div>
            <button class="go-btn" id="go-btn">➜</button>
        </div>
    </div>
    <div class="iframe-container">
        <div class="loading-indicator" id="loading-bar"></div>
        <iframe id="Frame" src=""></iframe>
    </div>
    <div class="status-bar">
        <div class="status-left">
            <span class="status-dot"></span>
            <span id="status-text">Ready</span>
        </div>
        <span id="status-tab-count">1 tab</span>
    </div>

    <!-- Google Search Engine Warning -->
    <div class="engine-warning-overlay" id="engine-warning" style="display: none;">
        <div class="engine-warning-box">
            <div class="warning-icon">⚠️</div>
            <h2>Google Search Blocked</h2>
            <p>
                Google's search detects proxies and will repeatedly ask you to verify "you're not a robot."
                This gets very annoying and breaks the browsing experience.
            </p>
            <p style="font-size: 0.85rem; color: rgba(255, 200, 120, 0.9);">
                <strong>Switch to DuckDuckGo or Brave Search instead — they work perfectly through the proxy!</strong>
            </p>
            <div class="engine-options">
                <button class="switch-btn duckduckgo" onclick="switchEngine('duckduckgo')">
                    🦆 Switch to DuckDuckGo (Recommended)
                </button>
                <button class="switch-btn brave" onclick="switchEngine('brave')">
                    🛡️ Switch to Brave Search
                </button>
            </div>
            <span class="ignore-link" onclick="ignoreWarning()">I understand, continue with Google anyway</span>
        </div>
    </div>

    <script>
        const frame = document.getElementById("Frame");
        const urlInput = document.getElementById("url-input");
        const tabsRow = document.getElementById("tabs-row");
        const newTabBtn = document.getElementById("new-tab-btn");
        const backBtn = document.getElementById("back-btn");
        const forwardBtn = document.getElementById("forward-btn");
        const refreshBtn = document.getElementById("refresh-btn");
        const homeBtn = document.getElementById("home-btn");
        const settingsBtn = document.getElementById("settings-btn");
        const goBtn = document.getElementById("go-btn");
        const loadingBar = document.getElementById("loading-bar");
        const engineWarning = document.getElementById("engine-warning");
        const engineIndicator = document.getElementById("engine-indicator");
        const engineName = document.getElementById("engine-name");
        const statusText = document.getElementById("status-text");
        const statusTabCount = document.getElementById("status-tab-count");

        let tabs = [];
        let activeTabId = null;
        let currentEngine = localStorage.getItem('search') || 'https://duckduckgo.com/?q=';
        let warningIgnored = localStorage.getItem('googleWarningIgnored') === 'true';

        const SEARCH_ENGINES = {
            'google': 'https://www.google.com/search?q=',
            'duckduckgo': 'https://duckduckgo.com/?q=',
            'brave': 'https://search.brave.com/search?q=',
            'bing': 'https://www.bing.com/search?q='
        };

        function getEngineName(url) {
            if (url.includes('duckduckgo.com')) return 'DuckDuckGo';
            if (url.includes('search.brave.com')) return 'Brave';
            if (url.includes('google.com/search')) return 'Google';
            if (url.includes('bing.com/search')) return 'Bing';
            return 'Custom';
        }

        function updateEngineDisplay() {
            const name = getEngineName(currentEngine);
            engineName.textContent = name;
            const dot = engineIndicator.querySelector('.engine-dot');
            if (name === 'DuckDuckGo') dot.style.background = '#de5833';
            else if (name === 'Brave') dot.style.background = '#fb542b';
            else if (name === 'Google') dot.style.background = '#4285f4';
            else dot.style.background = '#888';
        }

        function switchEngine(engine) {
            currentEngine = SEARCH_ENGINES[engine] || SEARCH_ENGINES['duckduckgo'];
            localStorage.setItem('search', currentEngine);
            updateEngineDisplay();
            engineWarning.style.display = 'none';
            statusText.textContent = 'Search engine switched to ' + getEngineName(currentEngine);
            setTimeout(() => { statusText.textContent = 'Ready'; }, 2000);
        }

        function ignoreWarning() {
            localStorage.setItem('googleWarningIgnored', 'true');
            warningIgnored = true;
            engineWarning.style.display = 'none';
        }

        function showGoogleWarning() {
            if (!warningIgnored) {
                engineWarning.style.display = 'flex';
            }
        }

        function isGoogleUrl(url) {
            return url.includes('google.com/search') || url.includes('google.com/url');
        }

        class Tab {
            constructor(id, url = '', title = 'New Tab') {
                this.id = id;
                this.url = url;
                this.title = title;
                this.history = [];
                this.historyIndex = -1;
            }

            pushHistory(url) {
                if (this.historyIndex < this.history.length - 1) {
                    this.history = this.history.slice(0, this.historyIndex + 1);
                }
                this.history.push(url);
                this.historyIndex = this.history.length - 1;
            }

            canGoBack() {
                return this.historyIndex > 0;
            }

            canGoForward() {
                return this.historyIndex < this.history.length - 1;
            }

            goBack() {
                if (this.canGoBack()) {
                    this.historyIndex--;
                    return this.history[this.historyIndex];
                }
                return null;
            }

            goForward() {
                if (this.canGoForward()) {
                    this.historyIndex++;
                    return this.history[this.historyIndex];
                }
                return null;
            }
        }

        function createTabId() {
            return 'tab-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5);
        }

        function addTab(url = '', title = 'New Tab') {
            const id = createTabId();
            const tab = new Tab(id, url, title);
            tabs.push(tab);
            renderTabs();
            switchTab(id);
            if (url) {
                navigateInTab(id, url);
            }
            updateTabCount();
            return tab;
        }

        function closeTab(id) {
            if (tabs.length <= 1) return;
            const index = tabs.findIndex(t => t.id === id);
            if (index === -1) return;
            
            tabs.splice(index, 1);
            
            if (activeTabId === id) {
                const newIndex = Math.min(index, tabs.length - 1);
                activeTabId = tabs[newIndex].id;
            }
            
            renderTabs();
            updateActiveTab();
            updateTabCount();
        }

        function switchTab(id) {
            activeTabId = id;
            updateActiveTab();
            renderTabs();
        }

        function updateActiveTab() {
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) return;

            if (tab.url) {
                frame.src = tab.url;
                urlInput.value = decodeUrl(tab.url);
                
                if (isGoogleUrl(decodeUrl(tab.url))) {
                    showGoogleWarning();
                }
            } else {
                frame.src = '';
                urlInput.value = '';
            }

            updateNavButtons(tab);
        }

        function updateNavButtons(tab) {
            backBtn.disabled = !tab || !tab.canGoBack();
            forwardBtn.disabled = !tab || !tab.canGoForward();
        }

        function updateTabCount() {
            statusTabCount.textContent = tabs.length + ' tab' + (tabs.length !== 1 ? 's' : '');
        }

        function navigateInTab(id, rawUrl) {
            const tab = tabs.find(t => t.id === id);
            if (!tab) return;

            showLoading();
            statusText.textContent = 'Loading...';

            const encodedUrl = encodeUrl(rawUrl);
            tab.url = encodedUrl;
            tab.pushHistory(encodedUrl);
            
            updateTitle(tab, rawUrl);

            if (activeTabId === id) {
                frame.src = encodedUrl;
                urlInput.value = rawUrl;
                updateNavButtons(tab);
                
                if (isGoogleUrl(rawUrl)) {
                    showGoogleWarning();
                }
            }
            
            renderTabs();
            setTimeout(() => {
                hideLoading();
                statusText.textContent = 'Ready';
            }, 800);
        }

        function updateTitle(tab, url) {
            try {
                const parsed = new URL(url.startsWith('http') ? url : 'https://' + url);
                let host = parsed.hostname.replace('www.', '');
                tab.title = host || url.substring(0, 35);
            } catch {
                tab.title = url.substring(0, 35);
            }
        }

        function encodeUrl(url) {
            // Check if it's a search query
            if (!url.includes('.') || url.includes(' ')) {
                url = currentEngine + encodeURIComponent(url);
            } else if (!url.startsWith('http://') && !url.startsWith('https://')) {
                url = 'https://' + url;
            }

            const proxyType = localStorage.getItem('proxy') || 'ultraviolet';
            if (proxyType === 'ultraviolet') {
                return __uv$config.prefix + __uv$config.encodeUrl(url);
            } else {
                return "/scram/service/" + encodeURIComponent(url);
            }
        }

        function decodeUrl(encoded) {
            try {
                if (encoded.includes(__uv$config.prefix)) {
                    return __uv$config.decodeUrl(encoded.split(__uv$config.prefix)[1]);
                } else if (encoded.includes("/scram/service/")) {
                    return decodeURIComponent(encoded.split("/scram/service/")[1]);
                }
            } catch (e) {
                return encoded;
            }
            return encoded;
        }

        function renderTabs() {
            const existingButtons = tabsRow.querySelectorAll('.tab');
            existingButtons.forEach(b => b.remove());

            tabs.forEach(tab => {
                const tabEl = document.createElement('div');
                tabEl.className = 'tab' + (tab.id === activeTabId ? ' active' : '');
                tabEl.dataset.tabId = tab.id;
                tabEl.innerHTML = `
                    <span class="tab-icon">●</span>
                    <span class="tab-title">${escapeHtml(tab.title || 'New Tab')}</span>
                    ${tabs.length > 1 ? `<button class="tab-close" data-close="${tab.id}">✕</button>` : ''}
                `;
                
                tabEl.addEventListener('click', (e) => {
                    if (!e.target.classList.contains('tab-close')) {
                        switchTab(tab.id);
                    }
                });

                tabsRow.insertBefore(tabEl, newTabBtn);
            });

            document.querySelectorAll('.tab-close').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeTab(btn.dataset.close);
                });
            });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        async function handleNavigation(query) {
            const url = query.trim();
            if (!url) return;

            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) {
                addTab(url);
                return;
            }
            
            navigateInTab(activeTabId, url);
            urlInput.blur();
        }

        function showLoading() {
            loadingBar.style.display = 'block';
        }

        function hideLoading() {
            loadingBar.style.display = 'none';
        }

        async function init() {
            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {
                console.error(err);
            }
        }

        // Event Listeners
        document.addEventListener("DOMContentLoaded", () => {
            updateEngineDisplay();
            
            const initialUrl = localStorage.getItem("url") || '';
            if (initialUrl) {
                addTab(decodeUrl(initialUrl), 'Loading...');
                frame.src = initialUrl;
                const tab = tabs[0];
                if (tab) {
                    tab.url = initialUrl;
                    tab.pushHistory(initialUrl);
                    urlInput.value = decodeUrl(initialUrl);
                }
            } else {
                addTab('', 'DuckDuckGo');
                const duckUrl = 'https://duckduckgo.com/';
                navigateInTab(tabs[0].id, duckUrl);
            }
            
            updateTabCount();
            init();
        });

        urlInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") handleNavigation(urlInput.value);
        });

        goBtn.addEventListener("click", () => handleNavigation(urlInput.value));

        backBtn.addEventListener("click", () => {
            const tab = tabs.find(t => t.id === activeTabId);
            if (tab && tab.canGoBack()) {
                const prevUrl = tab.goBack();
                tab.url = prevUrl;
                frame.src = prevUrl;
                urlInput.value = decodeUrl(prevUrl);
                updateNavButtons(tab);
            }
        });

        forwardBtn.addEventListener("click", () => {
            const tab = tabs.find(t => t.id === activeTabId);
            if (tab && tab.canGoForward()) {
                const nextUrl = tab.goForward();
                tab.url = nextUrl;
                frame.src = nextUrl;
                urlInput.value = decodeUrl(nextUrl);
                updateNavButtons(tab);
            }
        });

        refreshBtn.addEventListener("click", () => {
            showLoading();
            statusText.textContent = 'Refreshing...';
            frame.src = frame.src;
            setTimeout(() => {
                hideLoading();
                statusText.textContent = 'Ready';
            }, 800);
        });

        homeBtn.addEventListener("click", () => {
            window.location.href = '/';
        });

        settingsBtn.addEventListener("click", () => {
            const url = window.location.origin + '/settings';
            handleNavigation(url);
        });

        newTabBtn.addEventListener("click", () => {
            const tab = addTab('', 'New Tab');
            const duckUrl = 'https://duckduckgo.com/';
            navigateInTab(tab.id, duckUrl);
        });

        engineIndicator.addEventListener("click", () => {
            const engines = ['DuckDuckGo', 'Brave', 'Google', 'Bing'];
            const currentName = getEngineName(currentEngine);
            const nextIndex = (engines.indexOf(currentName) + 1) % engines.length;
            const nextEngine = engines[nextIndex].toLowerCase();
            switchEngine(nextEngine);
        });

        frame.addEventListener("load", () => {
            hideLoading();
            statusText.textContent = 'Ready';
        });

        // Keyboard shortcuts
        document.addEventListener("keydown", (e) => {
            if (e.ctrlKey && e.key === 't') {
                e.preventDefault();
                newTabBtn.click();
            }
            if (e.ctrlKey && e.key === 'w') {
                e.preventDefault();
                const activeTab = tabs.find(t => t.id === activeTabId);
                if (activeTab && tabs.length > 1) {
                    closeTab(activeTabId);
                }
            }
            if (e.key === 'F5') {
                e.preventDefault();
                refreshBtn.click();
            }
            if (e.altKey && e.key === 'ArrowLeft') {
                e.preventDefault();
                backBtn.click();
            }
            if (e.altKey && e.key === 'ArrowRight') {
                e.preventDefault();
                forwardBtn.click();
            }
        });
    </script>
</body>
</html>