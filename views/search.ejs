<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://app.rybbit.io/api/script.js" data-site-id="8b65ec526edf" defer></script>
    <script src="/baremux/index.js"></script>
    <script src="/epoxy/index.mjs" type="module"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>
    <script src="/scram/scramjet.all.js"></script>
    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <title>Silox Proxy</title>
    <style>
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes glowPulse {
            0%, 100% { box-shadow: 0 0 5px rgba(100, 200, 255, 0.2); }
            50% { box-shadow: 0 0 15px rgba(100, 200, 255, 0.4); }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #0a0e17;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Browser Chrome / Toolbar */
        .browser-chrome {
            background: linear-gradient(180deg, rgba(15, 20, 35, 0.98) 0%, rgba(10, 14, 23, 0.95) 100%);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(100, 200, 255, 0.15);
            z-index: 1000;
            animation: fadeIn 0.5s ease-out;
        }

        .toolbar-row {
            display: flex;
            align-items: center;
            padding: 8px 12px;
            gap: 8px;
        }

        .nav-buttons {
            display: flex;
            gap: 4px;
        }

        .nav-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(20, 25, 40, 0.6);
            color: rgba(255, 255, 255, 0.8);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            transition: all 0.2s ease;
            outline: none;
        }

        .nav-btn:hover {
            background: rgba(40, 50, 80, 0.8);
            border-color: rgba(100, 200, 255, 0.4);
            color: white;
        }

        .nav-btn:active {
            transform: scale(0.95);
        }

        .nav-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .nav-btn:disabled:hover {
            background: rgba(20, 25, 40, 0.6);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .home-btn {
            background: linear-gradient(135deg, rgba(74, 144, 217, 0.3), rgba(108, 92, 231, 0.3));
            border-color: rgba(100, 200, 255, 0.25);
            font-size: 16px;
        }

        .home-btn:hover {
            background: linear-gradient(135deg, rgba(74, 144, 217, 0.5), rgba(108, 92, 231, 0.5));
        }

        .settings-btn {
            margin-left: auto;
            background: rgba(20, 25, 40, 0.6);
            font-size: 16px;
        }

        /* Tabs */
        .tabs-row {
            display: flex;
            align-items: center;
            padding: 0 12px 4px 12px;
            gap: 4px;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(100, 200, 255, 0.3) transparent;
        }

        .tabs-row::-webkit-scrollbar {
            height: 3px;
        }

        .tabs-row::-webkit-scrollbar-track {
            background: transparent;
        }

        .tabs-row::-webkit-scrollbar-thumb {
            background: rgba(100, 200, 255, 0.3);
            border-radius: 10px;
        }

        .tab {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 10px 10px 0 0;
            background: rgba(20, 25, 40, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-bottom: none;
            color: rgba(255, 255, 255, 0.6);
            cursor: pointer;
            white-space: nowrap;
            font-size: 12px;
            transition: all 0.2s ease;
            min-width: 80px;
            max-width: 180px;
            user-select: none;
            position: relative;
        }

        .tab:hover {
            background: rgba(30, 40, 70, 0.7);
            color: rgba(255, 255, 255, 0.9);
        }

        .tab.active {
            background: rgba(25, 35, 60, 0.9);
            color: white;
            border-color: rgba(100, 200, 255, 0.3);
            box-shadow: 0 -2px 10px rgba(100, 200, 255, 0.1);
        }

        .tab-icon {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: rgba(100, 200, 255, 0.3);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 8px;
        }

        .tab-title {
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100px;
        }

        .tab-close {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: rgba(255, 255, 255, 0.4);
            cursor: pointer;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        .tab-close:hover {
            background: rgba(255, 60, 60, 0.3);
            color: white;
        }

        .new-tab-btn {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            border: 1px dashed rgba(255, 255, 255, 0.2);
            background: transparent;
            color: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            flex-shrink: 0;
            margin-bottom: 4px;
        }

        .new-tab-btn:hover {
            border-color: rgba(100, 200, 255, 0.5);
            color: rgba(100, 200, 255, 0.8);
            background: rgba(100, 200, 255, 0.1);
        }

        /* URL Bar */
        .url-bar-container {
            display: flex;
            align-items: center;
            padding: 4px 12px 8px 12px;
            gap: 8px;
        }

        .url-bar {
            flex: 1;
            display: flex;
            align-items: center;
            background: rgba(20, 25, 40, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 25px;
            padding: 8px 16px;
            transition: all 0.3s ease;
        }

        .url-bar:focus-within {
            border-color: rgba(100, 200, 255, 0.4);
            box-shadow: 0 0 20px rgba(100, 200, 255, 0.1);
            background: rgba(25, 30, 50, 0.8);
        }

        .url-icon {
            color: rgba(100, 200, 255, 0.6);
            margin-right: 10px;
            font-size: 14px;
            flex-shrink: 0;
        }

        .url-input {
            flex: 1;
            background: transparent;
            border: none;
            color: white;
            outline: none;
            font-size: 13px;
            font-family: inherit;
        }

        .url-input::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }

        .go-btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #4a90d9, #6c5ce7);
            color: white;
            cursor: pointer;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        .go-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 15px rgba(74, 144, 217, 0.5);
        }

        .go-btn:active {
            transform: scale(0.95);
        }

        /* Iframe */
        .iframe-container {
            flex: 1;
            position: relative;
            background: #0a0e17;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: none;
            animation: fadeIn 0.3s ease-out;
        }

        /* Loading indicator */
        .loading-indicator {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #4a90d9, #6c5ce7, transparent);
            background-size: 200% 100%;
            animation: loadingShimmer 1.5s ease-in-out infinite;
            display: none;
            z-index: 10;
        }

        @keyframes loadingShimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        /* Responsive */
        @media (max-width: 600px) {
            .toolbar-row {
                padding: 6px 8px;
                gap: 4px;
            }
            .nav-btn {
                width: 28px;
                height: 28px;
                font-size: 12px;
            }
            .tab {
                padding: 6px 10px;
                font-size: 11px;
                min-width: 60px;
                max-width: 120px;
            }
            .url-bar {
                padding: 6px 12px;
            }
        }
    </style>
</head>
<body>
    <div class="browser-chrome">
        <div class="toolbar-row">
            <div class="nav-buttons">
                <button class="nav-btn" id="back-btn" title="Go Back" disabled>◀</button>
                <button class="nav-btn" id="forward-btn" title="Go Forward" disabled>▶</button>
                <button class="nav-btn" id="refresh-btn" title="Refresh">⟳</button>
                <button class="nav-btn home-btn" id="home-btn" title="Home">⌂</button>
            </div>
            <button class="nav-btn settings-btn" id="settings-btn" title="Settings">⚙</button>
        </div>
        <div class="tabs-row" id="tabs-row">
            <!-- Tabs injected by JS -->
            <button class="new-tab-btn" id="new-tab-btn" title="New Tab">+</button>
        </div>
        <div class="url-bar-container">
            <div class="url-bar">
                <span class="url-icon">🔒</span>
                <input type="text" class="url-input" id="url-input" placeholder="Search or enter URL...">
            </div>
            <button class="go-btn" id="go-btn">➜</button>
        </div>
    </div>
    <div class="iframe-container">
        <div class="loading-indicator" id="loading-bar"></div>
        <iframe id="Frame" src=""></iframe>
    </div>

    <script>
        const frame = document.getElementById("Frame");
        const urlInput = document.getElementById("url-input");
        const tabsRow = document.getElementById("tabs-row");
        const newTabBtn = document.getElementById("new-tab-btn");
        const backBtn = document.getElementById("back-btn");
        const forwardBtn = document.getElementById("forward-btn");
        const refreshBtn = document.getElementById("refresh-btn");
        const homeBtn = document.getElementById("home-btn");
        const settingsBtn = document.getElementById("settings-btn");
        const goBtn = document.getElementById("go-btn");
        const loadingBar = document.getElementById("loading-bar");

        let tabs = [];
        let activeTabId = null;

        class Tab {
            constructor(id, url = '', title = 'New Tab') {
                this.id = id;
                this.url = url;
                this.title = title;
                this.history = [];
                this.historyIndex = -1;
            }

            pushHistory(url) {
                if (this.historyIndex < this.history.length - 1) {
                    this.history = this.history.slice(0, this.historyIndex + 1);
                }
                this.history.push(url);
                this.historyIndex = this.history.length - 1;
            }

            canGoBack() {
                return this.historyIndex > 0;
            }

            canGoForward() {
                return this.historyIndex < this.history.length - 1;
            }

            goBack() {
                if (this.canGoBack()) {
                    this.historyIndex--;
                    return this.history[this.historyIndex];
                }
                return null;
            }

            goForward() {
                if (this.canGoForward()) {
                    this.historyIndex++;
                    return this.history[this.historyIndex];
                }
                return null;
            }
        }

        function createTabId() {
            return 'tab-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5);
        }

        function addTab(url = '', title = 'New Tab') {
            const id = createTabId();
            const tab = new Tab(id, url, title);
            tabs.push(tab);
            renderTabs();
            switchTab(id);
            if (url) {
                navigateInTab(id, url);
            }
            return tab;
        }

        function closeTab(id) {
            if (tabs.length <= 1) return;
            const index = tabs.findIndex(t => t.id === id);
            if (index === -1) return;
            
            tabs.splice(index, 1);
            
            if (activeTabId === id) {
                const newIndex = Math.min(index, tabs.length - 1);
                activeTabId = tabs[newIndex].id;
            }
            
            renderTabs();
            updateActiveTab();
        }

        function switchTab(id) {
            activeTabId = id;
            updateActiveTab();
            renderTabs();
        }

        function updateActiveTab() {
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) return;

            if (tab.url) {
                frame.src = tab.url;
                urlInput.value = decodeUrl(tab.url);
            } else {
                frame.src = '';
                urlInput.value = '';
            }

            updateNavButtons(tab);
        }

        function updateNavButtons(tab) {
            backBtn.disabled = !tab || !tab.canGoBack();
            forwardBtn.disabled = !tab || !tab.canGoForward();
        }

        function navigateInTab(id, url) {
            const tab = tabs.find(t => t.id === id);
            if (!tab) return;

            const encodedUrl = encodeUrl(url);
            tab.url = encodedUrl;
            tab.pushHistory(encodedUrl);
            
            updateTitle(tab, url);

            if (activeTabId === id) {
                frame.src = encodedUrl;
                urlInput.value = url;
                updateNavButtons(tab);
            }
            
            renderTabs();
        }

        function updateTitle(tab, url) {
            try {
                const parsed = new URL(url);
                let host = parsed.hostname.replace('www.', '');
                tab.title = host || url.substring(0, 30);
            } catch {
                tab.title = url.substring(0, 30);
            }
        }

        function encodeUrl(url) {
            if (!url.includes('.') || url.includes(' ')) {
                url = (localStorage.getItem('search') || 'https://www.google.com/search?q=') + encodeURIComponent(url);
            } else if (!url.startsWith('http')) {
                url = 'https://' + url;
            }

            const proxyType = localStorage.getItem('proxy') || 'ultraviolet';
            if (proxyType === 'ultraviolet') {
                return __uv$config.prefix + __uv$config.encodeUrl(url);
            } else {
                return "/scram/service/" + encodeURIComponent(url);
            }
        }

        function decodeUrl(encoded) {
            try {
                if (encoded.includes(__uv$config.prefix)) {
                    return __uv$config.decodeUrl(encoded.split(__uv$config.prefix)[1]);
                } else if (encoded.includes("/scram/service/")) {
                    return decodeURIComponent(encoded.split("/scram/service/")[1]);
                }
            } catch (e) {
                return encoded;
            }
            return encoded;
        }

        function renderTabs() {
            const existingButtons = tabsRow.querySelectorAll('.tab');
            existingButtons.forEach(b => b.remove());

            tabs.forEach(tab => {
                const tabEl = document.createElement('div');
                tabEl.className = 'tab' + (tab.id === activeTabId ? ' active' : '');
                tabEl.dataset.tabId = tab.id;
                tabEl.innerHTML = `
                    <span class="tab-icon">●</span>
                    <span class="tab-title">${escapeHtml(tab.title || 'New Tab')}</span>
                    <button class="tab-close" data-close="${tab.id}">✕</button>
                `;
                
                tabEl.addEventListener('click', (e) => {
                    if (!e.target.classList.contains('tab-close')) {
                        switchTab(tab.id);
                    }
                });

                tabsRow.insertBefore(tabEl, newTabBtn);
            });

            document.querySelectorAll('.tab-close').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeTab(btn.dataset.close);
                });
            });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        async function handleNavigation(query) {
            const url = query.trim();
            if (!url) return;

            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) {
                addTab(url);
                return;
            }
            
            showLoading();
            navigateInTab(activeTabId, url);
            urlInput.blur();
            setTimeout(hideLoading, 800);
        }

        function showLoading() {
            loadingBar.style.display = 'block';
        }

        function hideLoading() {
            loadingBar.style.display = 'none';
        }

        async function init() {
            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {
                console.error(err);
            }
        }

        // Event Listeners
        document.addEventListener("DOMContentLoaded", () => {
            const initialUrl = localStorage.getItem("url") || '';
            addTab(initialUrl ? decodeUrl(initialUrl) : '', 'Home');
            
            if (initialUrl) {
                frame.src = initialUrl;
                const tab = tabs[0];
                tab.url = initialUrl;
                tab.pushHistory(initialUrl);
                urlInput.value = decodeUrl(initialUrl);
            }
            
            init();
        });

        urlInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") handleNavigation(urlInput.value);
        });

        goBtn.addEventListener("click", () => handleNavigation(urlInput.value));

        backBtn.addEventListener("click", () => {
            const tab = tabs.find(t => t.id === activeTabId);
            if (tab && tab.canGoBack()) {
                const prevUrl = tab.goBack();
                tab.url = prevUrl;
                frame.src = prevUrl;
                urlInput.value = decodeUrl(prevUrl);
                updateNavButtons(tab);
            }
        });

        forwardBtn.addEventListener("click", () => {
            const tab = tabs.find(t => t.id === activeTabId);
            if (tab && tab.canGoForward()) {
                const nextUrl = tab.goForward();
                tab.url = nextUrl;
                frame.src = nextUrl;
                urlInput.value = decodeUrl(nextUrl);
                updateNavButtons(tab);
            }
        });

        refreshBtn.addEventListener("click", () => {
            showLoading();
            frame.src = frame.src;
            setTimeout(hideLoading, 800);
        });

        homeBtn.addEventListener("click", () => {
            const tab = tabs.find(t => t.id === activeTabId);
            if (tab) {
                frame.src = '';
                tab.url = '';
                urlInput.value = '';
                window.location.href = '/';
            }
        });

        settingsBtn.addEventListener("click", () => {
            const url = window.location.origin + '/settings';
            handleNavigation(url);
        });

        newTabBtn.addEventListener("click", () => {
            addTab('', 'New Tab');
        });

        frame.addEventListener("load", () => {
            hideLoading();
        });
    </script>
</body>
</html>