<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>SILOX Browser</title>
<script src="/baremux/index.js"></script>
<script src="/epoxy/index.mjs" type="module"></script>
<script src="/uv/uv.bundle.js"></script>
<script src="/uv/uv.config.js"></script>
<script src="/scram/scramjet.all.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

:root{
  --bg:#050506;
  --bg-2:#0a0a0c;
  --panel:#0d0d0f;
  --line:rgba(255,255,255,0.09);
  --line-strong:rgba(255,255,255,0.18);
  --text:#eaeaee;
  --text-dim:#8a8a92;
  --text-faint:#55555c;
  --accent:#e8e8ec;
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{
  width:100%;height:100%;overflow:hidden;
  background:var(--bg);
  font-family:'Inter',system-ui,sans-serif;
  color:var(--text);
  -webkit-font-smoothing:antialiased;
}
::selection{background:rgba(255,255,255,0.15);}
::-webkit-scrollbar{width:8px;height:8px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--line-strong);border-radius:4px;}
button,input{font-family:inherit;color:inherit;}
button{cursor:pointer;background:none;border:none;}
input{outline:none;}

#app{position:fixed;inset:0;display:flex;flex-direction:column;opacity:0;animation:appIn .7s ease forwards;}
@keyframes appIn{to{opacity:1;}}

.fx-grid{
  position:absolute;inset:0;pointer-events:none;
  background-image:
    linear-gradient(var(--line) 1px, transparent 1px),
    linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size:54px 54px;
  mask-image:radial-gradient(ellipse at 50% 30%, black 5%, transparent 72%);
  opacity:.5;
}
#particles{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}

#toolbar{
  position:relative;z-index:10;flex:0 0 auto;
  display:flex;align-items:center;gap:8px;
  padding:11px 14px;
  border-bottom:1px solid var(--line);
  background:rgba(8,8,9,0.75);
  backdrop-filter:blur(12px);
}
.brand{
  font-weight:700;font-size:12px;letter-spacing:3.5px;color:var(--text-dim);
  padding:0 10px 0 4px;flex:0 0 auto;
}
.nav-btn{
  width:30px;height:30px;border-radius:8px;flex:0 0 auto;
  display:flex;align-items:center;justify-content:center;
  color:var(--text-dim);transition:background .15s,color .15s;
}
.nav-btn:hover{background:rgba(255,255,255,0.07);color:var(--text);}
.nav-btn:disabled{opacity:.3;pointer-events:none;}
.addr-wrap{
  flex:1;display:flex;align-items:center;gap:9px;
  background:rgba(255,255,255,0.04);border:1px solid var(--line);
  border-radius:9px;padding:0 13px;height:32px;
  transition:border-color .15s;
}
.addr-wrap:focus-within{border-color:var(--line-strong);}
.addr-wrap .lock{font-size:10.5px;color:var(--text-faint);letter-spacing:.5px;}
#address{flex:1;background:none;border:none;font-size:13px;color:var(--text);}
#address::placeholder{color:var(--text-faint);}
.tool-action{
  flex:0 0 auto;height:32px;padding:0 15px;border-radius:8px;
  font-size:12px;font-weight:600;letter-spacing:.2px;
  border:1px solid var(--line-strong);color:var(--text-dim);
  display:flex;align-items:center;gap:7px;
  transition:background .15s,color .15s;
}
.tool-action:hover{background:rgba(255,255,255,0.06);color:var(--text);}

#appstrip{
  position:relative;z-index:9;flex:0 0 auto;
  display:flex;align-items:center;gap:6px;
  padding:8px 14px;overflow-x:auto;
  border-bottom:1px solid var(--line);
  background:rgba(8,8,9,0.5);
  backdrop-filter:blur(10px);
}
#appstrip.empty{display:none;}
.chip{
  flex:0 0 auto;display:flex;align-items:center;gap:7px;
  padding:6px 12px 6px 6px;border-radius:20px;border:1px solid var(--line);
  font-size:11.5px;color:var(--text-dim);white-space:nowrap;
  transition:background .15s,border-color .15s,color .15s;
}
.chip:hover{background:rgba(255,255,255,0.05);border-color:var(--line-strong);color:var(--text);}
.chip .chip-avatar{
  width:20px;height:20px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:9.5px;font-weight:700;color:#0a0a0b;flex:0 0 auto;
}
.chip .chip-del{
  margin-left:2px;width:15px;height:15px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  color:var(--text-faint);opacity:0;transition:opacity .12s,color .12s;
}
.chip:hover .chip-del{opacity:1;}
.chip .chip-del:hover{color:#e39a9a;}

#view{position:relative;flex:1;min-height:0;background:#000;}
#view iframe{width:100%;height:100%;border:none;display:block;background:#fff;}

#home{
  position:relative;z-index:2;height:100%;overflow-y:auto;
  display:flex;flex-direction:column;align-items:center;
  padding:64px 20px 40px;
}
.home-mark{
  font-weight:700;font-size:46px;letter-spacing:14px;padding-left:14px;
  color:var(--text);margin-bottom:8px;
}
.home-sub{font-size:12px;letter-spacing:2px;color:var(--text-faint);margin-bottom:34px;}
.home-search{
  width:100%;max-width:520px;
  display:flex;align-items:center;gap:10px;
  background:rgba(255,255,255,0.04);border:1px solid var(--line);
  border-radius:12px;padding:0 16px;height:46px;
  transition:border-color .15s;
  margin-bottom:46px;
}
.home-search:focus-within{border-color:var(--line-strong);}
.home-search input{flex:1;background:none;border:none;font-size:14px;color:var(--text);}
.home-search input::placeholder{color:var(--text-faint);}

.apps-heading{
  width:100%;max-width:640px;
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:16px;
}
.apps-heading .lbl{font-size:10.5px;letter-spacing:2px;color:var(--text-faint);}
.apps-grid{
  width:100%;max-width:640px;
  display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));
  gap:14px;
}
.app-tile{
  position:relative;
  display:flex;flex-direction:column;align-items:center;gap:9px;
  padding:16px 8px;border:1px solid var(--line);border-radius:12px;
  background:rgba(255,255,255,0.015);
  transition:border-color .15s,background .15s,transform .15s;
}
.app-tile:hover{border-color:var(--line-strong);background:rgba(255,255,255,0.04);transform:translateY(-2px);}
.app-tile .tile-avatar{
  width:40px;height:40px;border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  font-size:15px;font-weight:700;color:#0a0a0b;
}
.app-tile .tile-name{font-size:11.5px;color:var(--text-dim);text-align:center;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.app-tile .tile-del{
  position:absolute;top:6px;right:6px;width:18px;height:18px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  color:var(--text-faint);opacity:0;transition:opacity .12s,color .12s,background .12s;
}
.app-tile:hover .tile-del{opacity:1;}
.app-tile .tile-del:hover{color:#e39a9a;background:rgba(217,138,138,0.12);}
.app-tile.add-tile{
  border-style:dashed;color:var(--text-faint);align-items:center;justify-content:center;
}
.app-tile.add-tile .tile-avatar{
  background:rgba(255,255,255,0.05);color:var(--text-dim);border:1px solid var(--line);
}
.apps-empty-hint{font-size:11.5px;color:var(--text-faint);margin-top:6px;text-align:center;max-width:340px;line-height:1.5;}

.hint{
  position:absolute;bottom:14px;left:0;right:0;text-align:center;
  font-size:10.5px;color:var(--text-faint);letter-spacing:.3px;z-index:2;
}

#modal-overlay{
  position:fixed;inset:0;z-index:100;
  background:rgba(3,3,4,0.7);backdrop-filter:blur(4px);
  display:none;align-items:center;justify-content:center;
  opacity:0;transition:opacity .2s ease;
}
#modal-overlay.show{display:flex;opacity:1;}
.modal{
  width:340px;padding:26px 24px;border:1px solid var(--line-strong);
  border-radius:14px;background:var(--panel);
  transform:translateY(6px) scale(.98);transition:transform .2s ease;
}
#modal-overlay.show .modal{transform:none;}
.modal-title{font-size:15px;font-weight:600;margin-bottom:4px;}
.modal-sub{font-size:11.5px;color:var(--text-faint);margin-bottom:18px;}
.modal-field{margin-bottom:12px;}
.modal-field label{display:block;font-size:10.5px;letter-spacing:1px;color:var(--text-faint);margin-bottom:6px;}
.modal-field input{
  width:100%;padding:10px 12px;background:rgba(255,255,255,0.04);
  border:1px solid var(--line);border-radius:8px;font-size:13px;color:var(--text);
}
.modal-field input:focus{border-color:var(--line-strong);}
.modal-actions{display:flex;gap:8px;margin-top:18px;}
.modal-btn{
  flex:1;padding:10px 12px;border-radius:8px;font-size:12.5px;font-weight:600;text-align:center;
}
.modal-btn.primary{background:var(--accent);color:#0a0a0b;}
.modal-btn.primary:hover{opacity:.85;}
.modal-btn.secondary{border:1px solid var(--line);color:var(--text-dim);}
.modal-btn.secondary:hover{color:var(--text);border-color:var(--line-strong);}
.modal-error{font-size:11px;color:#d98a8a;margin-top:4px;min-height:14px;}

.bottombar-wrapper {
  position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:200;
  display:flex;gap:6px;padding:8px 14px;
  background:rgba(10,10,12,0.8);backdrop-filter:blur(14px);
  border:1px solid var(--line);border-radius:16px;
}
.bb-item{
  width:38px;height:38px;border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  color:var(--text-dim);transition:all .2s;
}
.bb-item:hover{background:rgba(255,255,255,0.06);color:var(--text);transform:translateY(-2px);}
.bb-item svg{width:17px;height:17px;}
.bb-divider{width:1px;height:20px;background:var(--line);margin:0 4px;}
</style>
</head>
<body>

<div id="app">
  <div id="toolbar">
    <div class="brand">SILOX</div>
    <button class="nav-btn" id="btn-back" title="Back">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <button class="nav-btn" id="btn-fwd" title="Forward">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>
    </button>
    <button class="nav-btn" id="btn-refresh" title="Refresh">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 11A8 8 0 1 0 6.3 17.7M20 11V5M20 11h-6"/></svg>
    </button>
    <button class="nav-btn" id="btn-home" title="Home">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11l8-7 8 7v9a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1v-9z"/></svg>
    </button>
    <div class="addr-wrap">
      <span class="lock">https</span>
      <input id="address" placeholder="Search or enter a web address">
    </div>
    <button class="tool-action" id="btn-addapp">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
      Add app
    </button>
    <button class="nav-btn" id="btn-fullscreen" title="Fullscreen">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H4v4M16 3h4v4M8 21H4v-4M16 21h4v-4"/></svg>
    </button>
  </div>

  <div id="appstrip"></div>

  <div id="view">
    <div class="fx-grid"></div>
    <canvas id="particles"></canvas>
    <div id="home">
      <div class="home-mark">SILOX</div>
      <div class="home-sub">YOUR BROWSER</div>
      <div class="home-search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input id="home-search-input" placeholder="Search or enter a web address">
      </div>
      <div class="apps-heading"><span class="lbl">QUICK APPS</span></div>
      <div class="apps-grid" id="apps-grid"></div>
      <div class="apps-empty-hint" id="apps-empty-hint">Add a site as an app and it'll show up here for one-click access.</div>
    </div>
    <div class="hint" id="frame-hint">SILOX routes through Scramjet & Ultraviolet proxy.</div>
  </div>
</div>

<div class="bottombar-wrapper">
  <a href="/" class="bb-item" title="Home">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
  </a>
  <div class="bb-divider"></div>
  <a href="/chat" class="bb-item" title="Chat">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
  </a>
  <div class="bb-divider"></div>
  <a href="/settings" class="bb-item" title="Settings">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
  </a>
</div>

<div id="modal-overlay">
  <div class="modal">
    <div class="modal-title">Add an app</div>
    <div class="modal-sub">Give it a name and the address it should open.</div>
    <div class="modal-field">
      <label>NAME</label>
      <input id="modal-name" placeholder="e.g. Wikipedia" maxlength="24">
    </div>
    <div class="modal-field">
      <label>URL</label>
      <input id="modal-url" placeholder="e.g. wikipedia.org" maxlength="200">
    </div>
    <div class="modal-error" id="modal-error"></div>
    <div class="modal-actions">
      <button class="modal-btn secondary" id="modal-cancel">Cancel</button>
      <button class="modal-btn primary" id="modal-save">Add app</button>
    </div>
  </div>
</div>

<script>
(function(){
"use strict";

const memStore = {};
async function storeGet(key){
  try{ const r = await window.storage?.get(key, false); return r ? r.value : null; }
  catch(e){ return Object.prototype.hasOwnProperty.call(memStore,key) ? memStore[key] : null; }
}
async function storeSet(key, value){
  try{ await window.storage?.set(key, value, false); }
  catch(e){ memStore[key] = value; }
}

async function initProxy(){
  try{
    var c = new BareMux.BareMuxConnection('/baremux/worker.js');
    var w = localStorage.getItem('wisp') || ((location.protocol==='https:'?'wss':'ws')+'://'+location.host+'/wisp/');
    var t = localStorage.getItem('transport') || 'libcurl';
    var tp = t==='epoxy'?'/epoxy/index.mjs':'/libcurl/index.mjs';
    if(await c.getTransport()!==tp) await c.setTransport(tp,[{wisp:w}]);
    var sc = $scramjetLoadController().ScramjetController;
    var sj = new sc({prefix:'/scram/service/',files:{wasm:'/scram/scramjet.wasm.wasm',all:'/scram/scramjet.all.js',sync:'/scram/scramjet.sync.js'},flags:{syncxhr:true}});
    await sj.init();
  }catch(e){}
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function initParticles(){
  const canvas = document.getElementById('particles');
  const ctx = canvas.getContext('2d');
  let w,h,pts;
  function resize(){ w = canvas.width = canvas.offsetWidth; h = canvas.height = canvas.offsetHeight; }
  function make(){
    pts = [];
    for(let i=0;i<44;i++){
      pts.push({x:Math.random()*w, y:Math.random()*h, vx:(Math.random()-0.5)*0.16, vy:(Math.random()-0.5)*0.16, r:Math.random()*1.3+0.4});
    }
  }
  function tick(){
    ctx.clearRect(0,0,w,h);
    for(const p of pts){
      p.x+=p.vx; p.y+=p.vy;
      if(p.x<0||p.x>w) p.vx*=-1;
      if(p.y<0||p.y>h) p.vy*=-1;
    }
    for(let i=0;i<pts.length;i++){
      for(let j=i+1;j<pts.length;j++){
        const dx=pts[i].x-pts[j].x, dy=pts[i].y-pts[j].y;
        const d=Math.sqrt(dx*dx+dy*dy);
        if(d<115){
          ctx.strokeStyle='rgba(255,255,255,'+(0.07*(1-d/115))+')';
          ctx.lineWidth=1;
          ctx.beginPath();ctx.moveTo(pts[i].x,pts[i].y);ctx.lineTo(pts[j].x,pts[j].y);ctx.stroke();
        }
      }
    }
    for(const p of pts){
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle='rgba(255,255,255,0.5)'; ctx.fill();
    }
    requestAnimationFrame(tick);
  }
  resize(); make();
  window.addEventListener('resize', ()=>{resize(); make();});
  tick();
}

const PALETTE = ['#e8b568','#a9c9ff','#8fd6b0','#e6a5b8','#c9b8f0','#e8e8ec','#8fd0d6'];
function colorFor(name){
  let hash = 0;
  for(let i=0;i<name.length;i++) hash = name.charCodeAt(i) + ((hash<<5)-hash);
  return PALETTE[Math.abs(hash) % PALETTE.length];
}
function initialsFor(name){
  const parts = name.trim().split(/\s+/);
  if(parts.length===1) return parts[0].slice(0,2).toUpperCase();
  return (parts[0][0]+parts[1][0]).toUpperCase();
}

function proxyEncode(url){
  try{
    var proxy = localStorage.getItem('proxy') || 'ultraviolet';
    if(proxy==='ultraviolet' && typeof __uv$config !== 'undefined'){
      return __uv$config.prefix + __uv$config.encodeUrl(url);
    }
    return '/scram/service/' + encodeURIComponent(url);
  }catch(e){
    return '/scram/service/' + encodeURIComponent(url);
  }
}

let apps = [];
let history = [null];
let idx = 0;
let autoNavUrl = null;

// Check for auto-navigate URL from front page
var savedUrl = localStorage.getItem('url');
if(savedUrl) {
  localStorage.removeItem('url');
  try {
    if(savedUrl.includes(__uv$config?.prefix)) {
      autoNavUrl = __uv$config.decodeUrl(savedUrl.split(__uv$config.prefix)[1]);
    } else if(savedUrl.includes('/scram/service/')) {
      autoNavUrl = decodeURIComponent(savedUrl.split('/scram/service/')[1]);
    }
  } catch(e) {}
}

function normalizeUrl(v){
  v = (v||'').trim();
  if(!v) return null;
  if(/^https?:\/\//i.test(v)) return v;
  if(/^[a-z0-9-]+(\.[a-z0-9-]+)+/i.test(v) && !v.includes(' ')) return 'https://'+v;
  var engine = localStorage.getItem('search') || 'https://duckduckgo.com/html/?q=';
  return engine + encodeURIComponent(v);
}

function navigate(rawUrl){
  const norm = normalizeUrl(rawUrl);
  history = history.slice(0, idx+1);
  history.push(norm);
  idx = history.length-1;
  render();
}

function goHome(){
  history = history.slice(0, idx+1);
  history.push(null);
  idx = history.length-1;
  render();
}

function render(){
  const url = history[idx];
  const home = document.getElementById('home');
  const hint = document.getElementById('frame-hint');
  let iframe = document.querySelector('#view iframe');

  if(!url){
    document.getElementById('address').value = '';
    document.getElementById('btn-back').disabled = idx<=0;
    document.getElementById('btn-fwd').disabled = idx>=history.length-1;
    if(iframe) iframe.remove();
    home.style.display = 'flex';
    hint.style.display = 'none';
  }else{
    document.getElementById('address').value = url;
    document.getElementById('btn-back').disabled = idx<=0;
    document.getElementById('btn-fwd').disabled = idx>=history.length-1;
    home.style.display = 'none';
    hint.style.display = 'block';
    if(iframe) iframe.remove();
    iframe = document.createElement('iframe');
    iframe.src = proxyEncode(url);
    iframe.referrerPolicy = 'no-referrer';
    iframe.setAttribute('sandbox','allow-scripts allow-same-origin allow-forms allow-popups');
    document.getElementById('view').appendChild(iframe);
  }
}

async function loadApps(){
  const raw = await storeGet('silox_browser_apps');
  try{ apps = raw ? JSON.parse(raw) : []; }catch(e){ apps = []; }
  renderApps();
}
async function saveApps(){ await storeSet('silox_browser_apps', JSON.stringify(apps)); }

function renderApps(){
  const strip = document.getElementById('appstrip');
  strip.innerHTML = '';
  if(apps.length===0){ strip.classList.add('empty'); }
  else{
    strip.classList.remove('empty');
    apps.forEach(a=>{
      const chip = document.createElement('div');
      chip.className = 'chip';
      chip.innerHTML = `<span class="chip-avatar" style="background:${a.color}">${escapeHtml(initialsFor(a.name))}</span><span>${escapeHtml(a.name)}</span><span class="chip-del">
        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </span>`;
      chip.addEventListener('click', e=>{
        if(e.target.closest('.chip-del')){ removeApp(a.id); return; }
        navigate(a.url);
      });
      strip.appendChild(chip);
    });
  }

  const grid = document.getElementById('apps-grid');
  grid.innerHTML = '';
  document.getElementById('apps-empty-hint').style.display = apps.length? 'none':'block';
  apps.forEach(a=>{
    const tile = document.createElement('div');
    tile.className = 'app-tile';
    tile.innerHTML = `
      <div class="tile-del">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </div>
      <div class="tile-avatar" style="background:${a.color}">${escapeHtml(initialsFor(a.name))}</div>
      <div class="tile-name">${escapeHtml(a.name)}</div>
    `;
    tile.addEventListener('click', e=>{
      if(e.target.closest('.tile-del')){ removeApp(a.id); return; }
      navigate(a.url);
    });
    grid.appendChild(tile);
  });
  const addTile = document.createElement('div');
  addTile.className = 'app-tile add-tile';
  addTile.innerHTML = `
    <div class="tile-avatar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg></div>
    <div class="tile-name">Add app</div>
  `;
  addTile.addEventListener('click', openModal);
  grid.appendChild(addTile);
}

async function removeApp(id){
  apps = apps.filter(a=>a.id!==id);
  await saveApps();
  renderApps();
}

function openModal(){
  document.getElementById('modal-name').value = '';
  document.getElementById('modal-url').value = '';
  document.getElementById('modal-error').textContent = '';
  document.getElementById('modal-overlay').classList.add('show');
  document.getElementById('modal-name').focus();
}
function closeModal(){
  document.getElementById('modal-overlay').classList.remove('show');
}
async function saveNewApp(){
  const name = document.getElementById('modal-name').value.trim();
  const url = document.getElementById('modal-url').value.trim();
  const err = document.getElementById('modal-error');
  if(!name){ err.textContent = 'Give the app a name.'; return; }
  if(!url){ err.textContent = 'Add a URL for it to open.'; return; }
  const norm = normalizeUrl(url);
  apps.push({id:'app'+Date.now()+Math.random().toString(36).slice(2,6), name, url:norm, color: colorFor(name)});
  await saveApps();
  renderApps();
  closeModal();
}

document.getElementById('address').addEventListener('keydown', e=>{
  if(e.key==='Enter') navigate(e.target.value);
});
document.getElementById('home-search-input').addEventListener('keydown', e=>{
  if(e.key==='Enter') navigate(e.target.value);
});
document.getElementById('btn-back').addEventListener('click', ()=>{ if(idx>0){ idx--; render(); } });
document.getElementById('btn-fwd').addEventListener('click', ()=>{ if(idx<history.length-1){ idx++; render(); } });
document.getElementById('btn-refresh').addEventListener('click', render);
document.getElementById('btn-home').addEventListener('click', goHome);
document.getElementById('btn-addapp').addEventListener('click', openModal);
document.getElementById('btn-fullscreen').addEventListener('click', ()=>{
  if(!document.fullscreenElement){ document.getElementById('app').requestFullscreen?.(); }
  else{ document.exitFullscreen?.(); }
});
document.getElementById('modal-cancel').addEventListener('click', closeModal);
document.getElementById('modal-save').addEventListener('click', saveNewApp);
document.getElementById('modal-url').addEventListener('keydown', e=>{ if(e.key==='Enter') saveNewApp(); });
document.getElementById('modal-overlay').addEventListener('click', e=>{ if(e.target.id==='modal-overlay') closeModal(); });

initProxy();
initParticles();
loadApps();

// Auto-navigate if URL was passed from front page
if(autoNavUrl){
  navigate(autoNavUrl);
} else {
  render();
}

})();
</script>
</body>
</html>