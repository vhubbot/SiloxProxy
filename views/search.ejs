<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Silox Browser</title>
    <script src="/baremux/index.js"></script>
    <script src="/epoxy/index.mjs" type="module"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>
    <script src="/scram/scramjet.all.js"></script>
    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes tabSlideIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
        @keyframes bounceIn { 0% { transform: scale(0.3); opacity: 0; } 50% { transform: scale(1.05); } 70% { transform: scale(0.95); } 100% { transform: scale(1); opacity: 1; } }
        @keyframes logoShine { 0% { background-position: -200% center; } 100% { background-position: 200% center; } }
        @keyframes logoBuild { 0%{transform:scale(0)perspective(500px)rotateX(90deg);opacity:0;filter:blur(30px)}40%{transform:scale(1.2)perspective(500px)rotateX(-10deg);opacity:.7;filter:blur(0)}55%{transform:scale(.9)perspective(500px)rotateX(5deg)}68%{transform:scale(1.05)perspective(500px)rotateX(-2deg)}78%{transform:scale(.97)}88%{transform:scale(1.02)}95%{transform:scale(.99)}100%{transform:scale(1)perspective(500px)rotateX(0);opacity:1} }
        @keyframes floatParticle { 0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.3; } 50% { transform: translateY(-30px) rotate(180deg); opacity: 0.7; } }
        @keyframes floatUp { 0% { transform: translateY(100vh) scale(0); opacity: 0; } 50% { opacity: 0.6; } 100% { transform: translateY(-10vh) scale(1); opacity: 0; } }
        @keyframes introFadeOut { from { opacity: 1; } to { opacity: 0; transform: scale(1.1); } }
        @keyframes gridMove { 0% { transform: translate(0, 0); } 100% { transform: translate(50px, 50px); } }
        @keyframes pulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.8; } }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes rumble { 0%,100%{transform:translateX(0)}15%{transform:translateX(-3px)rotate(-1deg)}30%{transform:translateX(3px)rotate(1deg)}45%{transform:translateX(-2px)rotate(-.5deg)}60%{transform:translateX(2px)rotate(.5deg)}75%{transform:translateX(-1px)}90%{transform:translateX(1px)} }
        @keyframes pulseGlow { 0%,100%{box-shadow:0 0 20px rgba(220,38,38,0.3)}50%{box-shadow:0 0 40px rgba(220,38,38,0.6)} }

        :root {
            --bg: #0a0a0f;
            --bg2: #111118;
            --bg3: #1a1a24;
            --text: #e8e8f0;
            --text2: #888899;
            --accent: #dc2626;
            --accent-hover: #ef4444;
            --border: rgba(255, 255, 255, 0.08);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
            background-color: #08080f;
            color: var(--text);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
            padding-bottom: 70px;
            position: relative;
        }

        .bg-grid {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.12;
        }
        .bg-grid::before {
            content: '';
            position: absolute;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background-image: 
                linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 60px 60px;
            animation: gridMove 20s linear infinite;
        }
        .bg-grid::after {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: radial-gradient(ellipse at 50% 30%, rgba(220,38,38,0.03) 0%, transparent 60%),
                        radial-gradient(ellipse at 80% 80%, rgba(255,255,255,0.02) 0%, transparent 50%);
        }

        .particles-container {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }
        .rising-particle {
            position: absolute;
            border-radius: 50%;
            animation: floatUp linear infinite;
        }

        /* INTRO OVERLAY */
        .intro-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: #06060e;
            z-index: 20000;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            animation: fadeIn 0.5s ease;
            cursor: pointer;
            overflow: hidden;
        }
        .intro-overlay.hidden { display: none; }
        .intro-overlay.fade-out { animation: introFadeOut 0.4s ease forwards; }
        
        .intro-particles {
            position: absolute;
            width: 100%; height: 100%;
            pointer-events: none;
        }
        .intro-particle {
            position: absolute;
            width: 3px; height: 3px;
            background: var(--accent);
            border-radius: 50%;
            animation: floatParticle 4s ease-in-out infinite;
            box-shadow: 0 0 12px rgba(220, 38, 38, 0.7);
        }
        .intro-particle:nth-child(1) { left: 10%; top: 20%; animation-delay: 0s; }
        .intro-particle:nth-child(2) { left: 25%; top: 60%; animation-delay: 0.5s; }
        .intro-particle:nth-child(3) { left: 40%; top: 30%; animation-delay: 1s; }
        .intro-particle:nth-child(4) { left: 55%; top: 70%; animation-delay: 1.5s; }
        .intro-particle:nth-child(5) { left: 70%; top: 25%; animation-delay: 2s; }
        .intro-particle:nth-child(6) { left: 85%; top: 55%; animation-delay: 0.3s; }
        .intro-particle:nth-child(7) { left: 15%; top: 80%; animation-delay: 0.8s; }
        .intro-particle:nth-child(8) { left: 50%; top: 45%; animation-delay: 1.3s; }

        .intro-logo {
            font-size: 5rem;
            font-weight: 900;
            letter-spacing: 12px;
            position: relative;
            z-index: 1;
            background: linear-gradient(90deg, #fff, #ccc 30%, var(--accent) 50%, #ccc 70%, #fff);
            background-size: 300% 100%;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: logoShine 4s linear infinite;
            filter: drop-shadow(0 0 40px rgba(220, 38, 38, 0.5));
        }
        .intro-subtitle {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.4);
            letter-spacing: 8px;
            text-transform: uppercase;
            margin-top: 8px;
            position: relative;
            z-index: 1;
            font-weight: 500;
        }
        .intro-click {
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.2);
            letter-spacing: 3px;
            margin-top: 30px;
            position: relative;
            z-index: 1;
            animation: pulse 2s ease-in-out infinite;
        }

        /* BROWSER UI */
        .browser-ui {
            display: flex;
            flex-direction: column;
            height: 100%;
            position: relative;
            z-index: 1;
        }
        .browser-ui.hidden { display: none; }

        .tabs-bar {
            display: flex;
            align-items: center;
            gap: 2px;
            padding: 6px 10px 0 10px;
            background: rgba(17, 17, 24, 0.9);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--border);
            overflow-x: auto;
            flex-shrink: 0;
            min-height: 38px;
            scrollbar-width: none;
        }
        .tabs-bar::-webkit-scrollbar { display: none; }

        .tab {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 10px 10px 0 0;
            background: transparent;
            border: 1px solid transparent;
            color: var(--text2);
            cursor: pointer;
            font-size: 12px;
            white-space: nowrap;
            min-width: 60px;
            max-width: 160px;
            transition: all 0.2s;
            flex-shrink: 0;
            position: relative;
            font-weight: 500;
        }
        .tab:hover {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text);
        }
        .tab:active { animation: rumble 0.3s ease; }
        .tab.active {
            background: rgba(26, 26, 36, 0.8);
            color: var(--text);
            border-color: var(--border);
            border-bottom-color: transparent;
            font-weight: 600;
        }
        .tab.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 8px; right: 8px;
            height: 2px;
            background: var(--accent);
            border-radius: 2px 2px 0 0;
        }
        .tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }
        .tab-close {
            width: 18px; height: 18px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: var(--text2);
            cursor: pointer;
            font-size: 9px;
            opacity: 0;
            transition: all 0.2s;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }
        .tab:hover .tab-close,
        .tab.active .tab-close { opacity: 1; }
        .tab-close:hover {
            background: rgba(220, 38, 38, 0.3);
            color: white;
        }
        .tab-close:active { animation: rumble 0.2s ease; }

        .new-tab-btn {
            width: 30px; height: 30px;
            border-radius: 8px;
            border: 2px dashed rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.03);
            cursor: pointer;
            font-size: 18px;
            color: var(--text2);
            transition: all 0.2s;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 4px;
            line-height: 1;
        }
        .new-tab-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: rgba(220, 38, 38, 0.1);
        }
        .new-tab-btn:active { transform: scale(0.9); animation: rumble 0.3s ease; }

        .content {
            flex: 1;
            position: relative;
            background: rgba(10, 10, 15, 0.5);
        }
        .content iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
        }

        .newtab-page {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding-bottom: 80px;
        }
        .nt-logo {
            font-size: 4.5rem;
            font-weight: 900;
            letter-spacing: 10px;
            margin-bottom: 4px;
            color: #1a1a1a;
            animation: logoBuild 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
            text-shadow: 0 2px 0 rgba(255,255,255,0.1), 0 -2px 0 rgba(0,0,0,0.3);
        }
        .nt-logo span { 
            color: var(--accent); 
            text-shadow: none;
            animation: pulseGlow 2s ease-in-out 1.2s infinite;
        }
        .nt-subtitle {
            font-size: 0.8rem;
            color: var(--text2);
            letter-spacing: 6px;
            margin-bottom: 32px;
            text-transform: uppercase;
            font-weight: 600;
            animation: slideUp 0.6s ease 0.4s both;
        }

        /* Search box */
        .nt-search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            max-width: 560px;
            width: 88%;
            animation: slideUp 0.5s ease 0.6s both;
        }
        .nt-search-input {
            flex: 1;
            padding: 16px 22px;
            border-radius: 14px;
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            background: rgba(26, 26, 36, 0.85);
            color: var(--text);
            outline: none;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            font-family: inherit;
        }
        .nt-search-input:focus {
            border-color: rgba(220, 38, 38, 0.5);
            box-shadow: 0 0 30px rgba(220, 38, 38, 0.1);
        }
        .nt-search-input::placeholder { color: rgba(255, 255, 255, 0.2); font-size: 0.9rem; }
        .nt-search-btn {
            padding: 16px 28px;
            border-radius: 14px;
            border: none;
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            color: white;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 700;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            font-family: inherit;
            white-space: nowrap;
            box-shadow: 0 6px 25px rgba(220, 38, 38, 0.3);
            animation: pulseGlow 2s ease-in-out infinite;
        }
        .nt-search-btn:hover {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            box-shadow: 0 8px 35px rgba(220, 38, 38, 0.45);
            transform: translateY(-2px);
        }
        .nt-search-btn:active { transform: scale(0.94); animation: rumble 0.35s ease; }

        /* Quick action buttons */
        .quick-actions {
            display: flex;
            gap: 10px;
            margin-top: 28px;
            flex-wrap: wrap;
            justify-content: center;
            animation: fadeInUp 0.5s ease 0.8s both;
        }
        .qa-btn {
            padding: 12px 22px;
            border-radius: 26px;
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            background: rgba(26, 26, 36, 0.7);
            color: var(--text2);
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            font-family: inherit;
            font-weight: 600;
        }
        .qa-btn:hover {
            border-color: var(--accent);
            color: var(--text);
            background: rgba(220, 38, 38, 0.12);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(220, 38, 38, 0.15);
        }
        .qa-btn:active { transform: scale(0.94); animation: rumble 0.35s ease; }

        /* Action buttons after search */
        .post-search-actions {
            display: none;
            gap: 10px;
            margin-top: 18px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .post-search-actions.show {
            display: flex;
            animation: slideDown 0.35s ease;
        }
        .psa-btn {
            padding: 12px 20px;
            border-radius: 24px;
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            background: rgba(26, 26, 36, 0.75);
            color: var(--text);
            cursor: pointer;
            font-size: 0.82rem;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            font-family: inherit;
            font-weight: 600;
        }
        .psa-btn:hover {
            border-color: var(--accent);
            background: rgba(220, 38, 38, 0.15);
            box-shadow: 0 6px 20px rgba(220, 38, 38, 0.2);
            transform: translateY(-2px);
        }
        .psa-btn:active { transform: scale(0.94); animation: rumble 0.35s ease; }
        .psa-btn.primary {
            background: var(--accent);
            border-color: var(--accent);
            color: white;
            box-shadow: 0 6px 20px rgba(220, 38, 38, 0.3);
            animation: pulseGlow 2s ease-in-out infinite;
        }
        .psa-btn.primary:hover { background: var(--accent-hover); }

        /* App shortcuts */
        .app-shortcuts {
            display: flex;
            gap: 12px;
            margin-top: 30px;
            flex-wrap: wrap;
            justify-content: center;
            animation: fadeInUp 0.5s ease 1.0s both;
        }
        .app-shortcut {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .app-shortcut:hover { transform: translateY(-4px); }
        .app-shortcut:active { animation: rumble 0.35s ease; }
        .app-shortcut-icon {
            width: 52px; height: 52px;
            border-radius: 14px;
            background: rgba(26, 26, 36, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            overflow: hidden;
        }
        .app-shortcut:hover .app-shortcut-icon {
            border-color: var(--accent);
            box-shadow: 0 8px 25px rgba(220, 38, 38, 0.25);
            background: rgba(220, 38, 38, 0.15);
        }
        .app-shortcut-icon img { width: 60%; height: 60%; object-fit: contain; border-radius: 4px; }
        .app-shortcut-icon .app-letter { font-weight: 800; font-size: 1.3rem; color: var(--text2); }
        .app-shortcut-name { font-size: 0.7rem; color: var(--text2); max-width: 70px; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .add-app-shortcut {
            width: 52px; height: 52px;
            border-radius: 14px;
            border: 2px dashed rgba(255, 255, 255, 0.12);
            background: rgba(26, 26, 36, 0.5);
            cursor: pointer;
            font-size: 22px;
            color: var(--text2);
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .add-app-shortcut:hover { border-color: var(--accent); color: var(--accent); background: rgba(220, 38, 38, 0.12); }
        .add-app-shortcut:active { animation: rumble 0.35s ease; }

        /* Add App Modal */
        .modal-overlay {
            position: fixed; top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 5000;
            display: none;
            align-items: center; justify-content: center;
            backdrop-filter: blur(6px);
        }
        .modal-overlay.show { display: flex; }
        .modal-box {
            background: #111118;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 30px;
            width: 92%; max-width: 380px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6);
            animation: bounceIn 0.4s ease;
        }
        .modal-box h3 { font-size: 1rem; margin-bottom: 4px; letter-spacing: 0.5px; }
        .modal-box .modal-desc { font-size: 0.72rem; color: var(--text2); margin-bottom: 18px; }
        .modal-box input {
            width: 100%; padding: 13px 16px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: #1a1a24; color: var(--text);
            outline: none; font-size: 0.88rem;
            margin-bottom: 12px; font-family: inherit;
        }
        .modal-box input:focus { border-color: var(--accent); }
        .modal-btns { display: flex; gap: 8px; margin-top: 6px; }
        .modal-btns button {
            flex: 1; padding: 12px;
            border-radius: 10px; cursor: pointer;
            font-size: 0.82rem; font-weight: 600;
            font-family: inherit; transition: all 0.2s;
        }
        .modal-add { background: var(--accent); border: none; color: white; }
        .modal-add:hover { background: var(--accent-hover); }
        .modal-add:active { animation: rumble 0.3s ease; }
        .modal-cancel { background: transparent; border: 1px solid rgba(255,255,255,0.1); color: var(--text2); }
        .modal-cancel:hover { border-color: rgba(255,255,255,0.2); color: var(--text); }

        /* HISTORY */
        .history-panel {
            position: fixed; right: 0; top: 0;
            width: 380px; height: 100%;
            background: rgba(17, 17, 24, 0.97);
            border-left: 1px solid var(--border);
            z-index: 3000;
            box-shadow: -10px 0 35px rgba(0, 0, 0, 0.5);
            transform: translateX(100%);
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex; flex-direction: column;
            backdrop-filter: blur(20px);
        }
        .history-panel.open { transform: translateX(0); }
        .history-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 18px 22px; border-bottom: 1px solid var(--border);
        }
        .history-header h3 { font-size: 0.95rem; font-weight: 700; }
        .history-close {
            width: 32px; height: 32px; border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.08);
            background: transparent; color: var(--text2);
            cursor: pointer; font-size: 14px; transition: all 0.2s;
        }
        .history-close:hover { background: rgba(220, 38, 38, 0.15); border-color: var(--accent); color: var(--accent); }
        .history-close:active { animation: rumble 0.3s ease; }
        .history-list { flex: 1; overflow-y: auto; padding: 4px 0; }
        .history-item {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 22px; cursor: pointer;
            transition: all 0.2s; border-left: 2px solid transparent;
        }
        .history-item:hover { background: rgba(255, 255, 255, 0.02); border-left-color: var(--accent); }
        .history-item:active { animation: rumble 0.25s ease; }
        .history-item-info { flex: 1; min-width: 0; }
        .history-item-title { font-size: 0.82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
        .history-item-url { font-size: 0.7rem; color: var(--text2); margin-top: 2px; }
        .history-item-delete {
            width: 26px; height: 26px; border-radius: 50%;
            border: none; background: transparent;
            color: var(--text2); cursor: pointer;
            font-size: 10px; opacity: 0; transition: all 0.2s;
        }
        .history-item:hover .history-item-delete { opacity: 1; }
        .history-item-delete:hover { background: rgba(220, 38, 38, 0.3); color: var(--accent); }
        .history-actions-bar { padding: 14px 22px; border-top: 1px solid var(--border); }
        .history-clear-btn {
            width: 100%; padding: 10px; border-radius: 10px;
            border: 1.5px solid rgba(220, 38, 38, 0.3);
            background: transparent; color: var(--accent);
            cursor: pointer; font-size: 0.78rem;
            transition: all 0.3s; font-family: inherit; font-weight: 600;
        }
        .history-clear-btn:hover { background: rgba(220, 38, 38, 0.1); }
        .history-clear-btn:active { animation: rumble 0.3s ease; }
        .history-overlay {
            position: fixed; top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 2999; opacity: 0;
            pointer-events: none; transition: opacity 0.35s;
        }
        .history-overlay.visible { opacity: 1; pointer-events: all; }

        /* Top right buttons */
        .top-right-fixed {
            position: fixed; top: 10px; right: 10px;
            display: flex; gap: 6px; z-index: 9999;
            animation: fadeIn 0.6s ease 1.5s both;
        }
        .tr-btn {
            width: 38px; height: 38px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(26, 26, 36, 0.85);
            color: var(--text2);
            cursor: pointer;
            font-size: 15px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            backdrop-filter: blur(10px);
            display: flex; align-items: center; justify-content: center;
        }
        .tr-btn:hover {
            background: var(--accent);
            border-color: var(--accent);
            color: white;
            box-shadow: 0 6px 25px rgba(220, 38, 38, 0.4);
            transform: translateY(-2px);
        }
        .tr-btn:active { transform: scale(0.9); animation: rumble 0.3s ease; }
        .tr-btn svg { width: 17px; height: 17px; }

        @media (max-width: 700px) {
            .history-panel { width: 100%; }
            .tab { min-width: 45px; max-width: 110px; font-size: 11px; padding: 7px 10px; }
            .nt-logo { font-size: 3rem; }
            .intro-logo { font-size: 3rem; letter-spacing: 8px; }
            .nt-search-box { width: 94%; }
            .nt-search-input { padding: 14px 16px; font-size: 0.85rem; }
            .nt-search-btn { padding: 14px 20px; font-size: 0.9rem; }
            .qa-btn { padding: 10px 16px; font-size: 0.78rem; }
            .psa-btn { padding: 10px 16px; font-size: 0.75rem; }
        }
    </style>
</head>
<body>
    <div class="bg-grid"></div>
    <div class="particles-container" id="particles-container"></div>

    <div class="intro-overlay" id="intro-overlay" onclick="dismissIntro()">
        <div class="intro-particles">
            <div class="intro-particle"></div><div class="intro-particle"></div>
            <div class="intro-particle"></div><div class="intro-particle"></div>
            <div class="intro-particle"></div><div class="intro-particle"></div>
            <div class="intro-particle"></div><div class="intro-particle"></div>
        </div>
        <div class="intro-logo">HOHOGAMES</div>
        <div class="intro-subtitle">Proxy Network</div>
        <div class="intro-click">Click anywhere to continue</div>
    </div>

    <div class="top-right-fixed">
        <button class="tr-btn" id="music-btn" onclick="togglePersistentMusic()" title="Toggle Music">🎵</button>
        <button class="tr-btn" onclick="openHistory()" title="History">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </button>
        <button class="tr-btn" onclick="window.location.href='/settings'" title="Settings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </button>
    </div>

    <div class="modal-overlay" id="add-app-modal">
        <div class="modal-box">
            <h3>Add App Shortcut</h3>
            <p class="modal-desc">Quick link to your new tab page</p>
            <input type="text" id="app-name-input" placeholder="App name (e.g. Netflix)">
            <input type="text" id="app-url-input" placeholder="URL (e.g. netflix.com)">
            <div class="modal-btns">
                <button class="modal-cancel" onclick="closeAddAppModal()">Cancel</button>
                <button class="modal-add" onclick="addAppShortcut()">Add</button>
            </div>
        </div>
    </div>

    <div class="browser-ui" id="browser-ui">
        <div class="tabs-bar" id="tabs-bar">
            <button class="new-tab-btn" id="new-tab-btn" title="New Tab (Ctrl+T)">+</button>
        </div>
        <div class="content" id="content-area">
            <iframe id="frame" style="display:none;"></iframe>
            <div class="newtab-page" id="newtab-page">
                <div class="nt-logo">SIL<span>O</span>X</div>
                <div class="nt-subtitle">Browse Freely</div>
                <div class="nt-search-box">
                    <input type="text" class="nt-search-input" id="nt-search" placeholder="Search Google or enter a URL..." onkeydown="if(event.key==='Enter')handleSearch(this.value)">
                    <button class="nt-search-btn" onclick="handleSearch(document.getElementById('nt-search').value)">Go</button>
                </div>
                <div class="post-search-actions" id="post-search-actions">
                    <button class="psa-btn primary" onclick="openInProxy()">Open in Proxy</button>
                    <button class="psa-btn" onclick="openInNewTab()">Open in Real Tab</button>
                    <button class="psa-btn" onclick="openFullscreen()">Fullscreen</button>
                    <button class="psa-btn" onclick="cloakCurrentTab()">Cloak & Open</button>
                </div>
                <div class="quick-actions">
                    <button class="qa-btn" onclick="addNewTab()">+ New Tab</button>
                    <button class="qa-btn" onclick="toggleFullscreen()">Fullscreen</button>
                    <button class="qa-btn" onclick="openHistory()">History</button>
                    <button class="qa-btn" onclick="window.location.href='/settings'">Settings</button>
                </div>
                <div class="app-shortcuts" id="app-shortcuts"></div>
            </div>
        </div>
    </div>

    <div class="history-overlay" id="history-overlay" onclick="closeHistory()"></div>
    <div class="history-panel" id="history-panel">
        <div class="history-header"><h3>History</h3><button class="history-close" onclick="closeHistory()">✕</button></div>
        <div class="history-list" id="history-list"></div>
        <div class="history-actions-bar"><button class="history-clear-btn" onclick="clearHistory()">Clear All</button></div>
    </div>

    <%- include('parts/bottombar.ejs') %>

    <script>
        (function() {
            var c = document.getElementById('particles-container');
            var colors = ['#dc2626','#ef4444','#ffffff','#999999','#666666','#333333'];
            for(var i=0;i<30;i++){
                var p=document.createElement('div');
                p.className='rising-particle';
                var s=Math.random()*3+1.5;
                p.style.cssText='left:'+Math.random()*100+'%;width:'+s+'px;height:'+s+'px;background:'+colors[Math.floor(Math.random()*colors.length)]+';animation-duration:'+(Math.random()*12+8)+'s;animation-delay:'+Math.random()*12+'s;box-shadow:0 0 '+(s*4)+'px '+colors[Math.floor(Math.random()*colors.length)]+';';
                c.appendChild(p);
            }
        })();

        const frame=document.getElementById('frame'),tabsBar=document.getElementById('tabs-bar'),newTabBtn=document.getElementById('new-tab-btn'),newtabPage=document.getElementById('newtab-page'),historyPanel=document.getElementById('history-panel'),historyOverlay=document.getElementById('history-overlay'),historyList=document.getElementById('history-list'),introOverlay=document.getElementById('intro-overlay'),postSearchActions=document.getElementById('post-search-actions');
        let tabs=[],activeTabId=null,lastSearchedUrl='';

        function dismissIntro(){localStorage.setItem('silox_intro_seen','true');introOverlay.classList.add('fade-out');setTimeout(function(){introOverlay.classList.add('hidden');initBrowser();initMusic();},400);}
        function initBrowser(){loadSettingsValues();var u=localStorage.getItem('url')||'';if(u){addTab(u,'Loading...');localStorage.removeItem('url');}else{addTab('','New Tab');}renderAppShortcuts();}
        function getHistory(){return JSON.parse(localStorage.getItem('silox_browser_history')||'[]');}
        function saveHistory(h){localStorage.setItem('silox_browser_history',JSON.stringify(h));}
        function getApps(){return JSON.parse(localStorage.getItem('silox_browser_apps')||'[]');}
        function saveApps(a){localStorage.setItem('silox_browser_apps',JSON.stringify(a));}

        class Tab{constructor(id,url,title){this.id=id;this.url=url||'';this.title=title||'New Tab';this.history=[];this.historyIndex=-1;}pushHistory(url){if(this.historyIndex<this.history.length-1)this.history=this.history.slice(0,this.historyIndex+1);this.history.push(url);this.historyIndex=this.history.length-1;}canGoBack(){return this.historyIndex>0;}canGoForward(){return this.historyIndex<this.history.length-1;}goBack(){if(this.canGoBack()){this.historyIndex--;return this.history[this.historyIndex];}return null;}goForward(){if(this.canGoForward()){this.historyIndex++;return this.history[this.historyIndex];}return null;}getCurrentUrl(){if(this.historyIndex>=0&&this.historyIndex<this.history.length)return this.history[this.historyIndex];return this.url;}}

        function createTabId(){return't'+Date.now()+Math.random().toString(36).substr(2,5);}
        function addTab(url,title){var id=createTabId();var tab=new Tab(id,url||'',title||'New Tab');tabs.push(tab);renderTabs();switchTab(id);if(url){var eu=encodeUrl(url);tab.pushHistory(eu);tab.url=eu;updateTabTitle(tab,url);showWebPage();frame.src=eu;}return tab;}
        function addNewTab(){addTab('','New Tab');}
        function closeTab(id){if(tabs.length<=1)return;var i=tabs.findIndex(function(t){return t.id===id;});if(i===-1)return;tabs.splice(i,1);if(activeTabId===id){var ni=Math.min(i,tabs.length-1);activeTabId=tabs[ni].id;updateActiveTab();}renderTabs();}
        function switchTab(id){activeTabId=id;updateActiveTab();renderTabs();}
        function updateActiveTab(){var tab=tabs.find(function(t){return t.id===activeTabId;});if(!tab)return;var u=tab.getCurrentUrl();if(u){showWebPage();frame.src=u;}else{showNewTabPage();}}
        function showWebPage(){frame.style.display='block';newtabPage.style.display='none';}
        function showNewTabPage(){frame.style.display='none';newtabPage.style.display='flex';document.getElementById('nt-search').value='';postSearchActions.classList.remove('show');}
        function navigateInTab(id,rawUrl){var tab=tabs.find(function(t){return t.id===id;});if(!tab)return;var eu=encodeUrl(rawUrl);tab.pushHistory(eu);tab.url=eu;updateTabTitle(tab,rawUrl);var h=getHistory();h.unshift({url:rawUrl,title:tab.title,time:Date.now()});if(h.length>100)h.length=100;saveHistory(h);if(activeTabId===id){showWebPage();frame.src=eu;}renderTabs();}
        function handleSearch(query){var url=query.trim();if(!url)return;lastSearchedUrl=url;postSearchActions.classList.add('show');document.getElementById('nt-search').value='';var tab=tabs.find(function(t){return t.id===activeTabId;});if(!tab){tab=addTab(url);return;}navigateInTab(activeTabId,url);}
        function openInProxy(){if(!lastSearchedUrl)return;handleSearch(lastSearchedUrl);}
        function openInNewTab(){if(!lastSearchedUrl)return;var u=lastSearchedUrl;if(!u.includes('.')||u.includes(' ')){u=(localStorage.getItem('search')||'https://www.google.com/search?q=')+encodeURIComponent(u);}else if(!u.startsWith('http')){u='https://'+u;}window.open(u,'_blank');}
        function openFullscreen(){if(!lastSearchedUrl)return;var u=lastSearchedUrl;if(!u.includes('.')||u.includes(' ')){u=(localStorage.getItem('search')||'https://www.google.com/search?q=')+encodeURIComponent(u);}else if(!u.startsWith('http')){u='https://'+u;}var w=window.open(u,'_blank','fullscreen=yes');if(w)setTimeout(function(){w.document.documentElement.requestFullscreen().catch(function(){});},500);}
        function cloakCurrentTab(){if(!lastSearchedUrl)return;var u=lastSearchedUrl;if(!u.includes('.')||u.includes(' ')){u=(localStorage.getItem('search')||'https://www.google.com/search?q=')+encodeURIComponent(u);}else if(!u.startsWith('http')){u='https://'+u;}var w=window.open('about:blank','_blank');if(w){w.document.write('<!DOCTYPE html><html><head><title>Home</title></head><body style="margin:0;overflow:hidden;"><iframe src="'+u+'" style="width:100%;height:100vh;border:none;"></iframe></body></html>');w.document.close();}else{alert('Allow pop-ups!');}}
        function updateTabTitle(tab,url){try{var p=new URL(url.startsWith('http')?url:'https://'+url);tab.title=p.hostname.replace('www.','')||url.substring(0,22);}catch(e){tab.title=url.substring(0,22);}}
        function encodeUrl(url){var e=localStorage.getItem('search')||'https://www.google.com/search?q=';if(!url.includes('.')||url.includes(' '))url=e+encodeURIComponent(url);else if(!url.startsWith('http'))url='https://'+url;return(localStorage.getItem('proxy')||'ultraviolet')==='ultraviolet'?__uv$config.prefix+__uv$config.encodeUrl(url):'/scram/service/'+encodeURIComponent(url);}
        function decodeUrl(encoded){try{if(encoded.includes(__uv$config.prefix))return __uv$config.decodeUrl(encoded.split(__uv$config.prefix)[1]);if(encoded.includes('/scram/service/'))return decodeURIComponent(encoded.split('/scram/service/')[1]);}catch(e){}return encoded;}
        function renderTabs(){tabsBar.querySelectorAll('.tab').forEach(function(el){el.remove();});tabs.forEach(function(tab){var el=document.createElement('div');el.className='tab'+(tab.id===activeTabId?' active':'');el.innerHTML='<span class="tab-title">'+escapeHtml(tab.title||'New Tab')+'</span>'+(tabs.length>1?'<button class="tab-close">✕</button>':'');el.querySelector('.tab-title').addEventListener('click',function(){switchTab(tab.id);});var cb=el.querySelector('.tab-close');if(cb)cb.addEventListener('click',function(e){e.stopPropagation();closeTab(tab.id);});tabsBar.insertBefore(el,newTabBtn);});}
        function renderAppShortcuts(){var c=document.getElementById('app-shortcuts');var apps=getApps();c.innerHTML='';apps.forEach(function(app){var s=document.createElement('div');s.className='app-shortcut';s.title=app.name+' - Right click to remove';var icon='';try{var d=new URL(app.url.startsWith('http')?app.url:'https://'+app.url).hostname.replace('www.','');icon='<img src="https://www.google.com/s2/favicons?domain='+d+'&sz=64" alt="" onerror="this.style.display=\'none\';this.parentElement.querySelector(\'.app-letter\').style.display=\'block\';">';}catch(e){}s.innerHTML='<div class="app-shortcut-icon">'+icon+'<span class="app-letter" style="display:none;">'+app.name.substring(0,2).toUpperCase()+'</span></div><span class="app-shortcut-name">'+escapeHtml(app.name)+'</span>';s.addEventListener('click',function(){handleSearch(app.url);});s.addEventListener('contextmenu',function(e){e.preventDefault();var apps=getApps();var i=apps.findIndex(function(a){return a.name===app.name&&a.url===app.url;});if(i>-1){apps.splice(i,1);saveApps(apps);renderAppShortcuts();}});c.appendChild(s);});var addBtn=document.createElement('div');addBtn.className='app-shortcut';addBtn.innerHTML='<div class="add-app-shortcut">+</div><span class="app-shortcut-name">Add App</span>';addBtn.addEventListener('click',function(){document.getElementById('add-app-modal').classList.add('show');});c.appendChild(addBtn);}
        function addAppShortcut(){var n=document.getElementById('app-name-input').value.trim();var u=document.getElementById('app-url-input').value.trim();if(!n||!u){alert('Fill both fields!');return;}if(!u.startsWith('http'))u='https://'+u;var apps=getApps();apps.push({name:n,url:u});saveApps(apps);renderAppShortcuts();closeAddAppModal();}
        function closeAddAppModal(){document.getElementById('add-app-modal').classList.remove('show');document.getElementById('app-name-input').value='';document.getElementById('app-url-input').value='';}
        function toggleFullscreen(){if(document.fullscreenElement)document.exitFullscreen();else document.documentElement.requestFullscreen().catch(function(){});}
        function openHistory(){historyPanel.classList.add('open');historyOverlay.classList.add('visible');renderHistory();}
        function closeHistory(){historyPanel.classList.remove('open');historyOverlay.classList.remove('visible');}
        function renderHistory(){var h=getHistory();if(!h.length){historyList.innerHTML='<div style="text-align:center;padding:50px;color:var(--text2);">No history yet</div>';return;}historyList.innerHTML=h.map(function(h,i){return'<div class="history-item" onclick="handleSearch(\''+escapeAttr(h.url)+'\')"><div class="history-item-info"><div class="history-item-title">'+escapeHtml(h.title||h.url)+'</div><div class="history-item-url">'+escapeHtml(h.url)+'</div></div><button class="history-item-delete" onclick="event.stopPropagation();deleteHistoryItem('+i+')">✕</button></div>';}).join('');}
        function deleteHistoryItem(i){var h=getHistory();h.splice(i,1);saveHistory(h);renderHistory();}
        function clearHistory(){if(confirm('Clear all history?')){saveHistory([]);renderHistory();}}
        function loadSettingsValues(){if(!localStorage.getItem('proxy'))localStorage.setItem('proxy','ultraviolet');if(!localStorage.getItem('search'))localStorage.setItem('search','https://www.google.com/search?q=');if(!localStorage.getItem('transport'))localStorage.setItem('transport','libcurl');}
        function escapeHtml(t){var d=document.createElement('div');d.textContent=t;return d.innerHTML;}
        function escapeAttr(t){return t.replace(/'/g,"\\'").replace(/"/g,'&quot;');}

        window.persistentMusic=null;
        function initMusic(){var s=localStorage.getItem('persistentMusicSrc');var p=localStorage.getItem('persistentMusicPlaying');var b=document.getElementById('music-btn');if(p==='true'&&s){var d=localStorage.getItem('activeAudioData');var a=s;if(d&&s.indexOf('data:')===0)a=d;window.persistentMusic=new Audio(a);window.persistentMusic.loop=true;window.persistentMusic.volume=parseFloat(localStorage.getItem('audioVolume')||'0.7');window.persistentMusic.play().then(function(){if(b)b.textContent='🎵';}).catch(function(){});}}
        function togglePersistentMusic(){var s=localStorage.getItem('persistentMusicSrc');var b=document.getElementById('music-btn');if(!window.persistentMusic){if(!s){alert('No soundtrack set. Go to Settings!');return;}var d=localStorage.getItem('activeAudioData');var a=s;if(d&&s.indexOf('data:')===0)a=d;window.persistentMusic=new Audio(a);window.persistentMusic.loop=true;window.persistentMusic.volume=parseFloat(localStorage.getItem('audioVolume')||'0.7');window.persistentMusic.play().then(function(){localStorage.setItem('persistentMusicPlaying','true');if(b)b.textContent='🎵';}).catch(function(){});}else{if(window.persistentMusic.paused){window.persistentMusic.play().then(function(){localStorage.setItem('persistentMusicPlaying','true');if(b)b.textContent='🎵';});}else{window.persistentMusic.pause();localStorage.setItem('persistentMusicPlaying','false');if(b)b.textContent='🔇';}}}

        async function initProxy(){try{var c=new BareMux.BareMuxConnection('/baremux/worker.js');var w=localStorage.getItem('wisp')||((location.protocol==='https:'?'wss':'ws')+'://'+location.host+'/wisp/');var t=localStorage.getItem('transport')||'libcurl';var tp=t==='epoxy'?'/epoxy/index.mjs':'/libcurl/index.mjs';if(await c.getTransport()!==tp)await c.setTransport(tp,[{wisp:w}]);}catch(e){}}
        initProxy();

        newTabBtn.addEventListener('click',function(){addNewTab();});
        document.addEventListener('keydown',function(e){if(e.ctrlKey&&e.key==='t'){e.preventDefault();addNewTab();}if(e.ctrlKey&&e.key==='w'){e.preventDefault();var t=tabs.find(function(t){return t.id===activeTabId;});if(t&&tabs.length>1)closeTab(activeTabId);}if(e.ctrlKey&&e.key==='h'){e.preventDefault();openHistory();}if(e.key==='Escape'){closeHistory();closeAddAppModal();}});

        if(localStorage.getItem('silox_intro_seen')){introOverlay.classList.add('hidden');initBrowser();setTimeout(initMusic,300);}
    </script>
</body>
</html>